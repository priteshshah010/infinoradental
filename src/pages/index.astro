---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Infinora Dental Care | Dr. Riddhi Patel Shah (MDS Orthodontist) | Dental Tourism Mumbai" 
    description="Premier multispeciality dental clinic in Kandivali West, Mumbai. Specialist MDS Doctors for Clear Aligners, Dental Implants, Single-Visit RCT & Full Mouth Rehabilitation. Global Dental Tourism & NRI Concierge."
>
    <!-- Top Announcement Bar: Pre-Launch & Dental Tourism -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2.5 px-4 sm:px-6 border-b border-slate-800 w-full">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2.5 text-center md:text-left">
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                <span class="inline-flex items-center gap-1.5 bg-teal-900 text-teal-300 border border-teal-700/60 px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px]">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Grand Opening · September 2026
                </span>
