---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Infinora Dental Care | Advanced Painless Dentistry in Kandivali West, Mumbai" 
    description="Experience precision dental care, single-visit root canals, aligners, and implants with Dr. Riddhi Patel in Kandivali West, Mumbai."
>
    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-slate-100 transition-all">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="text-xl font-extrabold tracking-tight text-teal-700 flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-teal-500 animate-pulse"></span>
                Infinora Dental Care
            </a>
            <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
                <a href="#services" class="hover:text-teal-600 transition-colors">Services</a>
                <a href="#about" class="hover:text-teal-600 transition-colors">Dr. Riddhi Patel</a>
                <a href="#location" class="hover:text-teal-600 transition-colors">Location</a>
            </nav>
            <a href="mailto:hello@infinoradental.com" class="bg-teal-600 hover:bg-teal-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm shadow-sm transition-all hover:shadow-teal-500/20 hover:shadow-lg">
                Book Visit
            </a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-44 md:pb-32 overflow-hidden bg-gradient-to-b from-teal-50/50 via-white to-white">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="space-y-6">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-100/80 text-teal-800 text-xs font-bold tracking-wide uppercase">
                    Advanced Micro-Dentistry in Mumbai
                </div>
                <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1]">
                    Painless Care. <br/><span class="text-teal-600">Exceptional Smiles.</span>
                </h1>
                <p class="text-lg text-slate-600 leading-relaxed max-w-xl">
                    Welcome to Infinora Dental Care. We merge advanced dental technology with a comforting touch to deliver pristine clinical results right here in Kandivali West.
                </p>
                <div class="flex flex-col sm:flex-row gap-4 pt-2">
                    <a href="mailto:hello@infinoradental.com" class="bg-teal-600 hover:bg-teal-700 text-white font-semibold px-8 py-4 rounded-xl text-center shadow-lg shadow-teal-600/20 transition-all">
                        Schedule Consultation
                    </a>
                    <a href="tel:+919820000000" class="bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 font-semibold px-8 py-4 rounded-xl text-center transition-all">
                        Call Clinic Now
                    </a>
                </div>
            </div>
            <div class="relative">
                <div class="w-full h-[400px] bg-gradient-to-br from-teal-500/10 to-teal-700/20 rounded-3xl border border-teal-100/50 flex flex-col items-center justify-center p-8 text-center shadow-2xl shadow-teal-900/5">
                    <div class="w-16 h-16 rounded-2xl bg-teal-600 text-white flex items-center justify-center text-2xl font-bold mb-4 shadow-lg shadow-teal-600/30">
                        IDC
                    </div>
                    <h3 class="text-xl font-bold text-slate-800">Infinora Dental Care</h3>
                    <p class="text-sm text-slate-500 mt-1">Kandivali West, Mumbai</p>
                    <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-slate-200 text-xs font-bold text-teal-700 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Open Today · 10:00 AM – 9:00 PM
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section id="services" class="py-24 bg-slate-50/50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-16 space-y-4">
                <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight text-slate-900">Precision Treatments</h2>
                <p class="text-slate-600">Engineered for absolute comfort, rapid recovery, and long-term oral health.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
                    <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold text-lg mb-6">01</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Painless Root Canals</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Single-visit micro-endodontics designed to eliminate infection completely without the traditional discomfort.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
                    <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold text-lg mb-6">02</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Dental Implants</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">State-of-the-art permanent replacements that look, feel, and function precisely like natural teeth.</p>
                </div>
                <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition-all">
                    <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center font-bold text-lg mb-6">03</div>
                    <h3 class="text-xl font-bold text-slate-900 mb-3">Clear Aligners & Braces</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">Discreet, custom-molded orthodontic alignments to seamlessly straighten teeth at any age.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- About Doctor Section -->
    <section id="about" class="py-24 bg-white">
        <div class="max-w-5xl mx-auto px-6 bg-slate-900 text-white rounded-3xl p-10 md:p-16 relative overflow-hidden shadow-2xl">
            <div class="relative z-10 space-y-6 max-w-2xl">
                <span class="text-teal-400 text-xs font-extrabold uppercase tracking-widest">Clinical Leadership</span>
                <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Led by Dr. Riddhi Patel</h2>
                <p class="text-slate-300 leading-relaxed text-base">
                    At Infinora Dental Care, we believe that dental visits should never be a source of anxiety. Dr. Riddhi Patel brings an empathetic, highly calculated clinical approach to every procedure—ensuring total transparency, absolute safety, and beautiful aesthetics.
                </p>
                <div class="pt-4">
                    <a href="mailto:dr.riddhi@infinoradental.com" class="inline-flex items-center gap-2 bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold px-6 py-3 rounded-xl transition-all">
                        Direct Consultation 
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Location & Contact Grid -->
    <section id="location" class="py-24 bg-slate-50/50 border-t border-slate-100">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-6">
                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">Visit Our Practice</h2>
                <div class="space-y-4 text-slate-600">
                    <p class="font-medium text-slate-800">Shop No. 5, Sai Elegance<br>Iraniwadi Road No. 3, Kandivali West<br>Mumbai 400067, Maharashtra, India</p>
                    <div class="pt-2 space-y-2 text-sm">
                        <p><strong>General Inquiries:</strong> <a href="mailto:hello@infinoradental.com" class="text-teal-600 hover:underline">hello@infinoradental.com</a></p>
                        <p><strong>Direct Desk:</strong> <a href="mailto:dr.riddhi@infinoradental.com" class="text-teal-600 hover:underline">dr.riddhi@infinoradental.com</a></p>
                    </div>
                </div>
            </div>
            <div class="bg-white p-8 rounded-2xl border border-slate-100 shadow-sm space-y-6">
                <h3 class="text-xl font-bold text-slate-900">Clinic Hours</h3>
                <div class="space-y-3 text-sm text-slate-600 divide-y divide-slate-100">
                    <div class="flex justify-between pt-2">
                        <span>Monday – Saturday (Morning)</span>
                        <span class="font-semibold text-slate-800">10:00 AM – 1:30 PM</span>
                    </div>
                    <div class="flex justify-between pt-3">
                        <span>Monday – Saturday (Evening)</span>
                        <span class="font-semibold text-slate-800">5:00 PM – 9:00 PM</span>
                    </div>
                    <div class="flex justify-between pt-3">
                        <span>Sunday</span>
                        <span class="font-semibold text-teal-600">By Appointment Only</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12 text-center text-sm border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>&copy; 2026 Infinora Dental Care. All rights reserved.</p>
            <p class="text-xs text-slate-500">Secured via Cloudflare Edge Network</p>
        </div>
    </footer>
</Layout>