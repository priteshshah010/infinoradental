                            <div class="text-[9px] sm:text-xs text-slate-600 font-medium truncate">Gold Medalist & MDS</div>
                        </div>
                        <div class="p-2 sm:p-3 bg-white rounded-xl border border-slate-100 shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-slate-900 truncate">IOS & IDA</div>
                            <div class="text-[9px] sm:text-xs text-slate-600 font-medium truncate">Active Member</div>
                        </div>
                        <div class="p-2 sm:p-3 bg-white rounded-xl border border-slate-100 shadow-sm text-center sm:text-left min-w-0">
