    description="Specialist-led dentistry thoughtfully delivered in Kandivali West, Mumbai. Expert care across orthodontics, restorative, and family dentistry, backed by state dental councils and national digital health registries."
>
    <!-- Top Announcement Bar -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2 px-3 sm:px-6 border-b border-slate-800 w-full">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">
            
            <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 bg-teal-900 text-teal-300 border border-teal-700/60 px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Grand Opening · September 2026
