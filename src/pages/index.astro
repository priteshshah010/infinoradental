---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Infinora Dental Care | Dr. Riddhi Patel Shah (MDS) | Family & Specialist Dentistry in Kandivali West, Mumbai"
    description="Comprehensive family dentistry, braces, clear aligners, dental implants, full-mouth rehabilitation, and painless root canals in Kandivali West, Mumbai with Dr. Riddhi Patel Shah (MDS Orthodontics, Gold Medalist)."
    canonicalUrl="https://infinoradental.com/"
>
    <!-- Top Announcement Bar -->
    <div class="bg-brand-darknavy text-brand-surface text-xs py-2 px-3 sm:px-6 border-b border-brand-midnavy w-full">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">

            <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 bg-brand-navy text-white border border-brand-lightnavy px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span>
                    Clinic: 10:00 AM–2:00 PM &amp; 5:00 PM–9:00 PM · Appts: 3:00 PM–5:00 PM Only
                </span>
                <span class="text-brand-border font-medium text-xs truncate">
                    Kandivali West, Mumbai · Family &amp; Specialist Dental Care
                </span>
            </div>

            <div class="flex items-center justify-center gap-2 sm:gap-3 text-xs font-semibold flex-wrap">
                <!-- Multi-Language Switcher -->
                <div class="flex items-center gap-1 bg-brand-midnavy border border-brand-lightnavy px-1.5 py-0.5 rounded-lg notranslate">
                    <button type="button" onclick="changeLanguage('en')" data-lang="en" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold bg-brand-navy text-white transition-colors">
                        EN
                    </button>
                    <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors">
                        ગુજ
                    </button>
                    <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors">
                        हि
                    </button>
                    <button type="button" onclick="changeLanguage('mr')" data-lang="mr" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors">
                        मरा
                    </button>
                </div>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <button type="button" onclick="downloadVCard()" class="text-brand-surface hover:text-white flex items-center gap-1 transition-colors cursor-pointer" title="Save Infinora Dental Care to Contacts">
                    <span>📇 Save Contact</span>
                </button>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <a href="https://g.page/r/Cb7r3l0-R2oSEBM/review" target="_blank" rel="noopener" class="text-brand-surface hover:text-white transition-colors flex items-center gap-1">
                    ⭐ Review Us
                </a>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <a href="tel:+917304432681" class="hover:text-white transition-colors flex items-center gap-1 text-brand-surface">
                    <svg class="w-3.5 h-3.5 text-brand-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    +91 73044 32681
                </a>
            </div>

        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-brand-offwhite/95 backdrop-blur-md border-b border-brand-border shadow-sm w-full">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 h-18 sm:h-20 flex items-center justify-between gap-2 sm:gap-4">

            <!-- Logo Reference (/logo.svg — upload file to public/logo.svg) -->
            <a href="https://infinoradental.com/" class="flex items-center gap-2.5 sm:gap-3 min-w-0 group" aria-label="Infinora Dental Care Home">
                <span class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-brand-offwhite border border-brand-border flex items-center justify-center shadow-sm shrink-0 overflow-hidden p-1">
                    <img
                        src="/logo.svg"
                        alt="Infinora Dental Care Logo"
                        width="36"
                        height="36"
                        class="w-full h-full object-contain"
                    />
                </span>
                <div class="min-w-0">
                    <span class="text-sm sm:text-xl font-extrabold tracking-tight text-brand-navy block leading-tight truncate">Infinora Dental Care</span>
                    <span class="text-[9px] sm:text-xs font-semibold tracking-wider text-brand-grey-muted block truncate">Kandivali West, Mumbai</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-5 text-sm font-semibold text-brand-grey-text">
                <a href="#family-care" class="hover:text-brand-navy transition-colors">Family Care</a>
                <a href="#catalogue" class="hover:text-brand-navy transition-colors">Treatments</a>
                <a href="#about" class="hover:text-brand-navy transition-colors">Meet Dr. Riddhi</a>
                <a href="#standards" class="hover:text-brand-navy transition-colors">The Standard</a>
                <a href="#credentials" class="hover:text-brand-navy transition-colors">Registrations</a>
                <a href="#faq" class="hover:text-brand-navy transition-colors">FAQs</a>
                <a href="#location" class="hover:text-brand-navy transition-colors">Location</a>
            </nav>

            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                <a href="https://maps.app.goo.gl/3sKwKPjG43PNeN6y7" target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-1 bg-brand-surface hover:bg-brand-cardbg text-brand-navy px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all border border-brand-border">
                    📍 Directions
                </a>
                <a href="https://infinoradental.com/#book" class="inline-flex items-center gap-1 bg-brand-navy hover:bg-brand-hovernavy text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md transition-all">
                    <span>Consultation</span>
                </a>
                <a href="tel:+917304432681" class="hidden sm:inline-flex bg-brand-darknavy hover:bg-brand-midnavy text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all">
                    +91 73044 32681
                </a>
            </div>
        </div>
    </header>

    <main class="w-full overflow-hidden pb-24 sm:pb-0">

        <!-- HERO SECTION -->
        <section class="relative pt-8 pb-12 sm:pt-16 sm:pb-20 overflow-hidden bg-gradient-to-b from-brand-surface via-brand-lightbg to-brand-offwhite w-full border-b border-brand-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

                <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-left min-w-0">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-cardbg border border-brand-border text-brand-navy text-[11px] sm:text-xs font-bold tracking-wide uppercase max-w-full">
                        <span class="w-2 h-2 rounded-full bg-brand-navy shrink-0"></span>
                        <span class="truncate">Kandivali West, Mumbai · Family &amp; Specialist Dentistry</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-brand-navy leading-[1.12] break-words">
                        Specialist-led dentistry. <br/>
                        <span class="text-brand-lightnavy">Thoughtfully delivered.</span>
                    </h1>

                    <p class="text-sm sm:text-base text-brand-grey-text leading-relaxed max-w-2xl break-words">
                        Infinora Dental Care is a welcoming family and specialist dental practice in Kandivali West, Mumbai, founded and led by <strong>Dr. Riddhi Patel Shah</strong> (BDS University Gold Medalist, MDS Orthodontics &amp; Dentofacial Orthopedics University Rank-Holder), active member of the <strong>Indian Orthodontic Society (IOS)</strong> and the <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">Indian Dental Association (IDA Profile)</a>. Clinic timings are <strong>10:00 AM to 2:00 PM</strong> and <strong>Evening: 5:00 PM to 9:00 PM</strong>, with appointments taken strictly for <strong>3:00 PM to 5:00 PM</strong> (none other slots work for appointments).
                    </p>

                    <!-- Action CTAs -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <a href="https://infinoradental.com/#book" class="inline-flex items-center justify-center gap-2 bg-brand-navy hover:bg-brand-hovernavy text-white font-bold px-7 py-3.5 rounded-xl shadow-lg transition-all text-sm sm:text-base text-center">
                            Reserve Consultation (3:00 PM – 5:00 PM)
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <a href="https://maps.app.goo.gl/3sKwKPjG43PNeN6y7" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-brand-offwhite hover:bg-brand-surface border border-brand-border text-brand-navy font-bold px-6 py-3.5 rounded-xl shadow-sm transition-all text-sm sm:text-base text-center">
                            📍 View Clinic Location
                        </a>
                    </div>

                    <!-- Trust Badges -->
                    <div class="pt-4 grid grid-cols-3 gap-2 sm:gap-4 border-t border-brand-border">
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy truncate">Dr. Riddhi</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold truncate">Gold Medalist &amp; MDS</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy truncate">IOS &amp; IDA</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold truncate">Verified Specialist</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy truncate">Class-B</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold truncate">Hospital Sterilization</div>
                        </div>
                    </div>
                </div>

                <!-- Doctor Profile Card -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-brand-offwhite rounded-3xl p-6 sm:p-8 border border-brand-border shadow-xl space-y-4">
                        <div class="flex items-center gap-3.5 border-b border-brand-border pb-4">
                            <div class="w-14 h-14 rounded-2xl bg-brand-surface border border-brand-border flex items-center justify-center shrink-0 overflow-hidden p-1.5">
                                <img
                                    src="/logo.svg"
                                    alt="Infinora Dental Care Emblem"
                                    width="44"
                                    height="44"
                                    class="w-full h-full object-contain"
                                />
                            </div>
                            <div class="min-w-0">
                                <h2 class="font-extrabold text-brand-navy text-base sm:text-lg leading-tight truncate">Dr. Riddhi Patel Shah</h2>
                                <p class="text-[11px] sm:text-xs text-brand-lightnavy font-bold tracking-wide break-words">BDS Gold Medalist | MDS Orthodontics</p>
                                <p class="text-[11px] text-brand-grey-muted font-medium">Founder &amp; Lead Dental Surgeon</p>
                            </div>
                        </div>

                        <div class="space-y-3 text-xs sm:text-sm text-brand-grey-text leading-relaxed break-words">
                            <p>
                                <strong>Dr. Riddhi Patel Shah</strong> is an accomplished Orthodontist and Lead Dental Surgeon practicing in Kandivali West, Mumbai. Combining post-graduate clinical excellence with an empathetic, patient-first philosophy, she delivers specialist-led treatments designed for lifelong dental function and facial balance.
                            </p>
                            <p>
                                With extensive training in diagnosing complex jaw discrepancies, crowded dentition, and malocclusions, Dr. Riddhi pairs digital imaging with delicate orthodontic biomechanics to safeguard periodontal health.
                            </p>
                        </div>

                        <!-- Academic Honors List -->
                        <div class="bg-brand-surface rounded-2xl p-4 border border-brand-border space-y-2 text-xs">
                            <div class="font-bold text-brand-navy text-[11px] uppercase tracking-wider">
                                Academic Honors &amp; Credentials
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-brand-grey-text font-medium">
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> Student of the Year (BDS)</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> BDS University Medalist</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> MDS University Rank-Holder</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> Best Prosthodontist (IDA CCRP)</div>
                            </div>
                        </div>

                        <div class="pt-2 flex flex-wrap gap-2 text-[11px]">
                            <span class="px-2.5 py-1 rounded-full bg-brand-cardbg text-brand-navy font-semibold">MSDC Reg: A-45674</span>
                            <span class="px-2.5 py-1 rounded-full bg-brand-cardbg text-brand-navy font-semibold">7+ Years Experience</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- FAMILY DENTISTRY ACROSS EVERY STAGE OF LIFE -->
        <section id="family-care" class="py-14 bg-brand-offwhite border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">
                <div class="text-center max-w-3xl mx-auto space-y-2.5">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Comprehensive Family Dentistry
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">Care for Every Member of Your Family</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        One trusted Kandivali West clinic for routine checkups, preventive care, alignment, restorative dentistry, and NRI/teleconsultation guidance.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Children &amp; Teens</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Gentle first checkups, preventive sealants/fluoride, age-7 orthodontic screening, and braces or aligners for growing smiles.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Adults &amp; Working Professionals</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Discreet aligners/braces, root canals, crowns, tooth-colored fillings, gum care, and clinic hours at 10:00 AM–2:00 PM and 5:00 PM–9:00 PM.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Seniors &amp; Complex Needs</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Tooth replacement with implants or dentures/bridges, periodontal care, ground-level access, and individualized full-mouth planning.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-surface border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">NRI &amp; Video Consultations</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Initial teleconsultation / video opinion options and coordinated scheduling for visiting NRIs and out-of-town families.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- STATUTORY REGISTRATIONS & ACCREDITATIONS (ABDM & MSDC) -->
        <section id="credentials" class="py-12 bg-brand-surface border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">
                <div class="text-center space-y-2 max-w-2xl mx-auto">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Statutory Registrations &amp; Transparencies
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">Verified Regulatory Governance</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        Infinora Dental Care complies fully with the statutory directives of state dental councils and the National Health Authority's Ayushman Bharat Digital Mission.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">

                    <!-- Card 1: MSDC & IDA -->
                    <div class="p-6 rounded-2xl bg-brand-offwhite border border-brand-border hover:border-brand-navy transition-all space-y-3 flex flex-col justify-between shadow-sm">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
                                <span class="text-brand-navy text-2xl font-bold">🏛️</span>
                                <h3 class="font-extrabold text-brand-navy text-sm">State Council &amp; Associations</h3>
                            </div>
                            <p class="text-xs text-brand-grey-text leading-relaxed">
                                Officially registered under the <strong>Maharashtra State Dental Council</strong> (Registration No: <strong class="text-brand-navy">A-45674</strong>). Verified member of the <strong>Indian Orthodontic Society (IOS)</strong> and the <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">Indian Dental Association (IDA)</a>.
                            </p>
                        </div>
                        <div class="pt-3 border-t border-brand-border flex flex-wrap gap-3">
                            <a href="https://msdcmumbai.in/QR_Verfy.aspx?auth=57d7f7fc-a30e-4fb8-95c1-1f4f163010bc" target="_blank" rel="noopener" class="text-brand-navy hover:text-brand-hovernavy font-extrabold text-xs inline-flex items-center gap-1">
                                Verify MSDC License →
                            </a>
                            <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy hover:text-brand-hovernavy font-extrabold text-xs inline-flex items-center gap-1">
                                View IDA Directory Entry →
                            </a>
                        </div>
                    </div>

                    <!-- Card 2: ABDM Health Facility (HFR) -->
                    <div class="p-6 rounded-2xl bg-brand-offwhite border border-brand-border hover:border-brand-navy transition-all space-y-3 flex flex-col justify-between shadow-sm">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
                                <span class="text-brand-navy text-2xl font-bold">🏥</span>
                                <h3 class="font-extrabold text-brand-navy text-sm">Ayushman Bharat Facility Registry</h3>
                            </div>
                            <p class="text-xs text-brand-grey-text leading-relaxed">
                                Verified under the Health Facility Registry (HFR) managed by the <strong>National Health Authority (NHA)</strong>, Government of India.
                            </p>
                            <p class="text-xs text-brand-navy font-semibold">Facility ID: <span class="font-mono text-brand-lightnavy break-all">IN2710085962</span></p>
                        </div>
                        <div class="pt-3 border-t border-brand-border text-[11px] text-brand-grey-muted font-medium flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span> Validated Digital Health Facility
                        </div>
                    </div>

                    <!-- Card 3: ABDM Healthcare Professional (HPR) -->
                    <div class="p-6 rounded-2xl bg-brand-offwhite border border-brand-border hover:border-brand-navy transition-all space-y-3 flex flex-col justify-between shadow-sm">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
                                <span class="text-brand-navy text-2xl font-bold">👩‍⚕️</span>
                                <h3 class="font-extrabold text-brand-navy text-sm">Ayushman Bharat Professional (HPR)</h3>
                            </div>
                            <p class="text-xs text-brand-grey-text leading-relaxed">
                                Registered on the Healthcare Professional Registry (HPR) under the <strong>National Health Authority &amp; Dental Council of India</strong>.
                            </p>
                            <p class="text-xs text-brand-navy font-semibold">Professional ID: <span class="font-mono text-brand-lightnavy break-all">71-8554-8443-4346</span></p>
                        </div>
                        <div class="pt-3 border-t border-brand-border text-[11px] text-brand-grey-muted font-medium flex items-center gap-1">
                            <span class="w-1.5 h-1.5 rounded-full bg-brand-gold"></span> Dr. Riddhi Patel · Verified Practitioner
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- THE INFINORA STANDARD: OPERATIONAL PILLARS -->
        <section id="standards" class="py-16 bg-brand-offwhite w-full border-b border-brand-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
                    <span class="text-brand-navy text-xs font-extrabold tracking-widest uppercase bg-brand-cardbg border border-brand-border px-3.5 py-1 rounded-full">
                        Our Operational Core
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-brand-navy">
                        The Infinora Standard
                    </h2>
                    <p class="text-brand-grey-muted text-sm sm:text-base">
                        Six non-negotiable principles of specialist dental healthcare in Kandivali West.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

                    <div class="bg-brand-surface p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">01</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Specialist-Led Treatment</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Treatments are diagnosed, planned, and executed directly by master-degree holding specialists (MDS) rather than generalized practitioners.
                        </p>
                    </div>

                    <div class="bg-brand-surface p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">02</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Root-Cause Diagnosis</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            We analyze systemic bite relationships, bone architecture, and soft tissue health rather than offering superficial short-term patches.
                        </p>
                    </div>

