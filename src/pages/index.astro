        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-3">
            <a href="#" class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-teal-700 to-teal-900 text-white flex items-center justify-center font-black text-base sm:text-xl shadow-md shadow-teal-700/20 shrink-0">
                    IDC
                </div>
                <div class="min-w-0">
                    <span class="text-base sm:text-xl font-extrabold tracking-tight text-slate-900 block leading-tight truncate">Infinora</span>
                    <span class="text-[9px] sm:text-[11px] font-bold tracking-wider text-teal-700 uppercase block truncate">Dental & Braces Clinic</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-slate-700">
