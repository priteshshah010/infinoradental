---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Dentist in Kandivali West | Infinora Dental Care"
    description="Dentist & orthodontist in Kandivali West, Mumbai. Braces, clear aligners, Invisalign, implants, veneers & root canals with Dr. Riddhi Patel Shah. Book today."
    canonicalUrl="https://infinoradental.com/"
>
    <!-- UTILITY BAR (Normal Flow — Scrolls Away) -->
    <div class="bg-brand-darknavy text-brand-surface text-[11px] sm:text-xs py-2 px-3 sm:px-6 border-b border-brand-midnavy w-full">
        <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2 min-w-0">
                <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0"></span>
                <span class="font-semibold text-brand-surface whitespace-nowrap">Kandivali West, Mumbai</span>
            </div>

            <div class="flex items-center flex-wrap gap-2 sm:gap-3 font-semibold">
                <div class="flex items-center gap-1 bg-brand-midnavy border border-brand-lightnavy px-1.5 py-0.5 rounded-lg notranslate">
                    <button type="button" onclick="changeLanguage('en')" data-lang="en" class="lang-btn px-2 py-1 rounded text-[10px] font-bold bg-brand-navy text-white cursor-pointer">EN</button>
                    <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn px-2 py-1 rounded text-[10px] font-bold text-brand-border hover:text-white cursor-pointer">ગુજ</button>
                    <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn px-2 py-1 rounded text-[10px] font-bold text-brand-border hover:text-white cursor-pointer">हि</button>
                    <button type="button" onclick="changeLanguage('mr')" data-lang="mr" class="lang-btn px-2 py-1 rounded text-[10px] font-bold text-brand-border hover:text-white cursor-pointer">मरा</button>
                </div>

                <button type="button" id="topPayOnlineBtn" class="bg-brand-midnavy hover:bg-brand-lightnavy text-white border border-brand-gold/50 px-2.5 py-1.5 rounded-lg text-[11px] font-bold cursor-pointer">
                    Pay Online
                </button>

                <button type="button" onclick="downloadVCard()" class="text-brand-surface hover:text-white py-1 cursor-pointer">
                    Save Contact
                </button>

                <a href="https://g.page/r/Cb7r3l0-R2oSEBM/review" target="_blank" rel="noopener" class="text-brand-surface hover:text-white py-1">
                    Google Review Link
                </a>

                <a href="tel:+917304432681" class="text-brand-surface hover:text-white py-1 whitespace-nowrap">
                    +91 73044 32681
                </a>
            </div>
        </div>

        <div id="topPaymentNotice" class="hidden max-w-7xl mx-auto mt-2 px-3 py-2 rounded-xl bg-brand-midnavy border border-brand-gold/40 text-brand-surface text-[11px] flex items-center justify-between gap-3">
            <span>
                <strong>Post-Treatment Payment (Placeholder):</strong> For post-treatment online payment balances (Razorpay, Cashfree, Pine Labs, or PayU integration planned; not for appointment booking). Please contact +91 73044 32681.
            </span>
            <button type="button" id="closeTopPaymentNotice" class="text-brand-gold font-bold px-2 py-1 cursor-pointer">x</button>
        </div>
    </div>

    <!-- STICKY MAIN NAVIGATION -->
    <header id="stickyClinicHeader" class="sticky top-0 z-[1000] bg-brand-offwhite border-b border-brand-border shadow-sm w-full">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 h-[68px] lg:h-[80px] flex items-center justify-between gap-3">

            <a href="#" class="scroll-top-link flex items-center gap-[10px] sm:gap-[12px] shrink-0 group" aria-label="INFINORA DENTAL CARE Home">
                <img
                    src="/logo.svg"
                    alt="INFINORA DENTAL CARE Icon"
                    width="52"
                    height="52"
                    class="w-[42px] h-[42px] lg:w-[52px] lg:h-[52px] object-contain shrink-0"
                />
                <span class="flex flex-col leading-none shrink-0">
                    <span class="font-brand text-[20px] lg:text-[25px] font-bold tracking-[0.06em] text-brand-navy whitespace-nowrap">INFINORA</span>
                    <span class="text-[9px] lg:text-[10px] font-bold tracking-[0.22em] text-brand-grey-muted uppercase mt-1 whitespace-nowrap">DENTAL CARE</span>
                </span>
            </a>

            <nav class="hidden lg:flex items-center gap-4 xl:gap-5 text-[13px] xl:text-[14px] font-semibold text-brand-grey-text min-w-0" aria-label="Main Navigation">
                <a href="#" class="scroll-top-link hover:text-brand-navy transition-colors whitespace-nowrap">Home</a>
                <a href="#offers" class="hover:text-brand-navy transition-colors whitespace-nowrap">Offers</a>
                <a href="#standards" class="hover:text-brand-navy transition-colors whitespace-nowrap">The Standard</a>
                <a href="#catalogue" class="hover:text-brand-navy transition-colors whitespace-nowrap">Treatments</a>
                <a href="#about" class="hover:text-brand-navy transition-colors whitespace-nowrap">Dr. Riddhi</a>
                <a href="#clinic-gallery" class="hover:text-brand-navy transition-colors whitespace-nowrap">Clinic</a>
                <a href="#reviews" class="hover:text-brand-navy transition-colors whitespace-nowrap">Reviews</a>
                <a href="#location" class="hover:text-brand-navy transition-colors whitespace-nowrap">How to Reach</a>
            </nav>

            <div class="flex items-center gap-2 shrink-0">
                <a href="#book" class="inline-flex items-center justify-center bg-brand-navy hover:bg-brand-hovernavy text-white px-3.5 lg:px-5 py-2.5 rounded-xl font-bold text-xs lg:text-sm transition-colors whitespace-nowrap">
                    Book Appointment
                </a>

                <button
                    type="button"
                    id="mobileMenuToggle"
                    aria-expanded="false"
                    aria-controls="mobileNavDrawer"
                    aria-label="Open navigation menu"
                    class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-xl border border-brand-border bg-brand-surface text-brand-navy font-bold text-base cursor-pointer shrink-0"
                >
                    ☰
                </button>
            </div>
        </div>

        <!-- ACCESSIBLE MOBILE NAVIGATION DRAWER -->
        <div id="mobileNavDrawer" class="hidden fixed inset-0 z-[1100] bg-brand-offwhite flex flex-col justify-between p-5 overflow-y-auto lg:hidden" role="dialog" aria-modal="true" aria-label="Mobile Navigation">
            <div class="space-y-6">
                <div class="flex items-center justify-between border-b border-brand-border pb-4">
                    <a href="#" class="scroll-top-link mobile-nav-link flex items-center gap-2.5 shrink-0">
                        <img src="/logo.svg" alt="INFINORA DENTAL CARE Icon" width="42" height="42" class="w-[42px] h-[42px] object-contain shrink-0" />
                        <span class="flex flex-col leading-none">
                            <span class="font-brand text-[20px] font-bold tracking-[0.06em] text-brand-navy whitespace-nowrap">INFINORA</span>
                            <span class="text-[9px] font-bold tracking-[0.22em] text-brand-grey-muted uppercase mt-1 whitespace-nowrap">DENTAL CARE</span>
                        </span>
                    </a>
                    <button type="button" id="mobileMenuClose" aria-label="Close navigation menu" class="w-10 h-10 rounded-xl border border-brand-border text-brand-navy font-bold text-lg cursor-pointer">
                        ✕
                    </button>
                </div>

                <nav class="flex flex-col gap-2 text-base font-bold text-brand-navy" aria-label="Mobile Menu Links">
                    <a href="#" class="scroll-top-link mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Home</a>
                    <a href="#offers" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Offers</a>
                    <a href="#standards" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">The Standard</a>
                    <a href="#catalogue" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Treatments</a>
                    <a href="#about" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Dr. Riddhi</a>
                    <a href="#clinic-gallery" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Clinic Gallery</a>
                    <a href="#reviews" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Reviews</a>
                    <a href="#community" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">Community &amp; Schools</a>
                    <a href="#faq" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">FAQs</a>
                    <a href="#location" class="mobile-nav-link py-3 px-3 rounded-xl hover:bg-brand-surface">How to Reach</a>
                </nav>
            </div>

            <div class="pt-4 border-t border-brand-border space-y-3">
                <a href="#book" class="mobile-nav-link w-full inline-flex items-center justify-center bg-brand-navy text-white font-extrabold py-3.5 px-4 rounded-xl text-sm">
                    Book Appointment
                </a>
                <a href="tel:+917304432681" class="w-full inline-flex items-center justify-center bg-brand-surface text-brand-navy border border-brand-border font-bold py-3 px-4 rounded-xl text-sm">
                    +91 73044 32681
                </a>
            </div>
        </div>
    </header>

    <main class="w-full pb-28 sm:pb-20">

        <!-- HERO & DOCTOR PROFILE -->
        <section class="relative pt-8 pb-12 sm:pt-14 sm:pb-20 bg-gradient-to-b from-brand-surface via-brand-lightbg to-brand-offwhite w-full border-b border-brand-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

                <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-left min-w-0">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-cardbg border border-brand-border text-brand-navy text-[11px] sm:text-xs font-bold tracking-wide uppercase whitespace-normal break-words">
                        <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0"></span>
                        <span>Infinora Dental Care · Kandivali West, Mumbai</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-brand-navy leading-[1.12] whitespace-normal break-words">
                        Specialist-led dentistry. <br/>
                        <span class="text-brand-lightnavy">Thoughtfully delivered.</span>
                    </h1>

                    <p class="text-sm sm:text-base text-brand-grey-text leading-relaxed max-w-2xl whitespace-normal break-words">
                        <strong>Infinora Dental Care</strong> in Kandivali West, Mumbai is founded and led by <strong>Dr. Riddhi Patel Shah</strong> (BDS University Gold Medalist, MDS Orthodontics &amp; Dentofacial Orthopedics, MSDC Reg: A-45674), active member of the <strong>Indian Orthodontic Society (IOS)</strong> and the <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">Indian Dental Association (IDA Profile)</a>. Care spans braces, clear aligners, Invisalign, invisible aligners, dental implants, veneers, root canals, and family dentistry for patients in Kandivali, Mumbai, and across India.
                    </p>

                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <a href="#book" class="inline-flex items-center justify-center gap-2 bg-brand-navy hover:bg-brand-hovernavy text-white font-bold px-7 py-3.5 rounded-xl shadow-lg transition-all text-sm sm:text-base text-center">
                            Book Appointment
                        </a>
                        <a href="https://wa.me/917304432681?text=Hello%20Infinora%20Dental%20Care,%20I%20would%20like%20to%20enquire%20about%20a%20dental%20consultation." target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-brand-offwhite hover:bg-brand-surface border border-brand-border text-brand-navy font-bold px-6 py-3.5 rounded-xl shadow-sm transition-all text-sm sm:text-base text-center">
                            WhatsApp Us
                        </a>
                    </div>

                    <div class="pt-4 grid grid-cols-3 gap-2 sm:gap-4 border-t border-brand-border">
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">BDS Gold Medalist</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">MDS Orthodontics</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">MSDC A-45674</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">IOS &amp; IDA Member</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">ABDM Verified</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">HFR &amp; HPR IDs</div>
                        </div>
                    </div>
                </div>

                <!-- DOCTOR PROFILE CARD (AVIF Primary + WebP Fallback) -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-brand-offwhite rounded-3xl p-6 sm:p-8 border border-brand-border shadow-xl space-y-5">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4 border-b border-brand-border pb-5">
                            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-brand-surface border-2 border-brand-navy/25 flex items-center justify-center shrink-0 overflow-hidden shadow-sm">
                                <picture class="w-full h-full block">
                                    <source srcset="/images/riddhi_headshot.avif" type="image/avif" />
                                    <source srcset="/images/riddhi_headshot.webp" type="image/webp" />
                                    <img
                                        src="/images/riddhi_headshot.webp"
                                        alt="Dr. Riddhi Patel Shah headshot at Infinora Dental Care, Kandivali West"
                                        width="96"
                                        height="96"
                                        class="w-full h-full object-cover object-top"
                                    />
                                </picture>
                            </div>
                            <div class="min-w-0">
                                <div class="text-[10px] font-extrabold uppercase tracking-wider text-brand-lightnavy">Infinora Dental Care</div>
                                <h2 class="font-extrabold text-brand-navy text-lg sm:text-xl leading-snug whitespace-normal break-words">Dr. Riddhi Patel Shah</h2>
                                <p class="text-xs text-brand-lightnavy font-bold tracking-wide whitespace-normal break-words">BDS University Gold Medalist | MDS Orthodontics &amp; Dentofacial Orthopedics</p>
                                <p class="text-[11px] text-brand-grey-muted font-medium whitespace-normal break-words">Founder &amp; Lead Clinician · MSDC Reg: A-45674</p>
                            </div>
                        </div>

                        <div class="space-y-3 text-xs sm:text-sm text-brand-grey-text leading-relaxed whitespace-normal break-words">
                            <p>
                                <strong>Dr. Riddhi Patel Shah</strong> is an Orthodontist and Lead Dental Surgeon practicing at <strong>Infinora Dental Care</strong> in Kandivali West, Mumbai. Combining academic training with a patient-first approach, she delivers specialist-led orthodontic and family dental care tailored to individual clinical needs.
                            </p>
                            <p>
                                Her clinical focus includes orthodontic assessments, braces, clear aligners, Invisalign, invisible aligners, early orthodontic evaluations, smile improvement, and comprehensive dental care.
                            </p>
                        </div>

                        <div class="bg-brand-surface rounded-2xl p-4 border border-brand-border space-y-2 text-xs">
                            <div class="font-bold text-brand-navy text-[11px] uppercase tracking-wider">
                                Academic Honors &amp; Registrations
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-brand-grey-text font-medium">
                                <div>Student of the Year (BDS)</div>
                                <div>BDS University Medalist</div>
                                <div>MDS University Rank-Holder</div>
                                <div>Best Prosthodontist (IDA CCRP)</div>
                            </div>
                            <div class="pt-1 text-[11px] text-brand-grey-muted">
                                MSDC: A-45674 · ABDM HFR: IN2710085962 · HPR: 71-8554-8443-4346
                            </div>
                        </div>

                        <div class="pt-1 flex flex-wrap gap-3 text-xs">
                            <a href="https://msdcmumbai.in/QR_Verfy.aspx?auth=57d7f7fc-a30e-4fb8-95c1-1f4f163010bc" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">
                                Verify MSDC License
                            </a>
                            <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">
                                IDA Directory Profile
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- OFFERS FOR CURRENT MONTH -->
        <section id="offers" class="py-12 bg-brand-offwhite border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6">
                <div class="text-center max-w-2xl mx-auto space-y-2">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Offers for Current Month
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy whitespace-normal break-words">Current Month Clinic Offers</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        Available at <strong>Infinora Dental Care</strong>, Kandivali West, Mumbai—subject to slot availability and clinical suitability.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider bg-brand-navy text-white px-2.5 py-1 rounded-full">Offer 01</span>
                            <h3 class="text-xl font-extrabold text-brand-navy">Free Dental Checkup</h3>
                            <p class="text-xs sm:text-sm text-brand-grey-text leading-relaxed">
                                Initial dental checkup and consultation at Infinora Dental Care for individuals and families seeking an oral health or alignment review.
                            </p>
                        </div>
                        <button type="button" onclick="selectService('Checkup')" class="w-full text-center py-3 rounded-xl bg-brand-navy hover:bg-brand-hovernavy text-white text-xs sm:text-sm font-bold transition-colors cursor-pointer">
                            Claim Free Dental Checkup
                        </button>
                    </div>

                    <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider bg-brand-navy text-white px-2.5 py-1 rounded-full">Offer 02</span>
                            <h3 class="text-xl font-extrabold text-brand-navy">Teeth Cleaning @ Rs 999*</h3>
                            <p class="text-xs sm:text-sm text-brand-grey-text leading-relaxed">
                                Routine scaling and teeth cleaning offer at <strong>Rs 999*</strong>. *Terms, oral hygiene condition, and clinical assessment apply; additional treatments are evaluated separately.
                            </p>
                        </div>
                        <button type="button" onclick="selectService('Checkup')" class="w-full text-center py-3 rounded-xl bg-brand-navy hover:bg-brand-hovernavy text-white text-xs sm:text-sm font-bold transition-colors cursor-pointer">
                            Book Teeth Cleaning @ Rs 999*
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- THE INFINORA STANDARD -->
        <section id="standards" class="py-16 bg-brand-surface w-full border-b border-brand-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="text-center max-w-3xl mx-auto mb-12 space-y-3">
                    <span class="text-brand-navy text-xs font-extrabold tracking-widest uppercase bg-brand-cardbg border border-brand-border px-3.5 py-1 rounded-full">
                        Our Operational Core
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-brand-navy whitespace-normal break-words">
                        The Infinora Standard
                    </h2>
                    <p class="text-brand-grey-muted text-sm sm:text-base">
                        Six core principles of dental healthcare at Infinora Dental Care in Kandivali West, Mumbai.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">01</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Specialist-Led Treatment</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Orthodontic evaluations and care planning are led by Dr. Riddhi Patel Shah (MDS Orthodontics &amp; Dentofacial Orthopedics).
                        </p>
                    </div>

                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">02</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Root-Cause Diagnosis</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            We assess bite alignment, tooth structure, and gum health before recommending treatment rather than offering quick surface patches.
                        </p>
                    </div>

                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">03</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Transparent Written Roadmaps</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Patients receive clear treatment options, suitability considerations, and fee clarity before starting care, without fixed outcome guarantees.
                        </p>
                    </div>

                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">04</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Digital Diagnostics</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Diagnostic checkups, digital imaging/X-rays, and scans support careful clinical planning.
                        </p>
                    </div>

                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">05</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Sterilization &amp; Hygiene</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Consistent clinic hygiene and instrument sterilization practices support safe care at every visit.
                        </p>
                    </div>

                    <div class="bg-brand-offwhite p-6 rounded-2xl border border-brand-border shadow-sm space-y-2 hover:border-brand-navy transition-all">
                        <div class="text-2xl font-black text-brand-navy">06</div>
                        <h3 class="font-extrabold text-brand-navy text-base">Long-Term Continuity</h3>
                        <p class="text-brand-grey-text text-xs sm:text-sm leading-relaxed">
                            Follow-up visits, retainer guidance, and preventive checkups support ongoing dental health.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FIXING SMILE DESIGN -->
