    <!-- Comprehensive Interaction Script -->
    <script is:inline>
        const SLOT_MORNING = 'Morning (10:00 AM – 02:00 PM)';
        const SLOT_AFTERNOON = 'Afternoon (03:00 PM – 05:00 PM)';
        const SLOT_EVENING = 'Evening (05:00 PM – 09:00 PM)';

        window.selectService = function(keyword) {
            const select = document.getElementById('treatmentService');
            if (select) {
                const kw = String(keyword || '').toLowerCase();
                let matched = false;
                for (let opt of select.options) {
                    if (opt.value.toLowerCase().includes(kw) || opt.text.toLowerCase().includes(kw)) {
                        select.value = opt.value;
                        matched = true;
                        break;
                    }
                }
                if (!matched && kw === 'gum') {
                    for (let opt of select.options) {
                        if (opt.value.toLowerCase().includes('gum') || opt.value.toLowerCase().includes('periodont')) {
                            select.value = opt.value;
                            break;
                        }
                    }
                }
            }
            const bookSection = document.getElementById('book');
            if (bookSection) {
                bookSection.scrollIntoView({ behavior: 'smooth' });
            }
        };

        function formatLocalYMD(dateObj) {
            const y = dateObj.getFullYear();
            const m = String(dateObj.getMonth() + 1).padStart(2, '0');
            const d = String(dateObj.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function parseLocalYMD(ymdStr) {
            const parts = String(ymdStr || '').split('-');
            if (parts.length !== 3) return null;
            const dt = new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
            return isNaN(dt.getTime()) ? null : dt;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('appointmentDate');
            const dobInput = document.getElementById('patientDob');
            const timeSlot = document.getElementById('timeSlot');
            const middleBox = document.getElementById('middleSlotConfirmBox');
            const middleCheckbox = document.getElementById('middleSlotConfirmCheckbox');
            const middleError = document.getElementById('middleSlotConfirmError');
            const sundayPostNoonNotice = document.getElementById('sundayPostNoonNotice');
            const complaintsInput = document.getElementById('chiefComplaints');
            const historyInput = document.getElementById('medicalHistory');
            const allergiesInput = document.getElementById('medicalAllergies');
            const noAllergiesBtn = document.getElementById('noKnownAllergiesBtn');
            const topPayBtn = document.getElementById('topPayOnlineBtn');
            const topPayNotice = document.getElementById('topPaymentNotice');
            const closeTopPayNotice = document.getElementById('closeTopPaymentNotice');
            const scrolledBrandPill = document.getElementById('scrolledBrandPill');
            const statusBox = document.getElementById('whatsappStatusBox');
            const form = document.getElementById('appointmentForm');

            /* Keep Brand Pill Highlighted When Scrolled */
            window.addEventListener('scroll', () => {
                if (!scrolledBrandPill) return;
                if (window.scrollY > 120) {
                    scrolledBrandPill.classList.add('ring-1', 'ring-brand-navy/30');
                } else {
                    scrolledBrandPill.classList.remove('ring-1', 'ring-brand-navy/30');
                }
            }, { passive: true });

            /* Quick-Fill: No Known Allergies */
            if (noAllergiesBtn && allergiesInput) {
                noAllergiesBtn.addEventListener('click', () => {
                    allergiesInput.value = 'No known allergies';
                });
            }

            /* Google Reviews Carousel Controls */
            const slides = Array.from(document.querySelectorAll('.review-slide'));
            const dots = Array.from(document.querySelectorAll('.review-dot'));
            const prevBtn = document.getElementById('prevReviewBtn');
            const nextBtn = document.getElementById('nextReviewBtn');
            let activeSlideIndex = 0;

            function updateReviewCarousel(index) {
                if (!slides.length) return;
                activeSlideIndex = ((index % slides.length) + slides.length) % slides.length;
                slides.forEach((slide, idx) => {
                    if (idx === activeSlideIndex) {
                        slide.classList.add('ring-2', 'ring-brand-navy');
                    } else {
                        slide.classList.remove('ring-2', 'ring-brand-navy');
                    }
                });
                dots.forEach((dot, idx) => {
                    if (idx === activeSlideIndex) {
                        dot.classList.add('bg-brand-navy');
                        dot.classList.remove('bg-brand-border');
                    } else {
                        dot.classList.remove('bg-brand-navy');
                        dot.classList.add('bg-brand-border');
                    }
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', () => updateReviewCarousel(activeSlideIndex - 1));
            }
            if (nextBtn) {
                nextBtn.addEventListener('click', () => updateReviewCarousel(activeSlideIndex + 1));
            }
            dots.forEach((dot) => {
                dot.addEventListener('click', () => {
                    const idx = Number(dot.dataset.slideIndex || 0);
                    updateReviewCarousel(idx);
                });
            });
            updateReviewCarousel(0);

            /* Date, Slot & Validation Logic */
            const now = new Date();
            const todayStr = formatLocalYMD(now);
            const isPastNoonToday = now.getHours() >= 12;

            const maxDate = new Date(now);
            maxDate.setDate(maxDate.getDate() + 90);
            const maxDateStr = formatLocalYMD(maxDate);

            function getAvailableSlotsForDate(ymdStr) {
                const dt = parseLocalYMD(ymdStr);
                if (!dt) return [];

                const dayOfWeek = dt.getDay();
                const isSunday = dayOfWeek === 0;
                const isToday = ymdStr === todayStr;

                if (isSunday) {
                    if (isToday && isPastNoonToday) {
                        return [];
                    }
                    return [SLOT_MORNING];
                }

                let daySlots = [SLOT_MORNING, SLOT_AFTERNOON, SLOT_EVENING];

                if (isToday) {
                    const currentHour = now.getHours();
                    if (currentHour >= 17) {
                        daySlots = [SLOT_EVENING];
                    } else if (currentHour >= 14) {
                        daySlots = [SLOT_AFTERNOON, SLOT_EVENING];
                    } else if (currentHour >= 10) {
                        daySlots = [SLOT_MORNING, SLOT_AFTERNOON, SLOT_EVENING];
                    }
                }

                return daySlots;
            }

            function syncMiddleSlotUI() {
                if (!timeSlot || !middleBox) return;
                if (timeSlot.value === SLOT_AFTERNOON) {
                    middleBox.classList.remove('hidden');
                } else {
                    middleBox.classList.add('hidden');
                    if (middleCheckbox) middleCheckbox.checked = false;
                    if (middleError) middleError.classList.add('hidden');
                }
            }

            function refreshSlotsForSelectedDate() {
                if (!dateInput || !timeSlot) return;

                let chosenYMD = dateInput.value;
                const chosenDate = parseLocalYMD(chosenYMD);

                if (!chosenDate || chosenYMD < todayStr) {
                    chosenYMD = todayStr;
                    dateInput.value = todayStr;
                }

                const parsedToday = parseLocalYMD(todayStr);
                const isTodaySunday = parsedToday && parsedToday.getDay() === 0;

                if (chosenYMD === todayStr && isTodaySunday && isPastNoonToday) {
                    const mondayDate = new Date(parsedToday);
                    mondayDate.setDate(mondayDate.getDate() + 1);
                    chosenYMD = formatLocalYMD(mondayDate);
                    dateInput.value = chosenYMD;
                    dateInput.classList.add('opacity-90');
                    if (sundayPostNoonNotice) {
                        sundayPostNoonNotice.classList.remove('hidden');
                        sundayPostNoonNotice.classList.add('opacity-100');
                    }
                } else {
                    const selectedParsed = parseLocalYMD(chosenYMD);
                    const isSelectedSunday = selectedParsed && selectedParsed.getDay() === 0;
                    if (sundayPostNoonNotice) {
                        if (isSelectedSunday && isPastNoonToday && chosenYMD === todayStr) {
                            sundayPostNoonNotice.classList.remove('hidden');
                        } else {
                            sundayPostNoonNotice.classList.add('hidden');
                        }
                    }
                }

                const availableSlots = getAvailableSlotsForDate(chosenYMD);
                const prevValue = timeSlot.value;
                timeSlot.innerHTML = '';

                availableSlots.forEach((slotLabel) => {
                    const opt = document.createElement('option');
                    opt.value = slotLabel;
                    opt.textContent = slotLabel;
                    timeSlot.appendChild(opt);
                });

                if (availableSlots.includes(prevValue)) {
                    timeSlot.value = prevValue;
                } else if (availableSlots.length > 0) {
                    timeSlot.value = availableSlots[0];
                }

                syncMiddleSlotUI();
            }

            if (dateInput) {
                dateInput.min = todayStr;
                dateInput.max = maxDateStr;
                if (!dateInput.value || dateInput.value < todayStr) {
                    dateInput.value = todayStr;
                }
                refreshSlotsForSelectedDate();
                dateInput.addEventListener('change', () => {
                    document.getElementById('dateError').classList.add('hidden');
                    dateInput.classList.remove('border-rose-600');
                    refreshSlotsForSelectedDate();
                });
            }

            if (timeSlot) {
                timeSlot.addEventListener('change', syncMiddleSlotUI);
            }

            if (middleCheckbox && middleError) {
                middleCheckbox.addEventListener('change', () => {
                    if (middleCheckbox.checked) {
                        middleError.classList.add('hidden');
                    }
                });
            }

            if (dobInput) {
                dobInput.min = '1930-01-01';
                dobInput.max = todayStr;
            }

            if (topPayBtn && topPayNotice) {
                topPayBtn.addEventListener('click', () => {
                    topPayNotice.classList.remove('hidden');
                    if (window.trackEvent) {
                        window.trackEvent('click_post_treatment_payment_placeholder', {
                            location: 'top_bar',
                            planned_gateways: 'razorpay,cashfree,pinelabs,payu'
                        });
                    }
                });
            }

            if (closeTopPayNotice && topPayNotice) {
                closeTopPayNotice.addEventListener('click', () => {
                    topPayNotice.classList.add('hidden');
                });
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    const nameInput = document.getElementById('patientName');
                    const phoneInput = document.getElementById('patientPhone');
                    const dobField = document.getElementById('patientDob');
                    const genderField = document.getElementById('patientGender');
                    const serviceInput = document.getElementById('treatmentService');

                    const nameError = document.getElementById('nameError');
                    const phoneError = document.getElementById('phoneError');
                    const dobError = document.getElementById('dobError');
                    const genderError = document.getElementById('genderError');
                    const dateError = document.getElementById('dateError');
                    const slotError = document.getElementById('slotError');

                    let isValid = true;

                    if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
                        nameError.classList.remove('hidden');
                        nameInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        nameError.classList.add('hidden');
                        nameInput.classList.remove('border-rose-600');
                    }

                    const cleanPhone = phoneInput.value.replace(/\D/g, '');
                    if (!/^\d{10}$/.test(cleanPhone)) {
                        phoneError.classList.remove('hidden');
                        phoneInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        phoneError.classList.add('hidden');
                        phoneInput.classList.remove('border-rose-600');
                    }

                    const dobVal = dobField.value;
                    const dobCheckDate = dobVal ? parseLocalYMD(dobVal) : null;
                    const minDobDate = parseLocalYMD('1930-01-01');
                    const maxDobDate = parseLocalYMD(todayStr);
                    if (!dobVal || !dobCheckDate || dobCheckDate < minDobDate || dobCheckDate > maxDobDate) {
                        dobError.classList.remove('hidden');
                        dobField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dobError.classList.add('hidden');
                        dobField.classList.remove('border-rose-600');
                    }

                    if (!genderField.value) {
                        genderError.classList.remove('hidden');
                        genderField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        genderError.classList.add('hidden');
                        genderField.classList.remove('border-rose-600');
                    }

                    const apptVal = dateInput.value;
                    const apptParsed = parseLocalYMD(apptVal);
                    const isApptSunday = apptParsed && apptParsed.getDay() === 0;
                    if (!apptVal || apptVal < todayStr || apptVal > maxDateStr || (apptVal === todayStr && isApptSunday && isPastNoonToday)) {
                        dateError.classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dateError.classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }

                    const validSlots = getAvailableSlotsForDate(apptVal);
                    if (!timeSlot || !timeSlot.value || !validSlots.includes(timeSlot.value)) {
                        slotError.classList.remove('hidden');
                        isValid = false;
                    } else {
                        slotError.classList.add('hidden');
                    }

                    if (timeSlot && timeSlot.value === SLOT_AFTERNOON) {
                        if (!middleCheckbox || !middleCheckbox.checked) {
                            if (middleError) middleError.classList.remove('hidden');
                            isValid = false;
                        } else if (middleError) {
                            middleError.classList.add('hidden');
                        }
                    }

                    if (!isValid) return;

                    const name = nameInput.value.trim();
                    const phone = cleanPhone;
                    const dob = dobVal;
                    const gender = genderField.value;
                    const service = serviceInput.value;
                    const date = apptVal;
                    const slot = timeSlot.value;
                    const complaints = complaintsInput ? complaintsInput.value.trim() : '';
                    const medHistory = historyInput ? historyInput.value.trim() : '';
                    const allergies = allergiesInput ? allergiesInput.value.trim() : '';

                    const dobDate = parseLocalYMD(dob);
                    const todayDate = parseLocalYMD(todayStr);
                    let calculatedAge = todayDate.getFullYear() - dobDate.getFullYear();
                    const monthDiff = todayDate.getMonth() - dobDate.getMonth();
                    if (monthDiff < 0 || (monthDiff === 0 && todayDate.getDate() < dobDate.getDate())) {
                        calculatedAge--;
                    }

                    if (window.trackEvent) {
                        window.trackEvent('submit_appointment_form', {
                            service_requested: service,
                            preferred_slot: slot,
                            preferred_date: date,
                            patient_gender: gender,
                            patient_age: calculatedAge
                        });
                    }

                    const complaintsLine = complaints ? `%0A• Complaints: ${encodeURIComponent(complaints)}` : '';
                    const historyLine = medHistory ? `%0A• Medical History: ${encodeURIComponent(medHistory)}` : '';
                    const allergiesLine = allergies ? `%0A• Medical Allergies: ${encodeURIComponent(allergies)}` : '';

                    const message = `Hello Dr. Riddhi Patel Shah (Infinora Dental Care),%0A%0AI would like to request a consultation.%0A%0A📋 *Patient Details:*%0A• Name: ${encodeURIComponent(name)}%0A• Mobile: ${encodeURIComponent(phone)}%0A• Age: ${encodeURIComponent(calculatedAge + ' years')} (DOB: ${encodeURIComponent(dob)})%0A• Gender: ${encodeURIComponent(gender)}%0A• Service: ${encodeURIComponent(service)}%0A• Preferred Date: ${encodeURIComponent(date)}%0A• Time Slot: ${encodeURIComponent(slot)}${complaintsLine}${historyLine}${allergiesLine}%0A%0APlease confirm my appointment. Thank you!`;

                    if (statusBox) {
                        statusBox.classList.remove('hidden');
                    }

                    window.open(`https://wa.me/917304432681?text=${message}`, '_blank');
                });
            }
        });
    </script>
</Layout>
