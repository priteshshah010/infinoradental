---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Infinora Dental Care | Dr. Riddhi Patel Shah (MDS) | Kandivali West, Mumbai" 
    description="Specialist-led dental practice in Kandivali West, Mumbai. General checkups, family dentistry, orthodontics, smile design, implants, and root canal care."
>
    <!-- Top Announcement Bar -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2 px-4 sm:px-6 border-b border-slate-800 w-full">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
            
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 bg-teal-900 text-teal-300 border border-teal-700/60 px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Now Welcoming Patients in Kandivali West
                </span>
                <span class="text-slate-300 font-medium text-xs">
                    Metro Line 2A & Western Line Access
                </span>
            </div>

            <div class="flex items-center gap-3 text-xs font-semibold">
                <!-- Multi-Language Switcher -->
                <div class="flex items-center gap-1 bg-slate-900 border border-slate-800 px-1.5 py-0.5 rounded-lg notranslate">
                    <button type="button" onclick="changeLanguage('en')" data-lang="en" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold bg-teal-500 text-slate-950 transition-colors">
                        EN
                    </button>
                    <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-slate-300 hover:text-white transition-colors">
                        ગુજ
                    </button>
                    <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-slate-300 hover:text-white transition-colors">
                        हि
                    </button>
                    <button type="button" onclick="changeLanguage('mr')" data-lang="mr" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-slate-300 hover:text-white transition-colors">
                        મरा
                    </button>
                </div>

                <span class="text-slate-700 hidden sm:inline">|</span>

                <button type="button" onclick="downloadVCard()" class="text-teal-400 hover:text-teal-300 flex items-center gap-1 transition-colors cursor-pointer" title="Save Infinora Dental Care to Contacts">
                    <span>📇 Save Contact</span>
                </button>

                <span class="text-slate-700 hidden sm:inline">|</span>
                
                <a href="tel:+917304432681" class="hover:text-teal-400 transition-colors flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    +91 73044 32681
                </a>
            </div>

        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm w-full">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-18 sm:h-20 flex items-center justify-between gap-4">
            
            <a href="#" class="flex items-center gap-3 min-w-0 group">
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-teal-700 to-teal-900 text-white flex items-center justify-center font-black text-lg sm:text-xl shadow-md shadow-teal-700/20 shrink-0 group-hover:scale-105 transition-transform">
                    IDC
                </div>
                <div class="min-w-0">
                    <span class="text-base sm:text-xl font-extrabold tracking-tight text-slate-900 block leading-tight truncate">Infinora Dental Care</span>
                    <span class="text-[10px] sm:text-xs font-semibold tracking-wider text-teal-700 block truncate">Kandivali West, Mumbai</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-7 text-sm font-semibold text-slate-700">
                <a href="#smile-design" class="hover:text-teal-700 transition-colors">Smile Planning</a>
                <a href="#catalogue" class="hover:text-teal-700 transition-colors">Treatments</a>
                <a href="#why-us" class="hover:text-teal-700 transition-colors">Our Approach</a>
                <a href="#community" class="hover:text-teal-700 transition-colors">Community</a>
                <a href="#about" class="hover:text-teal-700 transition-colors">Dr. Riddhi</a>
                <a href="#location" class="hover:text-teal-700 transition-colors">Location</a>
            </nav>

            <div class="flex items-center gap-2.5 shrink-0">
                <a href="#book" class="inline-flex items-center gap-1.5 bg-teal-700 hover:bg-teal-800 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md shadow-teal-700/20 transition-all">
                    <span>Book Appointment</span>
                </a>
                <a href="tel:+917304432681" class="hidden sm:inline-flex bg-slate-900 hover:bg-slate-800 text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all">
                    +91 73044 32681
                </a>
            </div>
        </div>
    </header>

    <main class="w-full overflow-hidden pb-24 sm:pb-0">

        <!-- Hero Section -->
        <section class="relative pt-8 pb-14 sm:pt-16 sm:pb-22 overflow-hidden bg-gradient-to-b from-teal-50/70 via-slate-50/30 to-white w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                
                <div class="lg:col-span-7 space-y-5 text-left min-w-0">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-100/90 border border-teal-200 text-teal-900 text-xs font-bold tracking-wide uppercase max-w-full">
                        <span class="w-2 h-2 rounded-full bg-teal-600 shrink-0"></span> 
                        <span class="truncate">Specialist-Led Dental Practice in Kandivali West</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-950 leading-[1.14] break-words">
                        Dentistry with clinical precision. <br/>
                        <span class="text-teal-700">Care with a human touch.</span>
                    </h1>

                    <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-2xl break-words">
                        Welcome to <strong>Infinora Dental Care</strong> in Kandivali West, Mumbai. Directed by MDS Orthodontist <strong>Dr. Riddhi Patel Shah</strong> alongside a dedicated specialist board. We provide thoughtful, comprehensive dental care designed for families, adults, children, and orthodontic patients.
                    </p>

                    <!-- Launch Privilege Banner -->
                    <div class="p-5 rounded-2xl bg-gradient-to-br from-slate-950 via-teal-950 to-slate-900 text-white shadow-xl border border-teal-700/40 space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <span class="bg-teal-500/20 text-teal-300 text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded border border-teal-500/30">
                                Now Open in Kandivali West
                            </span>
                            <span class="text-xs text-amber-300 font-bold">Initial Consultation Welcome</span>
                        </div>
                        <div>
                            <h2 class="text-base sm:text-lg font-bold text-white">Thoughtful Dental Care for You & Your Family</h2>
                            <p class="text-xs text-slate-300 leading-relaxed mt-0.5">
                                Good dentistry starts with listening. Book a thorough examination with Dr. Riddhi to discuss your oral health goals in a comfortable, pressure-free environment.
                            </p>
                        </div>
                        <div class="pt-1">
                            <a href="#book" class="inline-flex items-center gap-1.5 bg-teal-500 hover:bg-teal-400 text-slate-950 px-4 py-2 rounded-xl font-extrabold text-xs sm:text-sm transition-all shadow-md">
                                Book Your First Visit ↓
                            </a>
                        </div>
                    </div>

                    <!-- Action CTAs -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-1">
                        <a href="#book" class="inline-flex items-center justify-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-bold px-6 py-3.5 rounded-xl shadow-lg shadow-teal-700/25 transition-all text-sm sm:text-base text-center">
                            Book a Consultation
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <button type="button" onclick="downloadVCard()" class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 font-bold px-6 py-3.5 rounded-xl shadow-sm transition-all text-sm sm:text-base text-center cursor-pointer">
                            📇 Save Clinic Contact
                        </button>
                    </div>

                    <!-- Trust Bar / Principles -->
                    <div class="pt-3 grid grid-cols-3 gap-3 border-t border-slate-200">
                        <div class="p-2.5 sm:p-3 bg-white rounded-xl border border-slate-100 shadow-sm text-center sm:text-left">
                            <div class="text-base sm:text-xl font-black text-slate-900">Specialist-Led</div>
                            <div class="text-[10px] sm:text-xs text-slate-500 font-medium">MDS Qualifications</div>
                        </div>
                        <div class="p-2.5 sm:p-3 bg-white rounded-xl border border-slate-100 shadow-sm text-center sm:text-left">
                            <div class="text-base sm:text-xl font-black text-slate-900">Transparent</div>
                            <div class="text-[10px] sm:text-xs text-slate-500 font-medium">Clear Options & Costs</div>
                        </div>
                        <div class="p-2.5 sm:p-3 bg-white rounded-xl border border-slate-100 shadow-sm text-center sm:text-left">
                            <div class="text-base sm:text-xl font-black text-slate-900">Conservative</div>
                            <div class="text-[10px] sm:text-xs text-slate-500 font-medium">Tooth Preservation</div>
                        </div>
                    </div>
                </div>

                <!-- Doctor Profile & Master Specialist Collective Card -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-xl space-y-4">
                        <div class="flex items-center gap-3.5 border-b border-slate-100 pb-4">
                            <div class="w-13 h-13 sm:w-14 sm:h-14 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-700 font-black text-2xl shrink-0">
                                👩‍⚕️
                            </div>
                            <div class="min-w-0">
                                <h2 class="font-extrabold text-slate-900 text-lg leading-tight truncate">Dr. Riddhi Patel Shah</h2>
                                <p class="text-xs text-teal-700 font-bold tracking-wide">MDS – Orthodontics & Dentofacial Orthopedics</p>
                                <p class="text-[11px] text-slate-400 font-medium">Founder & Chief Dental Surgeon</p>
                            </div>
                        </div>

                        <div class="space-y-2.5 text-xs text-slate-600 leading-relaxed break-words">
                            <p>
                                Dentistry, for Dr. Riddhi, is not simply about treating teeth. It is about understanding the person sitting in the chair, explaining what is happening, and creating a treatment plan that makes sense for that individual.
                            </p>
                            <p>
                                When specialized interventions are needed, our dedicated <strong>MDS Specialist Board</strong> coordinates together across Endodontics, Oral & Maxillofacial Surgery, Prosthodontics, and Periodontics for complete clinical precision.
                            </p>
                        </div>

                        <div class="bg-slate-50 rounded-2xl p-3.5 border border-slate-100 space-y-2 text-xs">
                            <div class="font-bold text-slate-900 text-[11px] uppercase tracking-wider text-teal-800">
                                What Every Patient Experiences at Infinora
                            </div>
                            <ul class="space-y-1.5 text-[11px] text-slate-700 font-medium">
                                <li>• Understand before we treat</li>
                                <li>• Explain before we proceed</li>
                                <li>• Preserve healthy tooth structure whenever appropriate</li>
                                <li>• Recommend what is suitable, never excessive</li>
                            </ul>
                        </div>

                        <div class="pt-1">
                            <a href="#book" class="w-full text-center py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold block transition-colors shadow-md">
                                Book Consultation with Dr. Riddhi →
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- OFFICIAL ACCREDITATIONS & AFFILIATIONS BAR -->
        <section class="py-6 bg-white border-y border-slate-100 w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-wrap items-center justify-around gap-6 text-center">
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center font-black text-xs">🏛️</span>
                    <div class="text-left">
                        <div class="text-xs font-black text-slate-900">Maharashtra State Dental Council (MSDC)</div>
                        <div class="text-[10px] text-slate-500 font-medium">Registered Medical Practitioner</div>
                    </div>
                </div>
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center font-black text-xs">🇮🇳</span>
                    <div class="text-left">
                        <div class="text-xs font-black text-slate-900">Indian Dental Association (IDA)</div>
                        <div class="text-[10px] text-slate-500 font-medium">Active Professional Member</div>
                    </div>
                </div>
                <div class="flex items-center gap-2.5">
                    <span class="w-8 h-8 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center font-black text-xs">🛡️</span>
                    <div class="text-left">
                        <div class="text-xs font-black text-slate-900">Hospital Class-B Autoclave Certified</div>
                        <div class="text-[10px] text-slate-500 font-medium">Sealed Sterile Pouch Protocol</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SMILE PLANNING FOR IMPORTANT EVENTS -->
        <section id="smile-design" class="py-16 bg-slate-50 w-full border-b border-slate-200">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                    
                    <div class="lg:col-span-6 space-y-5 min-w-0">
                        <span class="text-teal-700 text-xs font-extrabold tracking-widest uppercase bg-teal-100 px-3.5 py-1 rounded-full">
                            Aesthetic Facial Architecture
                        </span>
                        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
                            Smile Planning for Important Events
                        </h2>
                        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                            If you have a wedding, event, photoshoot or professional milestone approaching, we'll help you understand which treatments can realistically be completed within your timeline.
                        </p>

                        <div class="space-y-3 text-xs sm:text-sm text-slate-700">
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>Facial Proportion Mapping:</strong> Tailoring tooth contour, exposure, and arch width to your facial features and smile line.</div>
                            </div>
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>Teen & Adult Orthodontics:</strong> Low-profile ceramic aesthetic brackets and discreet aligners planned around your lifestyle.</div>
                            </div>
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>Realistic Event Sprints:</strong> Custom composite bonding, whitening, and alignment pathways aligned with your calendar.</div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a href="#book" class="inline-flex items-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-bold px-6 py-3 rounded-xl text-xs sm:text-sm shadow-md transition-all">
                                Book Event Smile Consultation →
                            </a>
                        </div>
                    </div>

                    <div class="lg:col-span-6 bg-slate-900 text-white rounded-3xl p-6 sm:p-8 space-y-5 border border-slate-800 shadow-xl">
                        <h3 class="text-lg sm:text-xl font-extrabold text-white">The Infinora Standard</h3>
                        <div class="space-y-3 text-xs sm:text-sm">
                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="font-bold text-teal-300">01 - Understand & Diagnose</div>
                                <p class="text-slate-300 text-xs leading-relaxed">We evaluate your dental health, history, and goals using appropriate clinical diagnostics.</p>
                            </div>
                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="font-bold text-teal-300">02 - Explain Options & Costs</div>
                                <p class="text-slate-300 text-xs leading-relaxed">We discuss treatment alternatives, benefits, limitations, and expected investment before starting.</p>
                            </div>
                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="font-bold text-teal-300">03 - Thoughtful Care</div>
                                <p class="text-slate-300 text-xs leading-relaxed">Treatment is delivered with attention to detail, comfort, and safety, followed by ongoing support.</p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- CLEAR ALIGNERS STUDIO -->
        <section id="aligners" class="py-16 bg-white w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                    
                    <div class="lg:col-span-6 space-y-5 min-w-0">
                        <span class="text-teal-700 text-xs font-extrabold tracking-widest uppercase bg-teal-100 px-3.5 py-1 rounded-full">
                            Flagship Orthodontic Studio
                        </span>
                        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-slate-900">
                            Invisible Clear Aligners & Precision Braces
                        </h2>
                        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                            Supervised directly by MDS Orthodontist <strong>Dr. Riddhi Patel Shah</strong>. For our clear aligner patients, we deploy dedicated 3D intraoral optical scanning to construct custom aligners designed for discreet orthodontic treatment with appointments planned around your individual treatment needs.
                        </p>

                        <div class="space-y-3 text-xs sm:text-sm text-slate-700">
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>3D Digital Simulation:</strong> Preview your projected tooth movements before committing to treatment.</div>
                            </div>
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>Removable & Practical:</strong> Aligners are removable, allowing you to eat and maintain your usual oral hygiene routine.</div>
                            </div>
                            <div class="flex items-start gap-2.5">
                                <span class="text-teal-600 font-bold text-base shrink-0">✓</span>
                                <div><strong>Specialist Oversight:</strong> Orthodontic care managed with careful monitoring of periodontal and root health.</div>
                            </div>
                        </div>

                        <div class="pt-2">
                            <a href="#book" class="inline-flex items-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-bold px-6 py-3 rounded-xl text-xs sm:text-sm shadow-md transition-all">
                                Book Aligner Assessment →
                            </a>
                        </div>
                    </div>

                    <div class="lg:col-span-6 bg-slate-900 text-white rounded-3xl p-6 sm:p-8 space-y-5 border border-slate-800 shadow-xl">
                        <h3 class="text-lg sm:text-xl font-extrabold text-white">Compare Orthodontic Solutions</h3>
                        <div class="space-y-3 text-xs sm:text-sm">
                            
                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="flex justify-between font-bold text-teal-300">
                                    <span>Invisible Clear Aligners</span>
                                    <span>Adults & Teens</span>
                                </div>
                                <p class="text-slate-300 text-xs leading-relaxed">
                                    Transparent removable trays with 3D planning. Discreet and convenient for daily professional and social life.
                                </p>
                            </div>

                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="flex justify-between font-bold text-teal-300">
                                    <span>Self-Ligating Ceramic Braces</span>
                                    <span>Fixed & Aesthetic</span>
                                </div>
                                <p class="text-slate-300 text-xs leading-relaxed">
                                    Tooth-colored ceramic brackets blending naturally with enamel. Designed for efficient and discreet mechanical tooth movement.
                                </p>
                            </div>

                            <div class="p-4 rounded-2xl bg-slate-800/80 border border-slate-700 space-y-1">
                                <div class="flex justify-between font-bold text-teal-300">
                                    <span>Advanced Metallic Braces</span>
                                    <span>Precision Mechanics</span>
                                </div>
                                <p class="text-slate-300 text-xs leading-relaxed">
                                    High-grade brackets suitable for complex malocclusions and comprehensive adolescent care.
                                </p>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- INTERACTIVE APPOINTMENT BOOKING SECTION -->
        <section id="book" class="py-16 bg-slate-900 text-white w-full border-t border-slate-800 relative">
            <div class="max-w-4xl mx-auto px-4 sm:px-6">
                
                <div class="text-center space-y-2.5 mb-10">
                    <span class="text-teal-400 text-xs font-extrabold tracking-widest uppercase bg-teal-950 border border-teal-800 px-3.5 py-1 rounded-full">
                        Direct Slot Reservation
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
                        Book In-Clinic or Teleconsultation Appointment
                    </h2>
                    <p class="text-slate-300 text-xs sm:text-sm max-w-xl mx-auto">
                        Fill out your details below to submit your appointment request to Dr. Riddhi Patel Shah.
                    </p>
                </div>

                <!-- Booking Form Card -->
                <div class="bg-white text-slate-900 rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-2xl space-y-4">
                    
                    <form id="appointmentForm" class="space-y-4" novalidate>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="patientName">
                                    Full Name *
                                </label>
                                <input 
                                    type="text" 
                                    id="patientName" 
                                    required 
                                    placeholder="e.g. Amit Sharma" 
                                    class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all"
                                />
                                <p id="nameError" class="hidden text-xs text-rose-600 font-semibold mt-1">Please enter your full name.</p>
                            </div>

                            <div>
                                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5" for="patientPhone">
                                    Mobile Number *
                                </label>
                                <input 
                                    type="tel" 
                                    id="patientPhone" 
