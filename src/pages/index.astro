    <!-- Comprehensive Interaction Script (Strict Validations, 3 PM - 5 PM Slot Enforcement, Consent, Files, AI Prep, Payment Placeholder & WhatsApp Handoff) -->
    <script is:inline>
        const ALLOWED_APPT_SLOT = '3:00 PM – 5:00 PM (Only Available Appointment Slot — None Other Slots Work)';
        const MAX_FILES = 5;
        const MAX_FILE_BYTES = 5 * 1024 * 1024;
        const ALLOWED_MIME_TYPES = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];

        window.selectService = function(keyword) {
            const select = document.getElementById('treatmentService');
            if (select) {
                for (let opt of select.options) {
                    if (opt.value.toLowerCase().includes(keyword.toLowerCase()) || opt.text.toLowerCase().includes(keyword.toLowerCase())) {
                        select.value = opt.value;
                        break;
                    }
                }
            }
            const bookSection = document.getElementById('book');
            if (bookSection) {
                bookSection.scrollIntoView({ behavior: 'smooth' });
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('appointmentDate');
            const dobInput = document.getElementById('patientDob');
            const timeSlot = document.getElementById('timeSlot');
            const serviceSelect = document.getElementById('treatmentService');
            const visitNotesInput = document.getElementById('visitNotes');
            const generatePrepBtn = document.getElementById('generatePrepBtn');
            const aiPrepOutput = document.getElementById('aiPrepOutput');
            const aiPrepList = document.getElementById('aiPrepList');
            const fileInput = document.getElementById('healthRecordsInput');
            const fileError = document.getElementById('fileError');
            const selectedFilesList = document.getElementById('selectedFilesList');
            const consentProcedure = document.getElementById('consentProcedure');
            const consentSummaryText = document.getElementById('consentSummaryText');
            const consentCheckbox = document.getElementById('consentCheckbox');
            const payPlaceholderBtn = document.getElementById('payOnlinePlaceholderBtn');
            const payPlaceholderStatus = document.getElementById('paymentPlaceholderStatus');
            const statusBox = document.getElementById('whatsappStatusBox');
            const form = document.getElementById('appointmentForm');

            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const todayStr = `${year}-${month}-${day}`;

            if (dateInput) {
                dateInput.min = todayStr;

                const maxDate = new Date();
                maxDate.setDate(maxDate.getDate() + 90);
                const maxYear = maxDate.getFullYear();
                const maxMonth = String(maxDate.getMonth() + 1).padStart(2, '0');
                const maxDay = String(maxDate.getDate()).padStart(2, '0');
                const maxDateStr = `${maxYear}-${maxMonth}-${maxDay}`;
                dateInput.max = maxDateStr;

                if (!dateInput.value || dateInput.value < todayStr) {
                    dateInput.value = todayStr;
                }

                dateInput.addEventListener('change', () => {
                    if (dateInput.value && dateInput.value < todayStr) {
                        document.getElementById('dateError').classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                    } else {
                        document.getElementById('dateError').classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }
                });
            }

            if (dobInput) {
                dobInput.min = '1900-01-01';
                dobInput.max = todayStr;
            }

            if (timeSlot) {
                timeSlot.value = ALLOWED_APPT_SLOT;
                timeSlot.addEventListener('change', () => {
                    if (timeSlot.value !== ALLOWED_APPT_SLOT) {
                        timeSlot.value = ALLOWED_APPT_SLOT;
                        document.getElementById('slotError').classList.remove('hidden');
                    } else {
                        document.getElementById('slotError').classList.add('hidden');
                    }
                });
            }

            const consentSummaries = {
                'General Dental Evaluation & Diagnostic Consent': 'I understand that a clinical examination and diagnostic checkup are required before treatment planning, and that appointments are taken strictly for 3:00 PM – 5:00 PM (none other slots work for appointments).',
                'Orthodontics, Braces & Clear Aligners Consent': 'I understand that orthodontic suitability, appliance selection (braces or clear aligners), risks such as root or gum changes, and retention/follow-up commitments depend on clinical evaluation.',
                'Dental Implants & Prosthetic Replacement Consent': 'I understand that implant or prosthetic options require bone, gum, and bite evaluation, and that healing stages, timelines, and follow-up care vary by individual.',
                'Full-Mouth Rehabilitation Assessment Consent': 'I understand that full-mouth rehabilitation involves comprehensive functional and bite assessment across teeth/restorations, with individualized plans and timelines without fixed guarantees.',
                'Root Canal Treatment (RCT) & Restorative Consent': 'I understand that endodontic and restorative options, visit requirements, and post-treatment crown or filling protection depend on clinical findings.',
                'Wisdom Tooth / Tooth Extraction & Oral Surgery Consent': 'I understand that extractions or oral surgery involve pre-procedure assessment, post-operative healing/aftercare steps, and potential procedural risks discussed during consultation.'
            };

            if (consentProcedure && consentSummaryText) {
                consentProcedure.addEventListener('change', () => {
                    consentSummaryText.textContent = consentSummaries[consentProcedure.value] || consentSummaries['General Dental Evaluation & Diagnostic Consent'];
                });
            }

            function validateAttachedFiles() {
                if (!fileInput || !fileError || !selectedFilesList) return { valid: true, files: [] };
                fileError.classList.add('hidden');
                fileError.textContent = '';
                selectedFilesList.innerHTML = '';

                const files = Array.from(fileInput.files || []);
                if (files.length === 0) {
                    return { valid: true, files: [] };
                }

                if (files.length > MAX_FILES) {
                    fileError.textContent = `Please select up to ${MAX_FILES} files at a time.`;
                    fileError.classList.remove('hidden');
                    return { valid: false, files: [] };
                }

                for (const file of files) {
                    const extValid = /\.(pdf|jpe?g|png|webp)$/i.test(file.name);
                    const mimeValid = ALLOWED_MIME_TYPES.includes(file.type) || extValid;
                    if (!mimeValid) {
                        fileError.textContent = `Unsupported file "${file.name}". Please upload PDF, JPG, PNG, or WEBP files only.`;
                        fileError.classList.remove('hidden');
                        return { valid: false, files: [] };
                    }
                    if (file.size > MAX_FILE_BYTES) {
                        fileError.textContent = `"${file.name}" exceeds the 5 MB per-file limit.`;
                        fileError.classList.remove('hidden');
                        return { valid: false, files: [] };
                    }
                }

                files.forEach((f) => {
                    const li = document.createElement('li');
                    const sizeKb = Math.max(1, Math.round(f.size / 1024));
                    li.textContent = `• ${f.name} (${sizeKb} KB)`;
                    selectedFilesList.appendChild(li);
                });

                return { valid: true, files };
            }

            if (fileInput) {
                fileInput.addEventListener('change', validateAttachedFiles);
            }

            function buildPrepChecklist() {
                const svc = (serviceSelect ? serviceSelect.value : '').toLowerCase();
                const notes = (visitNotesInput ? visitNotesInput.value : '').toLowerCase();
                const items = [
                    'Arrive a few minutes early for your 3:00 PM – 5:00 PM appointment slot.',
                    'Carry any recent dental X-rays, OPG/CBCT scans, prescriptions, or medical history notes.'
                ];

                if (svc.includes('orthodontic') || svc.includes('braces') || svc.includes('aligner') || svc.includes('smile design')) {
                    items.push('Note any past braces/aligner history, jaw clicking/clenching, or specific alignment goals.');
                }
                if (svc.includes('implant') || svc.includes('rehabilitation') || notes.includes('missing')) {
                    items.push('List missing teeth, current dentures/bridges/crowns, and any relevant medical conditions or medications.');
                }
                if (svc.includes('root canal') || notes.includes('pain') || notes.includes('sensitivity')) {
                    items.push('Note which side/tooth feels sensitive or painful and whether hot/cold or biting triggers discomfort.');
                }
                if (svc.includes('pediatric') || svc.includes('kids')) {
                    items.push('Bring your child’s age details, habit history (such as thumb-sucking or mouth breathing), and comfort preferences.');
                }

                if (aiPrepList && aiPrepOutput) {
                    aiPrepList.innerHTML = '';
                    items.forEach((txt) => {
                        const li = document.createElement('li');
                        li.textContent = txt;
                        aiPrepList.appendChild(li);
                    });
                    aiPrepOutput.classList.remove('hidden');
                }
                return items;
            }

            if (generatePrepBtn) {
                generatePrepBtn.addEventListener('click', buildPrepChecklist);
            }

            if (payPlaceholderBtn) {
                payPlaceholderBtn.addEventListener('click', () => {
                    if (payPlaceholderStatus) {
                        payPlaceholderStatus.classList.remove('hidden');
                    }
                    if (window.trackEvent) {
                        window.trackEvent('click_payment_gateway_placeholder', {
                            planned_gateways: 'razorpay,cashfree,pinelabs,payu'
                        });
                    }
                });
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    const nameInput = document.getElementById('patientName');
                    const phoneInput = document.getElementById('patientPhone');
                    const dobField = document.getElementById('patientDob');
                    const genderField = document.getElementById('patientGender');
                    const serviceInput = document.getElementById('treatmentService');

                    const nameError = document.getElementById('nameError');
                    const phoneError = document.getElementById('phoneError');
                    const dobError = document.getElementById('dobError');
                    const genderError = document.getElementById('genderError');
                    const dateError = document.getElementById('dateError');
                    const slotError = document.getElementById('slotError');
                    const consentError = document.getElementById('consentError');

                    let isValid = true;

                    if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
                        nameError.classList.remove('hidden');
                        nameInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        nameError.classList.add('hidden');
                        nameInput.classList.remove('border-rose-600');
                    }

                    const cleanPhone = phoneInput.value.replace(/[\s\-\+]/g, '');
                    if (!cleanPhone || cleanPhone.length < 8 || cleanPhone.length > 15 || !/^\d+$/.test(cleanPhone)) {
                        phoneError.classList.remove('hidden');
                        phoneInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        phoneError.classList.add('hidden');
                        phoneInput.classList.remove('border-rose-600');
                    }

                    const dobVal = dobField.value;
                    const dobCheckDate = dobVal ? new Date(dobVal + 'T00:00:00') : null;
                    const minDobDate = new Date('1900-01-01T00:00:00');
                    const maxDobDate = new Date(todayStr + 'T00:00:00');
                    if (!dobVal || !dobCheckDate || isNaN(dobCheckDate.getTime()) || dobCheckDate < minDobDate || dobCheckDate > maxDobDate) {
                        dobError.classList.remove('hidden');
                        dobField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dobError.classList.add('hidden');
                        dobField.classList.remove('border-rose-600');
                    }

                    if (!genderField.value) {
                        genderError.classList.remove('hidden');
                        genderField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        genderError.classList.add('hidden');
                        genderField.classList.remove('border-rose-600');
                    }

                    const apptVal = dateInput.value;
                    const maxApptStr = dateInput.max;
                    if (!apptVal || apptVal < todayStr || (maxApptStr && apptVal > maxApptStr)) {
                        dateError.classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dateError.classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }

                    if (!timeSlot || timeSlot.value !== ALLOWED_APPT_SLOT) {
                        if (timeSlot) timeSlot.value = ALLOWED_APPT_SLOT;
                        slotError.classList.remove('hidden');
                        isValid = false;
                    } else {
                        slotError.classList.add('hidden');
                    }

                    const fileCheck = validateAttachedFiles();
                    if (!fileCheck.valid) {
                        isValid = false;
                    }

                    if (!consentCheckbox || !consentCheckbox.checked) {
                        consentError.classList.remove('hidden');
                        isValid = false;
                    } else {
                        consentError.classList.add('hidden');
                    }

                    if (!isValid) return;

                    const name = nameInput.value.trim();
                    const phone = phoneInput.value.trim();
                    const dob = dobVal;
                    const gender = genderField.value;
                    const service = serviceInput.value;
                    const date = apptVal;
                    const slot = ALLOWED_APPT_SLOT;
                    const notes = visitNotesInput ? visitNotesInput.value.trim() : '';
                    const selectedConsent = consentProcedure ? consentProcedure.value : 'General Dental Evaluation & Diagnostic Consent';
                    const fileNames = fileCheck.files.map((f) => f.name).join(', ') || 'None selected (will share in chat if needed)';

                    const dobDate = new Date(dob + 'T00:00:00');
                    const todayDate = new Date(todayStr + 'T00:00:00');
                    let calculatedAge = todayDate.getFullYear() - dobDate.getFullYear();
                    const monthDiff = todayDate.getMonth() - dobDate.getMonth();
                    if (monthDiff < 0 || (monthDiff === 0 && todayDate.getDate() < dobDate.getDate())) {
                        calculatedAge--;
                    }

                    if (window.trackEvent) {
                        window.trackEvent('submit_appointment_form', {
                            service_requested: service,
                            preferred_slot: slot,
                            preferred_date: date,
                            patient_gender: gender,
                            patient_age: calculatedAge,
                            records_attached_count: fileCheck.files.length,
                            consent_acknowledged: true
                        });
                    }

                    const optionalBlock = notes ? `%0A• Pre-Visit Notes: ${encodeURIComponent(notes)}` : '';
                    const message = `Hello Dr. Riddhi Patel Shah (Infinora Dental Care),%0A%0AI would like to request a consultation during the 3:00 PM – 5:00 PM appointment slot.%0A%0A📋 *Patient Information:*%0A• Name: ${encodeURIComponent(name)}%0A• Mobile: ${encodeURIComponent(phone)}%0A• Age: ${encodeURIComponent(calculatedAge + ' years')} (DOB: ${encodeURIComponent(dob)})%0A• Gender: ${encodeURIComponent(gender)}%0A• Service: ${encodeURIComponent(service)}%0A• Preferred Date: ${encodeURIComponent(date)}%0A• Appointment Slot: ${encodeURIComponent(slot)} (None other slots work for appointments)${optionalBlock}%0A• Consent Form: ${encodeURIComponent(selectedConsent)} (Acknowledged)%0A• Health Records Selected: ${encodeURIComponent(fileNames)}%0A%0APlease review availability for 3:00 PM – 5:00 PM and confirm my visit. Thank you!`;

                    if (statusBox) {
                        statusBox.classList.remove('hidden');
                    }

                    window.open(`https://wa.me/917304432681?text=${message}`, '_blank');
                });
            }
        });
    </script>
</Layout>
