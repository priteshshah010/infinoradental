    window.selectService = function (keyword) {
      const select = document.getElementById('treatmentService');
      if (select) {
        for (const opt of select.options) {
          if (
            opt.value.toLowerCase().includes(keyword.toLowerCase()) ||
            opt.text.toLowerCase().includes(keyword.toLowerCase())
          ) {
            select.value = opt.value;
            break;
          }
        }
      }
      document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });
    };

    document.addEventListener('DOMContentLoaded', () => {
      // 1. Smooth Scroll-to-Top on Brand Logo Click
      document.querySelectorAll('.scroll-top-link').forEach((link) => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      });

      // 2. Accessible Mobile Navigation Drawer
      const menuBtn = document.getElementById('mobileMenuBtn');
      const closeBtn = document.getElementById('mobileMenuCloseBtn');
      const drawer = document.getElementById('mobileNavDrawer');
      const iconOpen = document.getElementById('menuIconOpen');
      const iconClose = document.getElementById('menuIconClose');

      function setDrawer(open) {
        if (!drawer || !menuBtn) return;
        drawer.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
        document.body.style.overflow = open ? 'hidden' : '';
        if (open) closeBtn?.focus();
        else menuBtn.focus();
      }

      menuBtn?.addEventListener('click', () => setDrawer(drawer?.classList.contains('hidden')));
      closeBtn?.addEventListener('click', () => setDrawer(false));
      document.querySelectorAll('.mobile-nav-link').forEach((a) => {
        a.addEventListener('click', () => setDrawer(false));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && drawer && !drawer.classList.contains('hidden')) {
          setDrawer(false);
        }
      });

      // 3. Reviews Carousel
      const slides = document.querySelectorAll('.review-slide');
      const dots = document.querySelectorAll('.review-dot');
      let currentSlide = 0;

      function showSlide(idx) {
        currentSlide = idx;
        slides.forEach((s, i) => s.classList.toggle('hidden', i !== idx));
        dots.forEach((d, i) => {
          d.setAttribute('aria-selected', String(i === idx));
          const inner = d.querySelector('.dot-inner');
          inner?.classList.toggle('bg-brand-navy', i === idx);
          inner?.classList.toggle('bg-slate-300', i !== idx);
        });
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          showSlide(Number(dot.getAttribute('data-slide-index') || 0));
        });
      });

      setInterval(() => {
        if (slides.length > 1) showSlide((currentSlide + 1) % slides.length);
      }, 6500);

      // 4. Populate Mobile-Friendly 3-Tap DOB Dropdowns (Day 01-31, Year Current -> 1930)
      const dobDay = document.getElementById('dobDay');
      const dobMonth = document.getElementById('dobMonth');
      const dobYear = document.getElementById('dobYear');
      const liveAgeBadge = document.getElementById('liveAgeBadge');
      const currentYear = new Date().getFullYear();

      if (dobDay) {
        for (let d = 1; d <= 31; d++) {
          const val = String(d).padStart(2, '0');
          dobDay.insertAdjacentHTML('beforeend', `<option value="${val}">${val}</option>`);
        }
      }
      if (dobYear) {
        for (let y = currentYear; y >= 1930; y--) {
          dobYear.insertAdjacentHTML('beforeend', `<option value="${y}">${y}</option>`);
        }
      }

      function computeValidDob() {
        if (!dobDay?.value || !dobMonth?.value || !dobYear?.value) {
          liveAgeBadge?.classList.add('hidden');
          return null;
        }
        const y = Number(dobYear.value);
        const m = Number(dobMonth.value);
        const d = Number(dobDay.value);
        const candidate = new Date(y, m - 1, d);
        const today = new Date();
        if (
          candidate.getFullYear() !== y ||
          candidate.getMonth() !== m - 1 ||
          candidate.getDate() !== d ||
          candidate > today ||
          y < 1930
        ) {
          liveAgeBadge?.classList.add('hidden');
          return null;
        }
        let age = today.getFullYear() - y;
        const mDiff = today.getMonth() - (m - 1);
        if (mDiff < 0 || (mDiff === 0 && today.getDate() < d)) age--;
        if (liveAgeBadge) {
          liveAgeBadge.textContent = `Age: ${age} yrs`;
          liveAgeBadge.classList.remove('hidden');
        }
        const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        return {
          formatted: `${String(d).padStart(2, '0')}-${monthNames[m - 1]}-${y}`,
          iso: `${y}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}`,
          age,
        };
      }

      [dobDay, dobMonth, dobYear].forEach((el) => el?.addEventListener('change', computeValidDob));

      // 5. Smart Returning-Patient Autofill (localStorage)
      const STORAGE_KEY = 'infinora_patient_prefill_v1';
      const savedBanner = document.getElementById('savedAutofillBanner');
      const clearSavedBtn = document.getElementById('clearSavedBtn');
      const nameInput = document.getElementById('patientName');
      const phoneInput = document.getElementById('patientPhone');
      const emailInput = document.getElementById('patientEmail');
      const genderField = document.getElementById('patientGender');

      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        if (saved && saved.name) {
          if (nameInput && !nameInput.value) nameInput.value = saved.name || '';
          if (phoneInput && !phoneInput.value) phoneInput.value = saved.phone || '';
          if (emailInput && !emailInput.value) emailInput.value = saved.email || '';
          if (genderField && !genderField.value) genderField.value = saved.gender || '';
          if (dobDay && saved.dobDay) dobDay.value = saved.dobDay;
          if (dobMonth && saved.dobMonth) dobMonth.value = saved.dobMonth;
          if (dobYear && saved.dobYear) dobYear.value = saved.dobYear;
          computeValidDob();
          savedBanner?.classList.remove('hidden');
          savedBanner?.classList.add('flex');
        }
      } catch (err) {}

      clearSavedBtn?.addEventListener('click', () => {
        try { localStorage.removeItem(STORAGE_KEY); } catch (err) {}
        if (nameInput) nameInput.value = '';
        if (phoneInput) phoneInput.value = '';
        if (emailInput) emailInput.value = '';
        if (genderField) genderField.value = '';
        if (dobDay) dobDay.value = '';
        if (dobMonth) dobMonth.value = '';
        if (dobYear) dobYear.value = '';
        liveAgeBadge?.classList.add('hidden');
        savedBanner?.classList.add('hidden');
      });

      // 6. One-Tap "No known allergies" Quick-Fill
      const allergiesInput = document.getElementById('medicalAllergies');
      document.getElementById('noAllergiesBtn')?.addEventListener('click', () => {
        if (allergiesInput) allergiesInput.value = 'No known allergies';
      });

      // 7. Dynamic Appointment Date & Morning (10-2) / Evening (5-9) Slot Logic
      const dateInput = document.getElementById('appointmentDate');
      const timeSlot = document.getElementById('timeSlot');
      const sundayAlert = document.getElementById('sundayAlertBox');

      function toISODate(d) {
        return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      }

      const now = new Date();
      const todayStr = toISODate(now);
      const defaultDate = new Date(now);
      // Rollover to Monday if Sunday past 12:00 PM, or to tomorrow if past 8:30 PM on Mon-Sat
      if (now.getDay() === 0 && now.getHours() >= 12) {
        defaultDate.setDate(defaultDate.getDate() + 1);
      } else if (now.getDay() !== 0 && (now.getHours() > 20 || (now.getHours() === 20 && now.getMinutes() >= 30))) {
        defaultDate.setDate(defaultDate.getDate() + 1);
      }

      function updateTimeSlotsForDate(dateString) {
        if (!dateString || !timeSlot) return;
        const [y, m, d] = dateString.split('-').map(Number);
        const selectedDate = new Date(y, m - 1, d);
        const isSunday = selectedDate.getDay() === 0;
        const isToday = dateString === todayStr;
        const currentHour = new Date().getHours();

        if (isSunday) {
          timeSlot.innerHTML = `
            <option value="Sunday Prior-Appointment Slot (10:00 AM – 01:00 PM)">
              Sunday Prior-Appointment Slot (10:00 AM – 01:00 PM)
            </option>
          `;
          sundayAlert?.classList.remove('hidden');
        } else {
          const morningPassed = isToday && currentHour >= 14;
          let options = '';
          if (!morningPassed) {
            options += `<option value="Morning Session (10:00 AM – 02:00 PM)">Morning Session (10:00 AM – 02:00 PM)</option>`;
          }
          options += `<option value="Evening Session (05:00 PM – 09:00 PM)">Evening Session (05:00 PM – 09:00 PM)</option>`;
          timeSlot.innerHTML = options;
          sundayAlert?.classList.add('hidden');
        }
      }

      if (dateInput) {
        dateInput.min = todayStr;
        const maxDate = new Date();
        maxDate.setDate(maxDate.getDate() + 90);
        dateInput.max = toISODate(maxDate);
        dateInput.value = toISODate(defaultDate);
        updateTimeSlotsForDate(dateInput.value);
        dateInput.addEventListener('change', (e) => updateTimeSlotsForDate(e.target.value));
      }

      // 8. Pay Online Placeholder Button
      const statusBanner = document.getElementById('bookingStatusBanner');
      document.getElementById('payOnlinePlaceholderBtn')?.addEventListener('click', () => {
        if (window.trackEvent) {
          window.trackEvent('click_payment_gateway_placeholder', { location: '#book' });
        }
        if (statusBanner) {
          statusBanner.innerHTML =
            '<strong>Online Payment Gateway Coming Soon:</strong> For now, please book your slot via WhatsApp at ₹0 advance. UPI, Google Pay, Cards, and EMI are accepted directly at the clinic desk.';
          statusBanner.classList.remove('hidden');
        }
      });

      // 9. Form Validation, Local Save & WhatsApp Handoff
      const form = document.getElementById('appointmentForm');
      form?.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameError = document.getElementById('nameError');
        const phoneError = document.getElementById('phoneError');
        const dobError = document.getElementById('dobError');
        const genderError = document.getElementById('genderError');
        const dateError = document.getElementById('dateError');
        const serviceInput = document.getElementById('treatmentService');
        const complaintInput = document.getElementById('chiefComplaint');

        let isValid = true;

        if (!nameInput?.value.trim()) {
          nameError?.classList.remove('hidden');
          nameInput?.classList.add('border-rose-500');
          isValid = false;
        } else {
          nameError?.classList.add('hidden');
          nameInput?.classList.remove('border-rose-500');
        }

        const cleanPhone = (phoneInput?.value || '').replace(/[\s\-+]/g, '');
        const normalizedPhone = cleanPhone.startsWith('91') && cleanPhone.length === 12 ? cleanPhone.slice(2) : cleanPhone;
        if (!/^\d{10}$/.test(normalizedPhone)) {
          phoneError?.classList.remove('hidden');
          phoneInput?.classList.add('border-rose-500');
          isValid = false;
        } else {
          phoneError?.classList.add('hidden');
          phoneInput?.classList.remove('border-rose-500');
        }

        const dobData = computeValidDob();
        if (!dobData) {
          dobError?.classList.remove('hidden');
          isValid = false;
        } else {
          dobError?.classList.add('hidden');
        }

        if (!genderField?.value) {
          genderError?.classList.remove('hidden');
          genderField?.classList.add('border-rose-500');
          isValid = false;
        } else {
          genderError?.classList.add('hidden');
          genderField?.classList.remove('border-rose-500');
        }

        if (!dateInput?.value || dateInput.value < todayStr) {
          dateError?.classList.remove('hidden');
          dateInput?.classList.add('border-rose-500');
          isValid = false;
        } else {
          dateError?.classList.add('hidden');
          dateInput?.classList.remove('border-rose-500');
        }

        if (!isValid || !dobData) return;

        // Save returning-patient contact details locally on device
        try {
          localStorage.setItem(
            STORAGE_KEY,
            JSON.stringify({
              name: nameInput.value.trim(),
              phone: phoneInput.value.trim(),
              email: emailInput?.value.trim() || '',
              gender: genderField.value,
              dobDay: dobDay?.value || '',
              dobMonth: dobMonth?.value || '',
              dobYear: dobYear?.value || '',
            })
          );
        } catch (err) {}

        const name = nameInput.value.trim();
        const phone = phoneInput.value.trim();
        const email = emailInput?.value.trim() || 'Not provided';
        const gender = genderField.value;
        const service = serviceInput?.value || 'General Consultation';
        const date = dateInput.value;
        const slot = timeSlot?.value || '';
        const complaint = complaintInput?.value.trim() || 'None specified';
        const allergies = allergiesInput?.value.trim() || 'Not specified';

        if (window.trackEvent) {
          window.trackEvent('submit_appointment_form', {
            service_requested: service,
            preferred_slot: slot,
            preferred_date: date,
            patient_gender: gender,
            patient_age: dobData.age,
          });
        }

        const lines = [
          'Hello Dr. Riddhi Patel Shah (Infinora Dental Care),',
          'I would like to request an appointment:',
          '',
          `• *Name:* ${name}`,
          `• *Mobile:* ${phone}`,
          `• *Email:* ${email}`,
          `• *Age / DOB:* ${dobData.age} yrs (${dobData.formatted})`,
          `• *Gender:* ${gender}`,
          `• *Consultation:* ${service}`,
          `• *Preferred Date:* ${date}`,
          `• *Preferred Slot:* ${slot}`,
          `• *Complaint / Notes:* ${complaint}`,
          `• *Medical History / Allergies:* ${allergies}`,
        ];

        const waUrl = `https://wa.me/917304432681?text=${encodeURIComponent(lines.join('\n'))}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');

        if (statusBanner) {
          statusBanner.innerHTML =
            '<strong>WhatsApp Opened!</strong> Please tap <em>Send</em> in WhatsApp to dispatch your request. Our clinic desk will confirm your exact slot shortly.';
          statusBanner.classList.remove('hidden');
        }
      });
    });
  </script>
</Layout>
