---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Infinora Dental Care | Dr. Riddhi Patel Shah (MDS Orthodontist) | Multispeciality Clinic Mumbai" 
    description="Premier multispeciality dental clinic in Kandivali West, Mumbai. Every patient is personally evaluated by MDS Orthodontist Dr. Riddhi Patel Shah with on-call MDS specialists for Implants, Root Canals & Surgeries."
>
    <!-- Top Announcement Bar: Pre-Launch, Auto-Translate, Sunday Policy & Contacts -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2 px-3 sm:px-6 border-b border-slate-800 w-full">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">
            
            <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
                <span class="inline-flex items-center gap-1 bg-teal-900 text-teal-300 border border-teal-700/60 px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[9px] sm:text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Grand Opening · September 2026
                </span>
                <span class="text-[11px] sm:text-xs text-slate-300">
                    Shop 5, Sai Elegance, Iraniwadi Rd 3, Kandivali (W)
                </span>
            </div>

            <!-- Automated Language Switcher & Social Links -->
            <div class="flex flex-wrap items-center justify-center gap-2.5 sm:gap-4 text-[11px] sm:text-xs font-semibold">
                
                <!-- Google Auto-Translate Widget Container -->
                <div class="flex items-center gap-1">
                    <span class="text-slate-400 text-[10px]">🌐 Language:</span>
                    <div id="google_translate_element" class="inline-block notranslate"></div>
                </div>

                <span class="text-slate-700 hidden sm:inline">|</span>
                <span class="text-amber-300">⚠️ Sun: 10 AM – 1 PM (Prior Appt Only)</span>
                <span class="text-slate-700 hidden sm:inline">|</span>
                
                <a href="https://instagram.com/orthodontist.riddhi" target="_blank" rel="noopener" class="text-teal-400 hover:text-teal-300 flex items-center gap-1 transition-colors">
                    <span>📸 @orthodontist.riddhi</span>
                </a>
                <span class="text-slate-700 hidden sm:inline">|</span>
                
                <a href="tel:07304432681" class="hover:text-teal-400 transition-colors flex items-center gap-1">
                    <svg class="w-3 h-3 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    073044 32681
                </a>
            </div>

        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-100 shadow-sm w-full">
        <div class="max-w-7xl mx-auto px-3.5 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-2">
            <a href="#" class="flex items-center gap-2.5 min-w-0">
                <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-gradient-to-br from-teal-700 to-teal-900 text-white flex items-center justify-center font-black text-base sm:text-xl shadow-md shrink-0">
                    IDC
                </div>
                <div class="min-w-0">
                    <span class="text-base sm:text-xl font-extrabold tracking-tight text-slate-900 block leading-tight truncate">Infinora Dental Care</span>
                    <span class="text-[9px] sm:text-[11px] font-bold tracking-wider text-teal-700 uppercase block truncate">Dr. Riddhi Patel Shah (MDS)</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-6 text-sm font-semibold text-slate-700">
                <a href="#about" class="hover:text-teal-700 transition-colors">Dr. Riddhi & MDS Model</a>
                <a href="#book" class="text-teal-700 font-bold hover:text-teal-800 transition-colors">Book Visit</a>
                <a href="#aligners" class="hover:text-teal-700 transition-colors">Clear Aligners</a>
                <a href="#catalogue" class="hover:text-teal-700 transition-colors">Treatments</a>
                <a href="#why-us" class="hover:text-teal-700 transition-colors">Hospital Standards</a>
                <a href="#reviews" class="hover:text-teal-700 transition-colors">Reviews & Rating</a>
                <a href="#tourism" class="hover:text-teal-700 transition-colors">Dental Tourism</a>
                <a href="#faq" class="hover:text-teal-700 transition-colors">FAQs</a>
                <a href="#location" class="hover:text-teal-700 transition-colors">Location</a>
            </nav>

            <div class="flex items-center gap-2 shrink-0">
                <a href="#book" class="inline-flex items-center gap-1.5 bg-teal-700 hover:bg-teal-800 text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md transition-all">
                    <span>Book Appointment</span>
                </a>
                <a href="tel:07304432681" class="hidden sm:inline-flex bg-slate-900 hover:bg-slate-800 text-white px-3.5 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all">
                    073044 32681
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Container with Mobile Bottom Clearance -->
    <main class="w-full overflow-hidden pb-24 sm:pb-0">

        <!-- Hero Section -->
        <section class="relative pt-6 pb-12 sm:pt-14 sm:pb-20 overflow-hidden bg-gradient-to-b from-teal-50/70 via-slate-50/30 to-white w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
                
                <div class="lg:col-span-7 space-y-4 sm:space-y-5 text-left min-w-0">
                    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-teal-100/90 border border-teal-200 text-teal-900 text-[11px] sm:text-xs font-bold tracking-wide uppercase max-w-full">
                        <span class="w-2 h-2 rounded-full bg-teal-600 shrink-0"></span> 
                        <span class="truncate">Master of Dental Surgery (MDS) Oversight</span>
                    </div>

                    <h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-950 leading-tight break-words">
                        Precision Braces & Aligners. <br/>
                        <span class="text-teal-700">Comprehensive Dental Excellence.</span>
                    </h1>

                    <p class="text-xs sm:text-base text-slate-600 leading-relaxed max-w-2xl break-words">
                        Welcome to <strong>Infinora Dental Care</strong> in Kandivali West, Mumbai. Every patient is personally evaluated, diagnosed, and treated by Chief Dental Surgeon <strong>Dr. Riddhi Patel Shah (MDS Orthodontist)</strong>. For advanced surgical and restorative needs, our hand-picked panel of on-call MDS specialists are brought in under Dr. Riddhi's direct master supervision.
                    </p>

                    <!-- Launch Privilege Banner -->
                    <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-br from-slate-950 via-teal-950 to-slate-900 text-white shadow-xl border border-teal-700/40 space-y-2">
                        <div class="flex flex-wrap items-center justify-between gap-1.5">
                            <span class="bg-teal-500/20 text-teal-300 text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded border border-teal-500/30">
                                Grand Opening · September 2026
                            </span>
                            <span class="text-[10px] sm:text-xs text-amber-300 font-bold">Inaugural Privilege Pass</span>
                        </div>
                        <div>
                            <h2 class="text-sm sm:text-base font-bold text-white">Join the VIP Pre-Launch Register</h2>
                            <p class="text-[11px] sm:text-xs text-slate-300 leading-relaxed mt-0.5">
                                Pre-register via WhatsApp to claim a <strong>Free Comprehensive Assessment by Dr. Riddhi + 3D Scan + 20% Privilege Discount</strong> on inaugural procedures.
                            </p>
                        </div>
                        <div class="pt-1">
                            <a href="#book" class="inline-flex items-center gap-1 bg-teal-500 hover:bg-teal-400 text-slate-950 px-3.5 py-1.5 rounded-lg font-extrabold text-xs transition-all shadow-md">
                                Reserve Online Slot Now &darr;
                            </a>
                        </div>
                    </div>

                    <!-- Action CTAs -->
                    <div class="flex flex-col sm:flex-row gap-2.5 pt-1">
                        <a href="#book" class="inline-flex items-center justify-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-bold px-5 py-3 rounded-xl shadow-md transition-all text-xs sm:text-base text-center">
                            Book Personal Evaluation with Dr. Riddhi
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <a href="https://instagram.com/orthodontist.riddhi" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-800 font-bold px-5 py-3 rounded-xl shadow-sm transition-all text-xs sm:text-base text-center">
                            📸 Follow Dr. Riddhi on Instagram
                        </a>
                    </div>

                    <!-- Trust Badges -->
                    <div class="pt-2 grid grid-cols-3 gap-2 border-t border-slate-200">
                        <div class="p-2 bg-white rounded-xl border border-slate-100 shadow-sm text-center">
                            <div class="text-sm sm:text-lg font-black text-slate-900">Dr. Riddhi (MDS)</div>
                            <div class="text-[9px] sm:text-xs text-slate-500 font-medium">100% 1st Evaluation</div>
                        </div>
                        <div class="p-2 bg-white rounded-xl border border-slate-100 shadow-sm text-center">
                            <div class="text-sm sm:text-lg font-black text-slate-900">MDS On-Call</div>
                            <div class="text-[9px] sm:text-xs text-slate-500 font-medium">Specialist Network</div>
                        </div>
                        <div class="p-2 bg-white rounded-xl border border-slate-100 shadow-sm text-center">
                            <div class="text-sm sm:text-lg font-black text-slate-900">Class-B</div>
                            <div class="text-[9px] sm:text-xs text-slate-500 font-medium">Hospital Autoclave</div>
                        </div>
                    </div>
                </div>

                <!-- Doctor Profile & Master Clinical Workflow Card -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-white rounded-3xl p-4 sm:p-6 border border-slate-200 shadow-xl space-y-3.5">
                        <div class="flex items-center gap-3 border-b border-slate-100 pb-3.5">
                            <div class="w-12 h-12 rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-700 font-black text-xl shrink-0">
                                👩‍⚕️
                            </div>
                            <div class="min-w-0">
                                <h2 class="font-extrabold text-slate-900 text-base leading-tight truncate">Dr. Riddhi Patel Shah</h2>
                                <p class="text-[11px] text-teal-700 font-bold tracking-wide">MDS – Orthodontics & Dentofacial Orthopedics</p>
                                <p class="text-[10px] text-slate-400 font-medium">Founder & Chief Dental Surgeon</p>
                            </div>
                        </div>

                        <div class="space-y-2 text-xs text-slate-600 leading-relaxed break-words">
                            <p>
                                At <strong>Infinora Dental Care</strong>, you are never handed off to junior practitioners. Dr. Riddhi Patel Shah personally conducts your initial comprehensive evaluation, diagnostic imaging review, and core treatment planning.
                            </p>
                            <p>
                                When specialized interventions are needed, Dr. Riddhi activates our <strong>MDS Specialist On-Call Network</strong>, coordinating directly with visiting Master of Dental Surgery specialists for root canals, complex impactions, or implant surgeries.
                            </p>
                        </div>

                        <div class="bg-slate-50 rounded-2xl p-3 border border-slate-100 space-y-1.5 text-[11px]">
                            <div class="font-bold text-slate-900 text-[10px] uppercase tracking-wider text-teal-800">
                                Master Clinical Care Model
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-slate-700 font-medium">
                                <div>• <strong>Primary Lead:</strong> Dr. Riddhi (MDS)</div>
                                <div>• <strong>Endodontist (MDS):</strong> On-Call for RCT</div>
                                <div>• <strong>Oral Surgeon (MDS):</strong> On-Call for Implants</div>
                                <div>• <strong>Prosthodontist (MDS):</strong> Full Mouth Rehab</div>
                                <div>• <strong>Periodontist (MDS):</strong> Laser Gum Surgery</div>
                                <div>• <strong>Pedodontist (MDS):</strong> Kids Dentistry</div>
                            </div>
                        </div>

                        <div class="pt-1">
                            <a href="#book" class="w-full text-center py-2.5 rounded-xl bg-teal-700 hover:bg-teal-800 text-white text-xs font-bold block transition-colors shadow-md">
                                Schedule Initial Visit with Dr. Riddhi &rarr;
                            </a>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- INTERACTIVE & FOOLPROOF APPOINTMENT BOOKING SECTION -->
        <section id="book" class="py-12 sm:py-16 bg-slate-900 text-white w-full border-t border-slate-800 relative">
            <div class="max-w-4xl mx-auto px-4 sm:px-6">
                
                <div class="text-center space-y-2 mb-8">
                    <span class="text-teal-400 text-[10px] sm:text-xs font-extrabold tracking-widest uppercase bg-teal-950 border border-teal-800 px-3 py-1 rounded-full">
                        Direct Slot Reservation
                    </span>
                    <h2 class="text-xl sm:text-3xl font-extrabold tracking-tight">
                        Book Your Consultation at Infinora Dental Care
                    </h2>
                    <p class="text-slate-300 text-xs sm:text-sm max-w-xl mx-auto">
                        Select your preferred date and slot below to book your appointment with Dr. Riddhi Patel Shah.
                    </p>
                </div>

                <!-- Booking Form Card -->
                <div class="bg-white text-slate-900 rounded-2xl sm:rounded-3xl p-4 sm:p-8 border border-slate-100 shadow-2xl space-y-4">
                    
                    <form id="appointmentForm" class="space-y-3.5" novalidate>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1" for="patientName">
                                    Full Name *
                                </label>
                                <input 
                                    type="text" 
                                    id="patientName" 
                                    required 
                                    placeholder="e.g. Amit Sharma" 
                                    class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all"
                                />
                                <p id="nameError" class="hidden text-[11px] text-rose-600 font-semibold mt-1">Please enter your full name.</p>
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1" for="patientPhone">
                                    Mobile Number *
                                </label>
                                <input 
                                    type="tel" 
                                    id="patientPhone" 
                                    required 
                                    maxlength="15"
                                    placeholder="e.g. 9820000000" 
                                    class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all"
                                />
                                <p id="phoneError" class="hidden text-[11px] text-rose-600 font-semibold mt-1">Please enter a valid mobile number.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1" for="treatmentService">
                                    Treatment / Consultation *
                                </label>
                                <select 
                                    id="treatmentService" 
                                    required 
                                    class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all bg-white"
                                >
                                    <option value="Initial Consultation with Dr. Riddhi (MDS)">Initial Consultation with Dr. Riddhi (MDS)</option>
                                    <option value="Clear Aligners & Braces (MDS Orthodontist)">Invisible Clear Aligners / Braces</option>
                                    <option value="Single-Visit Root Canal Treatment">Single-Visit Painless Root Canal (RCT)</option>
                                    <option value="Dental Implants & Fixed Teeth">Dental Implants / All-on-4/6</option>
                                    <option value="Smile Makeover & Porcelain Veneers">Cosmetic Smile Makeover & Veneers</option>
                                    <option value="Wisdom Tooth Extraction">Wisdom Tooth & Oral Surgery</option>
                                    <option value="Teeth Cleaning & Deep Scaling">Ultrasonic Cleaning & Gum Care</option>
                                    <option value="Kids Dental Consultation">Pediatric / Child Dental Care</option>
                                    <option value="Dental Tourism & NRI Fast-Track">Dental Tourism / NRI Treatment Plan</option>
                                </select>
                            </div>

                            <div>
                                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1" for="appointmentDate">
                                    Preferred Date *
                                </label>
                                <input 
                                    type="date" 
                                    id="appointmentDate" 
                                    required 
                                    class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all bg-white"
                                />
                                <p id="dateError" class="hidden text-[11px] text-rose-600 font-semibold mt-1">Please select an upcoming date.</p>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1" for="timeSlot">
                                Available Time Slot *
                            </label>
                            <select 
                                id="timeSlot" 
                                required 
                                class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-teal-600 focus:border-transparent text-sm text-slate-900 outline-none transition-all bg-white"
                            >
                                <option value="Morning Session (10:00 AM – 1:30 PM)">Morning Session (10:00 AM – 1:30 PM)</option>
                                <option value="Evening Session (5:00 PM – 9:00 PM)">Evening Session (5:00 PM – 9:00 PM)</option>
                            </select>
                        </div>

                        <!-- Dynamic Sunday Notice -->
                        <div id="sundayAlertBox" class="hidden p-3 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs leading-relaxed flex items-start gap-2">
                            <span class="text-sm shrink-0">⚠️</span>
                            <div>
                                <strong>Sunday Notice:</strong> You have selected a Sunday. Timings are strictly <strong>10:00 AM – 1:00 PM by prior appointment only</strong>. No walk-ins permitted on Sundays.
                            </div>
                        </div>

                        <button 
                            type="submit" 
                            class="w-full flex items-center justify-center gap-2 bg-teal-700 hover:bg-teal-800 text-white font-extrabold py-3.5 px-5 rounded-xl shadow-lg transition-all text-xs sm:text-base cursor-pointer"
                        >
                            <span>Confirm & Dispatch Booking via WhatsApp</span>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </button>

                    </form>

                    <div class="text-center pt-2 border-t border-slate-100">
                        <p class="text-[11px] sm:text-xs text-slate-500">
                            Prefer to call directly? Speak with reception at <a href="tel:07304432681" class="text-teal-700 font-bold hover:underline">073044 32681</a>
                        </p>
                    </div>

                </div>

            </div>
        </section>

        <!-- Script for Foolproof Date and Form Logic -->
        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const dateInput = document.getElementById('appointmentDate');
                const timeSlot = document.getElementById('timeSlot');
                const sundayAlert = document.getElementById('sundayAlertBox');
                const form = document.getElementById('appointmentForm');

                // Lock past dates
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const todayStr = `${year}-${month}-${day}`;
                
                if (dateInput) {
                    dateInput.min = todayStr;
                    
                    const maxDate = new Date();
                    maxDate.setDate(maxDate.getDate() + 90);
                    const maxYear = maxDate.getFullYear();
                    const maxMonth = String(maxDate.getMonth() + 1).padStart(2, '0');
                    const maxDay = String(maxDate.getDate()).padStart(2, '0');
                    dateInput.max = `${maxYear}-${maxMonth}-${maxDay}`;

                    dateInput.value = todayStr;
                    updateTimeSlotsForDate(todayStr);

                    dateInput.addEventListener('change', (e) => {
                        updateTimeSlotsForDate(e.target.value);
                    });
                }

                function updateTimeSlotsForDate(dateString) {
                    if (!dateString) return;
                    const parts = dateString.split('-');
                    const selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
                    const dayOfWeek = selectedDate.getDay();

                    if (dayOfWeek === 0) {
                        timeSlot.innerHTML = `
                            <option value="Sunday Slot (10:00 AM – 1:00 PM · Strictly Prior Appt Only)">
                                Sunday Slot: 10:00 AM – 1:00 PM (Strictly Prior Appointment Only)
                            </option>
                        `;
                        sundayAlert.classList.remove('hidden');
                    } else {
                        timeSlot.innerHTML = `
                            <option value="Morning Session (10:00 AM – 1:30 PM)">Morning Session (10:00 AM – 1:30 PM)</option>
                            <option value="Evening Session (5:00 PM – 9:00 PM)">Evening Session (5:00 PM – 9:00 PM)</option>
                        `;
                        sundayAlert.classList.add('hidden');
                    }
                }

                if (form) {
                    form.addEventListener('submit', (e) => {
                        e.preventDefault();

                        const nameInput = document.getElementById('patientName');
                        const phoneInput = document.getElementById('patientPhone');
                        const serviceInput = document.getElementById('treatmentService');
                        
                        const nameError = document.getElementById('nameError');
                        const phoneError = document.getElementById('phoneError');
                        const dateError = document.getElementById('dateError');

                        let isValid = true;

                        if (!nameInput.value.trim()) {
                            nameError.classList.remove('hidden');
                            nameInput.classList.add('border-rose-500');
                            isValid = false;
                        } else {
                            nameError.classList.add('hidden');
                            nameInput.classList.remove('border-rose-500');
                        }

                        const cleanPhone = phoneInput.value.replace(/[\s\-\+]/g, '');
                        if (!cleanPhone || cleanPhone.length < 8 || isNaN(cleanPhone)) {
                            phoneError.classList.remove('hidden');
                            phoneInput.classList.add('border-rose-500');
                            isValid = false;
                        } else {
                            phoneError.classList.add('hidden');
                            phoneInput.classList.remove('border-rose-500');
                        }

                        if (!dateInput.value || dateInput.value < todayStr) {
                            dateError.classList.remove('hidden');
                            dateInput.classList.add('border-rose-500');
                            isValid = false;
                        } else {
                            dateError.classList.add('hidden');
                            dateInput.classList.remove('border-rose-500');
                        }

                        if (!isValid) return;

                        const name = nameInput.value.trim();
                        const phone = phoneInput.value.trim();
                        const service = serviceInput.value;
                        const date = dateInput.value;
                        const slot = timeSlot.value;

