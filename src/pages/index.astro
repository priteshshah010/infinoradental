    description="Premier multispeciality dental clinic in Kandivali West, Mumbai. General Checkup, Fixing Smile Design, Clear Aligners, Dental Implants, Root Canal, and In-Clinic / Teleconsultation Care[cite: 1]."
>
    <!-- Top Announcement Bar -->
    <div class="bg-slate-950 text-slate-200 text-xs py-2 px-4 sm:px-6 border-b border-slate-800 w-full">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
            
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 bg-teal-900 text-teal-300 border border-teal-700/60 px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Grand Opening · September 2026[cite: 1]
