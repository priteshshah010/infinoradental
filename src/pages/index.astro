    <!-- Comprehensive Interaction Script (Date Constraints, Pre-Selection, Sunday Checks & WhatsApp Generation) -->
    <script is:inline>
        window.selectService = function(keyword) {
            const select = document.getElementById('treatmentService');
            if (select) {
                for (let opt of select.options) {
                    if (opt.value.toLowerCase().includes(keyword.toLowerCase()) || opt.text.toLowerCase().includes(keyword.toLowerCase())) {
                        select.value = opt.value;
                        break;
                    }
                }
            }
            const bookSection = document.getElementById('book');
            if (bookSection) {
                bookSection.scrollIntoView({ behavior: 'smooth' });
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('appointmentDate');
            const dobInput = document.getElementById('patientDob');
            const timeSlot = document.getElementById('timeSlot');
            const sundayAlert = document.getElementById('sundayAlertBox');
            const form = document.getElementById('appointmentForm');

            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const todayStr = `${year}-${month}-${day}`;
            
            if (dateInput) {
                dateInput.min = todayStr;
                
                const maxDate = new Date();
                maxDate.setDate(maxDate.getDate() + 90);
                const maxYear = maxDate.getFullYear();
                const maxMonth = String(maxDate.getMonth() + 1).padStart(2, '0');
                const maxDay = String(maxDate.getDate()).padStart(2, '0');
                dateInput.max = `${maxYear}-${maxMonth}-${maxDay}`;

                dateInput.value = todayStr;
                checkSundaySchedule(todayStr);

                dateInput.addEventListener('change', (e) => {
                    checkSundaySchedule(e.target.value);
                });
            }

            if (dobInput) {
                dobInput.max = todayStr;
            }

            function checkSundaySchedule(dateString) {
                if (!dateString) return;
                const parts = dateString.split('-');
                const selectedDate = new Date(parts[0], parts[1] - 1, parts[2]);
                const dayOfWeek = selectedDate.getDay();

                if (dayOfWeek === 0) {
                    sundayAlert.classList.remove('hidden');
                } else {
                    sundayAlert.classList.add('hidden');
                }
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    const nameInput = document.getElementById('patientName');
                    const phoneInput = document.getElementById('patientPhone');
                    const dobField = document.getElementById('patientDob');
                    const genderField = document.getElementById('patientGender');
                    const serviceInput = document.getElementById('treatmentService');
                    
                    const nameError = document.getElementById('nameError');
                    const phoneError = document.getElementById('phoneError');
                    const dobError = document.getElementById('dobError');
                    const genderError = document.getElementById('genderError');
                    const dateError = document.getElementById('dateError');

                    let isValid = true;

                    if (!nameInput.value.trim()) {
                        nameError.classList.remove('hidden');
                        nameInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        nameError.classList.add('hidden');
                        nameInput.classList.remove('border-rose-600');
                    }

                    const cleanPhone = phoneInput.value.replace(/[\s\-\+]/g, '');
                    if (!cleanPhone || cleanPhone.length < 8 || isNaN(cleanPhone)) {
                        phoneError.classList.remove('hidden');
                        phoneInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        phoneError.classList.add('hidden');
                        phoneInput.classList.remove('border-rose-600');
                    }

                    if (!dobField.value) {
                        dobError.classList.remove('hidden');
                        dobField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dobError.classList.add('hidden');
                        dobField.classList.remove('border-rose-600');
                    }

                    if (!genderField.value) {
                        genderError.classList.remove('hidden');
                        genderField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        genderError.classList.add('hidden');
                        genderField.classList.remove('border-rose-600');
                    }

                    if (!dateInput.value || dateInput.value < todayStr) {
                        dateError.classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dateError.classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }

                    if (!isValid) return;

                    const name = nameInput.value.trim();
                    const phone = phoneInput.value.trim();
                    const dob = dobField.value;
                    const gender = genderField.value;
                    const service = serviceInput.value;
                    const date = dateInput.value;
                    const slot = timeSlot.value;

                    const dobDate = new Date(dob);
                    const todayDate = new Date();
                    let calculatedAge = todayDate.getFullYear() - dobDate.getFullYear();
                    const monthDiff = todayDate.getMonth() - dobDate.getMonth();
                    if (monthDiff < 0 || (monthDiff === 0 && todayDate.getDate() < dobDate.getDate())) {
                        calculatedAge--;
                    }

                    if (window.trackEvent) {
                        window.trackEvent('submit_appointment_form', {
                            service_requested: service,
                            preferred_slot: slot,
                            preferred_date: date,
                            patient_gender: gender,
                            patient_age: calculatedAge
                        });
                    }

                    const message = `Hello Dr. Riddhi Patel Shah (Infinora Dental Care),%0A%0AI would like to request an in-clinic consultation.%0A%0A📋 *Patient Information:*%0A• Name: ${encodeURIComponent(name)}%0A• Mobile: ${encodeURIComponent(phone)}%0A• Age: ${encodeURIComponent(calculatedAge + ' years')} (DOB: ${encodeURIComponent(dob)})%0A• Gender: ${encodeURIComponent(gender)}%0A• Service: ${encodeURIComponent(service)}%0A• Preferred Date: ${encodeURIComponent(date)}%0A• Preferred Slot: ${encodeURIComponent(slot)}%0A%0APlease verify clinic availability and confirm my visit. Thank you!`;

                    window.open(`https://wa.me/917304432681?text=${message}`, '_blank');
                });
            }
        });
    </script>
