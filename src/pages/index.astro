                >
                    💳 Pay Online
                </button>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <button type="button" onclick="downloadVCard()" class="text-brand-surface hover:text-white flex items-center gap-1 transition-colors cursor-pointer" title="Save Infinora Dental Care to Contacts">
