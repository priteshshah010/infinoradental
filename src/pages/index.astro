                    <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-slate-300 hover:text-white transition-colors">
                        ગુજ
                    </button>
                    <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-slate-300 hover:text-white transition-colors">
                        हि
