                                Verify MSDC →
                            </a>
                            <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-teal-700 hover:text-teal-800 font-extrabold text-xs inline-flex items-center gap-1">
                                Check IDA Profile →
                            </a>
                        </div>
                    </div>

                    <!-- ABDM Digital Facility (NHA) -->
                    <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-teal-300 transition-all space-y-3 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
