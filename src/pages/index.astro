            <div class="lg:col-span-7 space-y-5 text-left min-w-0">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-100/90 border border-teal-200 text-teal-900 text-xs font-bold tracking-wide uppercase max-w-full">
                    <span class="w-2 h-2 rounded-full bg-teal-600 shrink-0"></span> 
                    <span class="truncate">MDS Specialist-Led Multispeciality Hospital</span>
                </div>

