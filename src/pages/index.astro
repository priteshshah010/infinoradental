    description="Family dentistry, braces, clear aligners, dental implants, full-mouth rehabilitation, and root canals in Kandivali West, Mumbai with Dr. Riddhi Patel Shah (MDS Orthodontics, Gold Medalist)."
    canonicalUrl="https://infinoradental.com/"
>
    <!-- Top Utility Bar (Includes Post-Treatment Online Payment Placeholder) -->
    <div class="bg-brand-darknavy text-brand-surface text-xs py-2 px-3 sm:px-6 border-b border-brand-midnavy w-full">
