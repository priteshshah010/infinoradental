---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Infinora Dental Care | Dr. Riddhi Patel Shah (MDS) | Kandivali West, Mumbai"
  description="Specialist-led dentistry thoughtfully delivered in Kandivali West, Mumbai. Precision braces, clear aligners, dental implants, painless root canals, and family dentistry by Dr. Riddhi Patel Shah (BDS University Gold Medalist, MDS Orthodontics)."
>
  <!-- 1. UTILITY TOP BAR (Normal flow — scrolls away naturally) -->
  <div class="bg-brand-navy text-slate-200 text-xs border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2 sm:gap-3 min-w-0">
        <span class="inline-flex items-center gap-1.5 font-semibold text-white truncate">
          <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0" aria-hidden="true"></span>
          <span>Kandivali West, Mumbai · Specialist Orthodontics &amp; Family Dentistry</span>
        </span>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-4 shrink-0">
        <!-- Language Switcher -->
        <div class="flex items-center bg-white/10 rounded-lg p-0.5 text-[11px] font-bold" role="group" aria-label="Language Switcher">
          <button type="button" onclick="changeLanguage('en')" data-lang="en" class="lang-btn bg-brand-navy text-white px-2 py-0.5 rounded-md transition-colors cursor-pointer">EN</button>
          <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn text-slate-300 hover:text-white px-2 py-0.5 rounded-md transition-colors cursor-pointer">ગુજ</button>
          <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn text-slate-300 hover:text-white px-2 py-0.5 rounded-md transition-colors cursor-pointer">हि</button>
          <button type="button" onclick="changeLanguage('mr')" data-lang="mr" class="lang-btn text-slate-300 hover:text-white px-2 py-0.5 rounded-md transition-colors cursor-pointer">मरा</button>
        </div>

        <button type="button" onclick="downloadVCard()" class="hidden md:inline-flex items-center gap-1 hover:text-brand-gold transition-colors font-semibold cursor-pointer">
          <span>📇 Save Contact</span>
        </button>

        <a
          href="https://g.page/r/Cb7r3l0-R2oSEBM/review"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1 text-brand-gold hover:underline font-semibold"
        >
          <span>★ Google Review Link</span>
        </a>

        <a href="tel:+917304432681" class="inline-flex items-center gap-1 font-bold text-white hover:text-brand-gold transition-colors">
          <span>📞 +91 73044 32681</span>
        </a>
      </div>
    </div>
  </div>

  <!-- 2. STICKY MAIN HEADER (Independent CSS-first sticky) -->
  <header class="sticky top-0 z-[1000] bg-white/95 backdrop-blur-md border-b border-brand-border shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-4">
      <!-- Brand Identity (Never shrinks) -->
      <a
        href="#top"
        class="scroll-top-link flex items-center gap-3 shrink-0 group focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-navy rounded-xl"
        aria-label="Infinora Dental Care Home"
      >
        <img
          src="/logo.svg"
          alt="Infinora Dental Care Logo"
          width="48"
          height="48"
          class="w-11 h-11 sm:w-12 sm:h-12 object-contain shrink-0"
        />
        <div class="leading-none whitespace-nowrap">
          <span class="block font-serif font-bold tracking-[0.14em] text-brand-navy text-lg sm:text-xl">
            INFINORA
          </span>
          <span class="block text-[10px] sm:text-[11px] font-extrabold tracking-[0.24em] uppercase text-brand-teal mt-1">
            DENTAL CARE
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav aria-label="Primary Navigation" class="hidden lg:flex items-center gap-5 xl:gap-6 text-sm font-semibold text-brand-grey-text min-w-0">
        <a href="#about" class="hover:text-brand-navy transition-colors whitespace-nowrap">Doctor</a>
        <a href="#standards" class="hover:text-brand-navy transition-colors whitespace-nowrap">Standards</a>
        <a href="#catalogue" class="hover:text-brand-navy transition-colors whitespace-nowrap">Treatments</a>
        <a href="#credentials" class="hover:text-brand-navy transition-colors whitespace-nowrap">Credentials</a>
        <a href="#facilities" class="hover:text-brand-navy transition-colors whitespace-nowrap">Facilities</a>
        <a href="#faq" class="hover:text-brand-navy transition-colors whitespace-nowrap">FAQs</a>
        <a href="#location" class="hover:text-brand-navy transition-colors whitespace-nowrap">Location</a>
      </nav>

      <!-- Desktop CTAs + Mobile Controls -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <a
          href="https://maps.app.goo.gl/3sKwKPjG43PNeN6y7"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden xl:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl border border-brand-border text-xs font-bold text-brand-navy hover:bg-brand-cardbg transition-colors whitespace-nowrap"
        >
          <span>📍 Directions</span>
        </a>

        <a
          href="https://infinoradental.com/#book"
          onclick="event.preventDefault(); document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });"
          class="inline-flex items-center justify-center bg-brand-navy hover:bg-brand-navy-light text-white text-xs sm:text-sm font-bold px-3.5 sm:px-5 py-2.5 rounded-xl transition-colors shadow-sm whitespace-nowrap"
        >
          Book Visit
        </a>

        <!-- Mobile Hamburger Button -->
        <button
          type="button"
          id="mobileMenuBtn"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobileNavDrawer"
          class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-xl border border-brand-border text-brand-navy hover:bg-brand-cardbg transition-colors cursor-pointer"
        >
          <svg id="menuIconOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menuIconClose" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Full-Screen Navigation Drawer -->
  <div
    id="mobileNavDrawer"
    class="fixed inset-0 z-[1100] hidden bg-white flex flex-col justify-between p-6 overflow-y-auto"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
  >
    <div>
      <div class="flex items-center justify-between pb-5 border-b border-brand-border">
        <div class="flex items-center gap-2.5">
          <img src="/logo.svg" alt="Infinora Dental Care" width="40" height="40" class="w-10 h-10 object-contain" />
          <div class="leading-none">
            <span class="block font-serif font-bold tracking-[0.14em] text-brand-navy text-base">INFINORA</span>
            <span class="block text-[10px] font-extrabold tracking-[0.22em] uppercase text-brand-teal mt-0.5">DENTAL CARE</span>
          </div>
        </div>
        <button
          type="button"
          id="mobileMenuCloseBtn"
          aria-label="Close navigation menu"
          class="w-11 h-11 inline-flex items-center justify-center rounded-xl border border-brand-border text-brand-navy cursor-pointer"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="mt-6 flex flex-col gap-2 text-base font-bold text-brand-navy">
        <a href="#about" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Meet Dr. Riddhi Patel Shah</a>
        <a href="#offers" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Current Month Offers</a>
        <a href="#standards" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">The Infinora Standard</a>
        <a href="#catalogue" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Clinical Treatments</a>
        <a href="#credentials" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Statutory Credentials</a>
        <a href="#facilities" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Clinic Facilities</a>
        <a href="#reviews" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Reviews Section</a>
        <a href="#community" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">School &amp; Corporate Camps</a>
        <a href="#faq" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Patient FAQs</a>
        <a href="#location" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg">Location &amp; How to Reach</a>
        <a href="/privacy-policy" class="mobile-nav-link py-3 px-4 rounded-xl hover:bg-brand-cardbg text-brand-grey-muted">Privacy Policy</a>
      </nav>
    </div>

    <div class="pt-6 border-t border-brand-border space-y-3">
      <a
        href="#book"
        class="mobile-nav-link w-full inline-flex items-center justify-center bg-brand-navy text-white font-bold py-3.5 px-5 rounded-xl"
      >
        📅 Book Appointment
      </a>
      <div class="grid grid-cols-2 gap-3">
        <a href="tel:+917304432681" class="inline-flex items-center justify-center border border-brand-border text-brand-navy font-bold py-3 rounded-xl text-sm">
          📞 Call Clinic
        </a>
        <a
          href="https://wa.me/917304432681?text=Hello%20Dr.%20Riddhi%20Patel%20Shah,%20I%20would%20like%20to%20book%20a%20consultation%20at%20Infinora%20Dental%20Care."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center bg-brand-teal text-white font-bold py-3 rounded-xl text-sm"
        >
          💬 WhatsApp
        </a>
      </div>
    </div>
  </div>

  <main id="top" class="pb-20 lg:pb-0">
    <!-- 3. HERO SECTION -->
    <section class="bg-gradient-to-b from-slate-50 via-white to-white border-b border-brand-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex flex-wrap items-center gap-2 bg-brand-cardbg border border-brand-border rounded-full px-3.5 py-1.5 text-xs font-bold text-brand-navy">
            <span class="text-brand-gold-dark">★</span>
            <span>MSDC Registered (A-45674) · ABDM Verified Practice · Kandivali West</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-brand-navy leading-[1.15]">
            Specialist-Led Dentistry, <span class="text-brand-teal">Thoughtfully Delivered</span> for Every Generation.
          </h1>

          <p class="text-base sm:text-lg text-brand-grey-text leading-relaxed max-w-2xl">
            From precision <strong>Braces &amp; Clear Aligners</strong> to <strong>Dental Implants, Gentle Root Canals, and Family Dentistry</strong>—led by <strong>Dr. Riddhi Patel Shah</strong> (BDS University Gold Medalist, MDS Orthodontics) at Sai Elegance, Iraniwadi Road No. 3, Kandivali West.
          </p>

          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="https://infinoradental.com/#book"
              onclick="event.preventDefault(); document.getElementById('book')?.scrollIntoView({ behavior: 'smooth' });"
              class="inline-flex items-center justify-center gap-2 bg-brand-navy hover:bg-brand-navy-light text-white font-extrabold px-6 py-3.5 rounded-xl shadow-md transition-all text-sm sm:text-base"
            >
              <span>📅 Book Consultation</span>
            </a>
            <a
              href="tel:+917304432681"
              class="inline-flex items-center justify-center gap-2 bg-white hover:bg-brand-cardbg text-brand-navy border border-brand-border font-bold px-5 py-3.5 rounded-xl transition-all text-sm sm:text-base"
            >
              <span>📞 +91 73044 32681</span>
            </a>
            <a
              href="https://wa.me/917304432681?text=Hello%20Dr.%20Riddhi%20Patel%20Shah,%20I%20would%20like%20to%20consult%20at%20Infinora%20Dental%20Care."
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-brand-teal hover:bg-brand-teal-dark text-white font-bold px-5 py-3.5 rounded-xl transition-all text-sm sm:text-base"
            >
              <span>💬 WhatsApp</span>
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-4 border-t border-brand-border text-xs sm:text-sm">
            <div>
              <span class="block font-extrabold text-brand-navy">Mon – Sat Shifts</span>
              <span class="text-brand-grey-muted">10 AM – 2 PM · 5 PM – 9 PM</span>
            </div>
            <div>
              <span class="block font-extrabold text-brand-navy">Sunday Care</span>
              <span class="text-brand-grey-muted">10 AM – 1 PM (Prior Appt)</span>
            </div>
            <div class="col-span-2 sm:col-span-1">
              <span class="block font-extrabold text-brand-navy">Transparent Care</span>
              <span class="text-brand-grey-muted">Written Plans · UPI / Cards / EMI</span>
            </div>
          </div>
        </div>

        <!-- Lead Specialist Profile Card -->
        <div class="lg:col-span-5">
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-brand-border shadow-lg space-y-5">
            <div class="flex items-center gap-4">
              <div class="w-24 h-24 rounded-2xl overflow-hidden shrink-0 ring-2 ring-brand-navy/15 bg-slate-100 shadow-sm">
                <picture class="w-full h-full block">
                  <source srcset="/images/riddhi_headshot.avif" type="image/avif" />
                  <source srcset="/images/riddhi_headshot.webp" type="image/webp" />
                  <img
                    src="/images/riddhi_headshot.webp"
                    alt="Dr. Riddhi Patel Shah at Infinora Dental Care, Kandivali West"
                    width="96"
                    height="96"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full h-full object-cover object-top contrast-[1.02] saturate-[1.02]"
                  />
                </picture>
              </div>
              <div class="min-w-0">
                <span class="inline-block text-[11px] font-extrabold uppercase tracking-wider text-brand-teal">Chief Orthodontist &amp; Founder</span>
                <h2 class="text-xl font-extrabold text-brand-navy leading-snug">Dr. Riddhi Patel Shah</h2>
                <p class="text-xs sm:text-sm text-brand-grey-muted font-medium">
                  BDS (University Gold Medalist) · MDS (Orthodontics &amp; Dentofacial Orthopedics)
                </p>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2.5 text-xs">
              <div class="bg-brand-cardbg rounded-xl p-3 border border-brand-border">
                <span class="block text-brand-grey-muted font-semibold">MSDC Reg.</span>
                <span class="font-mono font-extrabold text-brand-navy">A-45674</span>
              </div>
              <div class="bg-brand-cardbg rounded-xl p-3 border border-brand-border">
                <span class="block text-brand-grey-muted font-semibold">Memberships</span>
                <span class="font-extrabold text-brand-navy">IOS &amp; IDA</span>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-brand-grey-text leading-relaxed">
              Every orthodontic and multispeciality treatment plan is personally supervised for clinical accuracy, comfort, and long-term dental health—for kids, teens, adults, and seniors alike.
            </p>

            <div class="flex items-center justify-between pt-3 border-t border-brand-border text-xs font-bold">
              <a href="#about" class="text-brand-navy hover:text-brand-teal transition-colors">Explore Clinic &amp; Profile →</a>
              <a
                href="https://instagram.com/orthodontist.riddhi"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-teal hover:underline"
              >
                @orthodontist.riddhi
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CURRENT MONTH OFFERS -->
    <section id="offers" class="bg-brand-navy text-white py-10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-1.5">
            <span class="inline-block text-[11px] font-extrabold uppercase tracking-[0.2em] text-brand-gold">
              Current Month Welcome Offers
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold">Start With Clear, Unhurried Guidance</h2>
            <p class="text-sm text-slate-300">Book online and mention the offer at reception. Clinical terms apply.</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 w-full md:w-auto">
            <button
              type="button"
              onclick="selectService('Free Dental Checkup')"
              class="text-left bg-white/10 hover:bg-white/15 border border-white/15 rounded-2xl p-4 transition-all cursor-pointer"
            >
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-gold">Welcome Checkup</span>
              <span class="block text-lg font-extrabold text-white mt-0.5">Free Dental Checkup*</span>
              <span class="block text-xs text-slate-300 mt-1">Comprehensive oral screening &amp; treatment discussion →</span>
            </button>

            <button
              type="button"
              onclick="selectService('Teeth Cleaning')"
              class="text-left bg-white/10 hover:bg-white/15 border border-white/15 rounded-2xl p-4 transition-all cursor-pointer"
            >
              <span class="block text-xs font-bold uppercase tracking-wider text-brand-gold">Preventive Care</span>
              <span class="block text-lg font-extrabold text-white mt-0.5">Teeth Cleaning @ ₹999*</span>
              <span class="block text-xs text-slate-300 mt-1">Ultrasonic scaling &amp; polishing session →</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. ABOUT DOCTOR & UNIFIED CLINIC PHOTO GALLERY -->
    <section id="about" class="scroll-mt-24 py-14 sm:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-10">
        <div class="max-w-3xl space-y-3">
          <span class="text-xs font-extrabold uppercase tracking-[0.2em] text-brand-teal">Meet Your Specialist &amp; Space</span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy">Inside Infinora Dental Care, Kandivali West</h2>
          <p class="text-sm sm:text-base text-brand-grey-text leading-relaxed">
            Designed to feel calm, transparent, and welcoming from the moment you step in. Led by <strong>Dr. Riddhi Patel Shah</strong> alongside visiting MDS specialists for endodontics, implants, oral surgery, and pediatric dentistry.
          </p>
        </div>

        <!-- Uniform 4-Card Gallery: Identical Matte Framing, Subtle Editorial Tone, Zero Cropping of Signboard/Trophies -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Card 1: Dr. Riddhi Desk + Trophies (Soft ambient backdrop + crisp uncropped foreground) -->
          <figure class="group rounded-3xl overflow-hidden border border-brand-border bg-white shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="p-2.5 bg-gradient-to-b from-slate-100 to-slate-50 border-b border-brand-border/70">
              <div class="relative aspect-[4/3] w-full rounded-2xl overflow-hidden ring-1 ring-slate-200/80 bg-slate-100">
                <!-- Soft ambient fill prevents raw letterboxing bars -->
                <img
                  src="/images/dr-riddhi.webp"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl opacity-35 pointer-events-none"
                />
                <picture class="relative z-10 w-full h-full block">
                  <source srcset="/images/dr-riddhi.avif" type="image/avif" />
                  <source srcset="/images/dr-riddhi.webp" type="image/webp" />
                  <img
                    src="/images/dr-riddhi.webp"
                    alt="Dr. Riddhi Patel Shah seated at her consultation desk with trophies and academic recognition at Infinora Dental Care"
                    width="640"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain contrast-[1.03] saturate-[1.02] transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </picture>
              </div>
            </div>
            <figcaption class="p-4 text-xs text-brand-grey-text leading-relaxed flex-1">
              <strong class="block text-brand-navy font-bold text-sm mb-1">Academic Rigor Meets Everyday Care</strong>
              Dr. Riddhi Patel Shah at her consultation desk, celebrating milestones shaped by dedication and patient trust.
            </figcaption>
          </figure>

          <!-- Card 2: Clinic Signboard / Shopfront (Soft ambient backdrop + crisp uncropped foreground) -->
          <figure class="group rounded-3xl overflow-hidden border border-brand-border bg-white shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="p-2.5 bg-gradient-to-b from-slate-100 to-slate-50 border-b border-brand-border/70">
              <div class="relative aspect-[4/3] w-full rounded-2xl overflow-hidden ring-1 ring-slate-200/80 bg-slate-100">
                <img
                  src="/images/clinic_shopfront.webp"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  class="absolute inset-0 w-full h-full object-cover scale-110 blur-xl opacity-35 pointer-events-none"
                />
                <picture class="relative z-10 w-full h-full block">
                  <source srcset="/images/clinic_shopfront.avif" type="image/avif" />
                  <source srcset="/images/clinic_shopfront.webp" type="image/webp" />
                  <img
                    src="/images/clinic_shopfront.webp"
                    alt="Signboard and entrance of Infinora Dental Care at Sai Elegance, Iraniwadi Road No. 3, Kandivali West"
                    width="640"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-contain contrast-[1.03] saturate-[1.02] transition-transform duration-500 group-hover:scale-[1.02]"
                  />
                </picture>
              </div>
            </div>
            <figcaption class="p-4 text-xs text-brand-grey-text leading-relaxed flex-1">
              <strong class="block text-brand-navy font-bold text-sm mb-1">Easy to Spot, Easy to Reach</strong>
              Infinora Dental Care at Sai Elegance, Iraniwadi Road No. 3, Kandivali West—ground-floor accessible entrance.
            </figcaption>
          </figure>

          <!-- Card 3: Clinical Treatment Operatory (Identical matte frame) -->
          <figure class="group rounded-3xl overflow-hidden border border-brand-border bg-white shadow-sm hover:shadow-md transition-shadow flex flex-col">
            <div class="p-2.5 bg-gradient-to-b from-slate-100 to-slate-50 border-b border-brand-border/70">
              <div class="relative aspect-[4/3] w-full rounded-2xl overflow-hidden ring-1 ring-slate-200/80 bg-slate-100">
                <picture class="w-full h-full block">
                  <source srcset="/images/clinic-operatory.avif" type="image/avif" />
                  <source srcset="/images/clinic-operatory.webp" type="image/webp" />
                  <img
                    src="/images/clinic-operatory.webp"
