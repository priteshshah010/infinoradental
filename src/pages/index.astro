                    </div>
                </div>

                <!-- Doctor Profile Card -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-white rounded-3xl p-5 sm:p-8 border border-slate-200 shadow-xl space-y-4">
