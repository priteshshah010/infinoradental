---
import Layout from '../layouts/Layout.astro';
---

<Layout
    title="Infinora Dental Care | Dentist in Kandivali & Mumbai | Braces, Aligners, Implants, Veneers & Root Canal"
    description="Looking for a dentist near me or dentist in Kandivali and Mumbai? Infinora Dental Care offers orthodontist care, braces, clear aligners, Invisalign, invisible aligners, implants, veneers, root canals, and family dental treatments across India with Dr. Riddhi Patel Shah (MDS)."
    canonicalUrl="https://infinoradental.com/"
>
    <!-- Top Utility Bar -->
    <div class="bg-brand-darknavy text-brand-surface text-xs py-2 px-3 sm:px-6 border-b border-brand-midnavy w-full">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2 text-center md:text-left">

            <div class="flex items-center justify-center md:justify-start gap-2 flex-wrap">
                <span class="inline-flex items-center gap-1.5 bg-brand-navy text-white border border-brand-lightnavy px-2.5 py-0.5 rounded-full font-extrabold uppercase tracking-wider text-[10px] whitespace-normal break-words">
                    <span class="w-1.5 h-1.5 rounded-full bg-brand-gold shrink-0"></span>
                    Infinora Dental Care · Kandivali West, Mumbai
                </span>
                <a href="#offers" class="text-brand-gold hover:underline font-semibold text-xs whitespace-normal break-words">
                    Current Month Offers: Free Dental Checkup · Teeth Cleaning @ Rs 999*
                </a>
            </div>

            <div class="flex items-center justify-center gap-2 sm:gap-3 text-xs font-semibold flex-wrap">
                <!-- Multi-Language Switcher -->
                <div class="flex items-center gap-1 bg-brand-midnavy border border-brand-lightnavy px-1.5 py-0.5 rounded-lg notranslate">
                    <button type="button" onclick="changeLanguage('en')" data-lang="en" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold bg-brand-navy text-white transition-colors cursor-pointer">
                        EN
                    </button>
                    <button type="button" onclick="changeLanguage('gu')" data-lang="gu" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors cursor-pointer">
                        ગુજ
                    </button>
                    <button type="button" onclick="changeLanguage('hi')" data-lang="hi" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors cursor-pointer">
                        हि
                    </button>
                    <button type="button" onclick="changeLanguage('mr')" data-lang="mr" class="lang-btn px-2 py-0.5 rounded text-[10px] font-bold text-brand-border hover:text-white transition-colors cursor-pointer">
                        मरा
                    </button>
                </div>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <!-- Post-Treatment Online Payment Gateway Placeholder -->
                <button
                    type="button"
                    id="topPayOnlineBtn"
                    class="bg-brand-midnavy hover:bg-brand-lightnavy text-white border border-brand-gold/50 px-2.5 py-1 rounded-lg font-bold text-[11px] transition-colors cursor-pointer"
                    title="Post-treatment online payment placeholder (not for booking appointments)"
                >
                    💳 Pay Online
                </button>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <button type="button" onclick="downloadVCard()" class="text-brand-surface hover:text-white flex items-center gap-1 transition-colors cursor-pointer" title="Save Infinora Dental Care to Contacts">
                    <span>📇 Save Contact</span>
                </button>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <a href="https://g.page/r/Cb7r3l0-R2oSEBM/review" target="_blank" rel="noopener" class="text-brand-surface hover:text-white transition-colors flex items-center gap-1">
                    ⭐ Review Us
                </a>

                <span class="text-brand-lightnavy hidden sm:inline">|</span>

                <a href="tel:+917304432681" class="hover:text-white transition-colors flex items-center gap-1 text-brand-surface">
                    <svg class="w-3.5 h-3.5 text-brand-gold shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    +91 73044 32681
                </a>
            </div>

        </div>

        <!-- Top Bar Notice for Post-Treatment Payment Gateway Placeholder -->
        <div id="topPaymentNotice" class="hidden max-w-7xl mx-auto mt-2 px-3 py-2 rounded-xl bg-brand-midnavy border border-brand-gold/40 text-brand-surface text-[11px] flex items-center justify-between gap-3">
            <span>
                <strong>Post-Treatment Payment (Placeholder):</strong> For paying post-treatment balances online (Razorpay / Cashfree / Pine Labs / PayU integration planned; not for appointment booking). Please contact +91 73044 32681.
            </span>
            <button type="button" id="closeTopPaymentNotice" class="text-brand-gold font-bold px-2 cursor-pointer">✕</button>
        </div>
    </div>

    <!-- Sticky Navigation Bar: Logo & Clinic Name Stay Pinned While Scrolling -->
    <header id="stickyClinicHeader" class="sticky top-0 z-40 bg-brand-offwhite/95 backdrop-blur-md border-b border-brand-border shadow-sm w-full transition-all">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 min-h-20 sm:min-h-22 py-2.5 flex items-center justify-between gap-2 sm:gap-4">

            <a href="#top" class="flex items-center gap-3 min-w-0 group" aria-label="Infinora Dental Care Home">
                <span class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-brand-offwhite border-2 border-brand-navy/25 flex items-center justify-center shadow-sm shrink-0 p-1.5">
                    <img
                        src="/logo.svg"
                        alt="Infinora Dental Care Logo"
                        width="56"
                        height="56"
                        class="w-full h-full object-contain"
                        onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                    />
                    <span class="hidden text-sm font-black text-brand-navy">IDC</span>
                </span>
                <div class="min-w-0 max-w-[11rem] sm:max-w-[15rem] xl:max-w-none">
                    <span class="text-sm sm:text-lg xl:text-xl font-extrabold tracking-tight text-brand-navy block leading-tight whitespace-normal break-words">Infinora Dental Care</span>
                    <span class="text-[10px] sm:text-xs font-semibold text-brand-grey-muted block leading-tight mt-0.5 whitespace-normal break-words">Kandivali West, Mumbai</span>
                </div>
            </a>

            <nav class="hidden lg:flex items-center gap-4 xl:gap-5 text-xs xl:text-sm font-semibold text-brand-grey-text shrink-0" aria-label="Primary Navigation">
                <a href="#offers" class="hover:text-brand-navy transition-colors">Offers</a>
                <a href="#family-care" class="hover:text-brand-navy transition-colors">Family Care</a>
                <a href="#catalogue" class="hover:text-brand-navy transition-colors">Treatments</a>
                <a href="#about" class="hover:text-brand-navy transition-colors">Meet Dr. Riddhi</a>
                <a href="#reviews" class="hover:text-brand-navy transition-colors">Reviews</a>
                <a href="#faq" class="hover:text-brand-navy transition-colors">FAQs</a>
                <a href="#location" class="hover:text-brand-navy transition-colors">Location</a>
            </nav>

            <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
                <span id="scrolledBrandPill" class="hidden md:inline-flex items-center gap-1.5 bg-brand-cardbg text-brand-navy border border-brand-border px-2.5 py-1.5 rounded-lg text-[11px] font-bold whitespace-nowrap">
                    <span>Infinora Dental Care</span>
                </span>
                <a href="https://maps.app.goo.gl/3sKwKPjG43PNeN6y7" target="_blank" rel="noopener" class="hidden sm:inline-flex items-center gap-1 bg-brand-surface hover:bg-brand-cardbg text-brand-navy px-3 py-2.5 rounded-xl font-bold text-xs transition-all border border-brand-border whitespace-nowrap">
                    📍 Directions
                </a>
                <a href="#book" class="inline-flex items-center gap-1 bg-brand-navy hover:bg-brand-hovernavy text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-md transition-all whitespace-nowrap">
                    <span>Book Appointment</span>
                </a>
                <a href="tel:+917304432681" class="hidden xl:inline-flex bg-brand-darknavy hover:bg-brand-midnavy text-white px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm shadow-sm transition-all whitespace-nowrap">
                    +91 73044 32681
                </a>
            </div>
        </div>
    </header>

    <main id="top" class="w-full pb-28 sm:pb-20">

        <!-- HERO SECTION (LOCAL SEO, AEO & GEO ANCHOR) -->
        <section class="relative pt-8 pb-12 sm:pt-14 sm:pb-20 bg-gradient-to-b from-brand-surface via-brand-lightbg to-brand-offwhite w-full border-b border-brand-border">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

                <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-left min-w-0">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-cardbg border border-brand-border text-brand-navy text-[11px] sm:text-xs font-bold tracking-wide uppercase whitespace-normal break-words">
                        <span class="w-2 h-2 rounded-full bg-brand-gold shrink-0"></span>
                        <span>Infinora Dental Care · Dentist in Kandivali &amp; Mumbai · India</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-brand-navy leading-[1.12] whitespace-normal break-words">
                        Dentist &amp; Orthodontist. <br/>
                        <span class="text-brand-lightnavy">Infinora Dental Care.</span>
                    </h1>

                    <p class="text-sm sm:text-base text-brand-grey-text leading-relaxed max-w-2xl whitespace-normal break-words">
                        Searching for a trusted <strong>dentist near me</strong>, <strong>dentist in Kandivali</strong>, or <strong>dentist in Mumbai</strong>? <strong>Infinora Dental Care</strong> is founded and led by <strong>Dr. Riddhi Patel Shah</strong> (BDS Gold Medalist, MDS Orthodontics &amp; Dentofacial Orthopedics, MSDC Reg: A-45674), active member of the <strong>Indian Orthodontic Society (IOS)</strong> and the <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">Indian Dental Association (IDA Profile)</a>—offering braces, clear aligners, Invisalign, invisible aligners, dental implants, veneers, root canals, and family dental care for patients in Kandivali, Mumbai, and across India.
                    </p>

                    <!-- Action CTAs (Same-Page #book & Direct Call) -->
                    <div class="flex flex-col sm:flex-row gap-3 pt-2">
                        <a href="#book" class="inline-flex items-center justify-center gap-2 bg-brand-navy hover:bg-brand-hovernavy text-white font-bold px-7 py-3.5 rounded-xl shadow-lg transition-all text-sm sm:text-base text-center">
                            Book Appointment
                            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <a href="tel:+917304432681" class="inline-flex items-center justify-center gap-2 bg-brand-offwhite hover:bg-brand-surface border border-brand-border text-brand-navy font-bold px-6 py-3.5 rounded-xl shadow-sm transition-all text-sm sm:text-base text-center">
                            📞 Call Clinic (+91 73044 32681)
                        </a>
                    </div>

                    <!-- Trust Badges -->
                    <div class="pt-4 grid grid-cols-3 gap-2 sm:gap-4 border-t border-brand-border">
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">Dr. Riddhi</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">Gold Medalist &amp; MDS</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">IOS &amp; IDA</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">Verified Specialist</div>
                        </div>
                        <div class="p-3 bg-brand-offwhite rounded-xl border border-brand-border shadow-sm text-center sm:text-left min-w-0">
                            <div class="text-xs sm:text-xl font-black text-brand-navy whitespace-normal break-words">MSDC A-45674</div>
                            <div class="text-[10px] sm:text-xs text-brand-grey-muted font-semibold whitespace-normal break-words">Registered Practitioner</div>
                        </div>
                    </div>
                </div>

                <!-- Doctor & Brand Emblem Card (Large Logo Showcase) -->
                <div class="lg:col-span-5 relative w-full min-w-0" id="about">
                    <div class="bg-brand-offwhite rounded-3xl p-6 sm:p-8 border border-brand-border shadow-xl space-y-5">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4 border-b border-brand-border pb-5">
                            <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-brand-surface border-2 border-brand-navy/25 flex items-center justify-center shrink-0 p-2 shadow-sm">
                                <img
                                    src="/logo.svg"
                                    alt="Infinora Dental Care Official Logo"
                                    width="88"
                                    height="88"
                                    class="w-full h-full object-contain"
                                    onerror="this.style.display='none'; this.nextElementSibling.classList.remove('hidden');"
                                />
                                <span class="hidden text-base font-black text-brand-navy">IDC</span>
                            </div>
                            <div class="min-w-0">
                                <div class="text-[10px] font-extrabold uppercase tracking-wider text-brand-lightnavy">Infinora Dental Care</div>
                                <h2 class="font-extrabold text-brand-navy text-lg sm:text-xl leading-snug whitespace-normal break-words">Dr. Riddhi Patel Shah</h2>
                                <p class="text-xs text-brand-lightnavy font-bold tracking-wide whitespace-normal break-words">BDS Gold Medalist | MDS Orthodontics</p>
                                <p class="text-[11px] text-brand-grey-muted font-medium whitespace-normal break-words">Founder &amp; Lead Dental Surgeon</p>
                            </div>
                        </div>

                        <div class="space-y-3 text-xs sm:text-sm text-brand-grey-text leading-relaxed whitespace-normal break-words">
                            <p>
                                <strong>Dr. Riddhi Patel Shah</strong> is an Orthodontist and Lead Dental Surgeon practicing at <strong>Infinora Dental Care</strong> in Kandivali West, Mumbai. Combining academic training with a patient-first approach, she delivers specialist-led orthodontic and family dental care designed for oral health and bite balance.
                            </p>
                            <p>
                                Her clinical focus covers orthodontic consultations, braces, clear aligners, Invisalign, invisible aligners, smile improvement, and comprehensive dental care tailored to each individual's examination.
                            </p>
                        </div>

                        <!-- Academic Honors List -->
                        <div class="bg-brand-surface rounded-2xl p-4 border border-brand-border space-y-2 text-xs">
                            <div class="font-bold text-brand-navy text-[11px] uppercase tracking-wider">
                                Academic Honors &amp; Credentials
                            </div>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-brand-grey-text font-medium">
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> Student of the Year (BDS)</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> BDS University Medalist</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> MDS University Rank-Holder</div>
                                <div class="flex items-center gap-1.5"><span class="text-brand-gold font-bold">★</span> Best Prosthodontist (IDA CCRP)</div>
                            </div>
                        </div>

                        <div class="pt-1 flex flex-wrap gap-2 text-[11px]">
                            <span class="px-2.5 py-1 rounded-full bg-brand-cardbg text-brand-navy font-semibold">MSDC Reg: A-45674</span>
                            <span class="px-2.5 py-1 rounded-full bg-brand-cardbg text-brand-navy font-semibold">7+ Years Experience</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- OFFERS FOR CURRENT MONTH -->
        <section id="offers" class="py-12 bg-brand-offwhite border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-6">
                <div class="text-center max-w-2xl mx-auto space-y-2">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Offers for Current Month
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy whitespace-normal break-words">Current Month Clinic Offers</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        Available at <strong>Infinora Dental Care</strong>, Kandivali West, Mumbai—subject to appointment slot availability and clinical suitability.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider bg-brand-navy text-white px-2.5 py-1 rounded-full">Offer 01</span>
                            <h3 class="text-xl font-extrabold text-brand-navy">Free Dental Checkup</h3>
                            <p class="text-xs sm:text-sm text-brand-grey-text leading-relaxed">
                                Initial dental examination and consultation at Infinora Dental Care for individuals and families looking to check their teeth, gums, or alignment.
                            </p>
                        </div>
                        <button type="button" onclick="selectService('Checkup')" class="w-full text-center py-3 rounded-xl bg-brand-navy hover:bg-brand-hovernavy text-white text-xs sm:text-sm font-bold transition-colors cursor-pointer">
                            Claim Free Dental Checkup →
                        </button>
                    </div>

                    <div class="p-6 rounded-3xl bg-brand-surface border border-brand-border shadow-sm flex flex-col justify-between space-y-4">
                        <div class="space-y-2">
                            <span class="inline-block text-[10px] font-extrabold uppercase tracking-wider bg-brand-navy text-white px-2.5 py-1 rounded-full">Offer 02</span>
                            <h3 class="text-xl font-extrabold text-brand-navy">Teeth Cleaning @ Rs 999*</h3>
                            <p class="text-xs sm:text-sm text-brand-grey-text leading-relaxed">
                                Routine scaling and teeth cleaning offer at <strong>Rs 999*</strong>. *Terms, oral hygiene condition, and clinical assessment apply; additional procedures or deep periodontal care are evaluated separately.
                            </p>
                        </div>
                        <button type="button" onclick="selectService('Checkup')" class="w-full text-center py-3 rounded-xl bg-brand-navy hover:bg-brand-hovernavy text-white text-xs sm:text-sm font-bold transition-colors cursor-pointer">
                            Book Teeth Cleaning @ Rs 999* →
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAMILY DENTISTRY ACROSS EVERY STAGE OF LIFE -->
        <section id="family-care" class="py-14 bg-brand-surface border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">
                <div class="text-center max-w-3xl mx-auto space-y-2.5">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Comprehensive Family Dentistry
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy whitespace-normal break-words">Care for Every Member of Your Family</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        One trusted Kandivali West, Mumbai clinic for routine checkups, preventive care, braces, aligners, implants, veneers, root canals, and NRI/teleconsultation guidance across India.
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="p-5 rounded-2xl bg-brand-offwhite border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Children &amp; Teens</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Gentle first checkups, preventive care, early orthodontic screening, and braces or aligners for growing smiles.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-offwhite border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Adults &amp; Working Professionals</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Discreet aligners/braces, root canals, veneers, crowns, fillings, and gum care in Kandivali West, Mumbai.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-offwhite border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">Seniors &amp; Complex Needs</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Tooth replacement options, gum care, ground-level access, and individualized treatment planning after evaluation.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-brand-offwhite border border-brand-border space-y-2">
                        <h3 class="font-extrabold text-brand-navy text-sm">India-Wide &amp; NRI Consultations</h3>
                        <p class="text-xs text-brand-grey-text leading-relaxed">Teleconsultation / video opinion options and coordinated scheduling for patients across India and visiting NRIs.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- STATUTORY REGISTRATIONS & ACCREDITATIONS (ABDM & MSDC) -->
        <section id="credentials" class="py-12 bg-brand-offwhite border-b border-brand-border w-full">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 space-y-8">
                <div class="text-center space-y-2 max-w-2xl mx-auto">
                    <span class="text-brand-navy text-[10px] font-extrabold uppercase tracking-widest bg-brand-cardbg border border-brand-border px-3 py-1 rounded-full">
                        Statutory Registrations &amp; Transparencies
                    </span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy whitespace-normal break-words">Verified Regulatory Governance</h2>
                    <p class="text-xs sm:text-sm text-brand-grey-muted leading-relaxed">
                        Infinora Dental Care complies with state dental council registration requirements and National Health Authority digital health registry records.
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">

                    <!-- Card 1: MSDC & IDA -->
                    <div class="p-6 rounded-2xl bg-brand-surface border border-brand-border hover:border-brand-navy transition-all space-y-3 flex flex-col justify-between shadow-sm">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
                                <span class="text-brand-navy text-2xl font-bold">🏛️</span>
                                <h3 class="font-extrabold text-brand-navy text-sm">State Council &amp; Associations</h3>
                            </div>
                            <p class="text-xs text-brand-grey-text leading-relaxed">
                                Registered under the <strong>Maharashtra State Dental Council</strong> (Registration No: <strong class="text-brand-navy">A-45674</strong>). Member of the <strong>Indian Orthodontic Society (IOS)</strong> and the <a href="https://dentist.ida.org.in/dentist/riddhi-kantilal-patel" target="_blank" rel="noopener" class="text-brand-navy font-bold underline hover:text-brand-hovernavy">Indian Dental Association (IDA)</a>.
                            </p>
