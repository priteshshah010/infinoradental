    <!-- Comprehensive Interaction Script -->
    <script is:inline>
        const ALLOWED_APPT_SLOT = '3:00 PM – 5:00 PM (Only Available Appointment Slot — None Other Slots Work)';
        const MAX_FILES = 5;
        const MAX_FILE_BYTES = 5 * 1024 * 1024;
        const ALLOWED_MIME_TYPES = ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'];

        window.selectService = function(keyword) {
            const select = document.getElementById('treatmentService');
            if (select) {
                for (let opt of select.options) {
                    if (opt.value.toLowerCase().includes(keyword.toLowerCase()) || opt.text.toLowerCase().includes(keyword.toLowerCase())) {
                        select.value = opt.value;
                        break;
                    }
                }
            }
            const bookSection = document.getElementById('book');
            if (bookSection) {
                bookSection.scrollIntoView({ behavior: 'smooth' });
            }
        };

        document.addEventListener('DOMContentLoaded', () => {
            const dateInput = document.getElementById('appointmentDate');
            const dobInput = document.getElementById('patientDob');
            const timeSlot = document.getElementById('timeSlot');
            const serviceSelect = document.getElementById('treatmentService');
            const complaintsInput = document.getElementById('chiefComplaints');
            const historyInput = document.getElementById('medicalHistory');
            const allergiesInput = document.getElementById('medicalAllergies');
            const generatePrepBtn = document.getElementById('generatePrepBtn');
            const aiPrepOutput = document.getElementById('aiPrepOutput');
            const aiPrepList = document.getElementById('aiPrepList');
            const fileInput = document.getElementById('healthRecordsInput');
            const fileError = document.getElementById('fileError');
            const selectedFilesList = document.getElementById('selectedFilesList');
            const topPayBtn = document.getElementById('topPayOnlineBtn');
            const topPayNotice = document.getElementById('topPaymentNotice');
            const closeTopPayNotice = document.getElementById('closeTopPaymentNotice');
            const statusBox = document.getElementById('whatsappStatusBox');
            const form = document.getElementById('appointmentForm');

            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const todayStr = `${year}-${month}-${day}`;

            if (dateInput) {
                dateInput.min = todayStr;

                const maxDate = new Date();
                maxDate.setDate(maxDate.getDate() + 90);
                const maxYear = maxDate.getFullYear();
                const maxMonth = String(maxDate.getMonth() + 1).padStart(2, '0');
                const maxDay = String(maxDate.getDate()).padStart(2, '0');
                dateInput.max = `${maxYear}-${maxMonth}-${maxDay}`;

                if (!dateInput.value || dateInput.value < todayStr) {
                    dateInput.value = todayStr;
                }

                dateInput.addEventListener('change', () => {
                    if (dateInput.value && dateInput.value < todayStr) {
                        document.getElementById('dateError').classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                    } else {
                        document.getElementById('dateError').classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }
                });
            }

            if (dobInput) {
                dobInput.min = '1930-01-01';
                dobInput.max = todayStr;
            }

            if (timeSlot) {
                timeSlot.value = ALLOWED_APPT_SLOT;
                timeSlot.addEventListener('change', () => {
                    if (timeSlot.value !== ALLOWED_APPT_SLOT) {
                        timeSlot.value = ALLOWED_APPT_SLOT;
                        document.getElementById('slotError').classList.remove('hidden');
                    } else {
                        document.getElementById('slotError').classList.add('hidden');
                    }
                });
            }

            if (topPayBtn && topPayNotice) {
                topPayBtn.addEventListener('click', () => {
                    topPayNotice.classList.remove('hidden');
                    if (window.trackEvent) {
                        window.trackEvent('click_post_treatment_payment_placeholder', {
                            location: 'top_bar',
                            planned_gateways: 'razorpay,cashfree,pinelabs,payu'
                        });
                    }
                });
            }

            if (closeTopPayNotice && topPayNotice) {
                closeTopPayNotice.addEventListener('click', () => {
                    topPayNotice.classList.add('hidden');
                });
            }

            function validateAttachedFiles() {
                if (!fileInput || !fileError || !selectedFilesList) return { valid: true, files: [] };
                fileError.classList.add('hidden');
                fileError.textContent = '';
                selectedFilesList.innerHTML = '';

                const files = Array.from(fileInput.files || []);
                if (files.length === 0) {
                    return { valid: true, files: [] };
                }

                if (files.length > MAX_FILES) {
                    fileError.textContent = `Please select up to ${MAX_FILES} files.`;
                    fileError.classList.remove('hidden');
                    return { valid: false, files: [] };
                }

                for (const file of files) {
                    const extValid = /\.(pdf|jpe?g|png|webp)$/i.test(file.name);
                    const mimeValid = ALLOWED_MIME_TYPES.includes(file.type) || extValid;
                    if (!mimeValid) {
                        fileError.textContent = `Unsupported file "${file.name}". Use PDF, JPG, PNG, or WEBP.`;
                        fileError.classList.remove('hidden');
                        return { valid: false, files: [] };
                    }
                    if (file.size > MAX_FILE_BYTES) {
                        fileError.textContent = `"${file.name}" exceeds the 5 MB limit.`;
                        fileError.classList.remove('hidden');
                        return { valid: false, files: [] };
                    }
                }

                files.forEach((f) => {
                    const li = document.createElement('li');
                    const sizeKb = Math.max(1, Math.round(f.size / 1024));
                    li.textContent = `• ${f.name} (${sizeKb} KB)`;
                    selectedFilesList.appendChild(li);
                });

                return { valid: true, files };
            }

            if (fileInput) {
                fileInput.addEventListener('change', validateAttachedFiles);
            }

            if (generatePrepBtn && aiPrepList && aiPrepOutput) {
                generatePrepBtn.addEventListener('click', () => {
                    const svc = (serviceSelect ? serviceSelect.value : '').toLowerCase();
                    const notes = (complaintsInput ? complaintsInput.value : '').toLowerCase();
                    const tips = [
                        'Appointment slot: 3:00 PM – 5:00 PM (none other slots work for appointments).',
                        'Any prior dental X-rays, prescriptions, or medical reports.'
                    ];
                    if (svc.includes('orthodontic') || svc.includes('braces') || svc.includes('aligner') || svc.includes('smile')) {
                        tips.push('Any prior orthodontic records or alignment notes.');
                    }
                    if (svc.includes('implant') || svc.includes('root canal') || notes.includes('pain') || notes.includes('tooth')) {
                        tips.push('Details of affected teeth, sensitivity, or recent dental visits.');
                    }
                    aiPrepList.innerHTML = '';
                    tips.forEach((t) => {
                        const li = document.createElement('li');
                        li.textContent = t;
                        aiPrepList.appendChild(li);
                    });
                    aiPrepOutput.classList.remove('hidden');
                });
            }

            if (form) {
                form.addEventListener('submit', (e) => {
                    e.preventDefault();

                    const nameInput = document.getElementById('patientName');
                    const phoneInput = document.getElementById('patientPhone');
                    const dobField = document.getElementById('patientDob');
                    const genderField = document.getElementById('patientGender');
                    const serviceInput = document.getElementById('treatmentService');

                    const nameError = document.getElementById('nameError');
                    const phoneError = document.getElementById('phoneError');
                    const dobError = document.getElementById('dobError');
                    const genderError = document.getElementById('genderError');
                    const dateError = document.getElementById('dateError');
                    const slotError = document.getElementById('slotError');

                    let isValid = true;

                    if (!nameInput.value.trim() || nameInput.value.trim().length < 2) {
                        nameError.classList.remove('hidden');
                        nameInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        nameError.classList.add('hidden');
                        nameInput.classList.remove('border-rose-600');
                    }

                    const cleanPhone = phoneInput.value.replace(/\D/g, '');
                    if (!/^\d{10}$/.test(cleanPhone)) {
                        phoneError.classList.remove('hidden');
                        phoneInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        phoneError.classList.add('hidden');
                        phoneInput.classList.remove('border-rose-600');
                    }

                    const dobVal = dobField.value;
                    const dobCheckDate = dobVal ? new Date(dobVal + 'T00:00:00') : null;
                    const minDobDate = new Date('1930-01-01T00:00:00');
                    const maxDobDate = new Date(todayStr + 'T00:00:00');
                    if (!dobVal || !dobCheckDate || isNaN(dobCheckDate.getTime()) || dobCheckDate < minDobDate || dobCheckDate > maxDobDate) {
                        dobError.classList.remove('hidden');
                        dobField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dobError.classList.add('hidden');
                        dobField.classList.remove('border-rose-600');
                    }

                    if (!genderField.value) {
                        genderError.classList.remove('hidden');
                        genderField.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        genderError.classList.add('hidden');
                        genderField.classList.remove('border-rose-600');
                    }

                    const apptVal = dateInput.value;
                    const maxApptStr = dateInput.max;
                    if (!apptVal || apptVal < todayStr || (maxApptStr && apptVal > maxApptStr)) {
                        dateError.classList.remove('hidden');
                        dateInput.classList.add('border-rose-600');
                        isValid = false;
                    } else {
                        dateError.classList.add('hidden');
                        dateInput.classList.remove('border-rose-600');
                    }

                    if (!timeSlot || timeSlot.value !== ALLOWED_APPT_SLOT) {
                        if (timeSlot) timeSlot.value = ALLOWED_APPT_SLOT;
                        slotError.classList.remove('hidden');
                        isValid = false;
                    } else {
                        slotError.classList.add('hidden');
                    }

                    const fileCheck = validateAttachedFiles();
                    if (!fileCheck.valid) {
                        isValid = false;
                    }

                    if (!isValid) return;

                    const name = nameInput.value.trim();
                    const phone = cleanPhone;
                    const dob = dobVal;
                    const gender = genderField.value;
                    const service = serviceInput.value;
                    const date = apptVal;
                    const slot = ALLOWED_APPT_SLOT;
                    const complaints = complaintsInput ? complaintsInput.value.trim() : '';
                    const medHistory = historyInput ? historyInput.value.trim() : '';
                    const allergies = allergiesInput ? allergiesInput.value.trim() : '';
                    const fileNames = fileCheck.files.map((f) => f.name).join(', ') || 'None';

                    const dobDate = new Date(dob + 'T00:00:00');
                    const todayDate = new Date(todayStr + 'T00:00:00');
                    let calculatedAge = todayDate.getFullYear() - dobDate.getFullYear();
                    const monthDiff = todayDate.getMonth() - dobDate.getMonth();
                    if (monthDiff < 0 || (monthDiff === 0 && todayDate.getDate() < dobDate.getDate())) {
                        calculatedAge--;
                    }

                    if (window.trackEvent) {
                        window.trackEvent('submit_appointment_form', {
                            service_requested: service,
                            preferred_slot: slot,
                            preferred_date: date,
                            patient_gender: gender,
                            patient_age: calculatedAge,
                            records_attached_count: fileCheck.files.length
                        });
                    }

                    const complaintsLine = complaints ? `%0A• Complaints: ${encodeURIComponent(complaints)}` : '';
                    const historyLine = medHistory ? `%0A• Medical History: ${encodeURIComponent(medHistory)}` : '';
                    const allergiesLine = allergies ? `%0A• Medical Allergies: ${encodeURIComponent(allergies)}` : '';
                    const filesLine = fileCheck.files.length ? `%0A• Health Records Selected: ${encodeURIComponent(fileNames)}` : '';

                    const message = `Hello Dr. Riddhi Patel Shah (Infinora Dental Care),%0A%0AI would like to request an appointment during the 3:00 PM – 5:00 PM slot.%0A%0A📋 *Patient Details:*%0A• Name: ${encodeURIComponent(name)}%0A• Mobile: ${encodeURIComponent(phone)}%0A• Age: ${encodeURIComponent(calculatedAge + ' years')} (DOB: ${encodeURIComponent(dob)})%0A• Gender: ${encodeURIComponent(gender)}%0A• Service: ${encodeURIComponent(service)}%0A• Preferred Date: ${encodeURIComponent(date)}%0A• Slot: ${encodeURIComponent(slot)}${complaintsLine}${historyLine}${allergiesLine}${filesLine}%0A%0APlease confirm my appointment. Thank you!`;

                    if (statusBox) {
                        statusBox.classList.remove('hidden');
                    }

                    window.open(`https://wa.me/917304432681?text=${message}`, '_blank');
                });
            }
        });
    </script>
</Layout>
