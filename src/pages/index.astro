                            Verified by Govt. of India
                        </div>
                    </div>

                    <!-- ABDM Digital Doctor (HPR) -->
                    <div class="p-5 sm:p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-teal-300 transition-all space-y-3 flex flex-col justify-between">
                        <div class="space-y-2">
                            <div class="flex items-center gap-2.5">
                                <span class="text-teal-700 text-xl font-bold">👩‍⚕️</span>
