                <a href="#credentials" class="hover:text-teal-700 transition-colors">Registrations</a>
                <a href="#community" class="hover:text-teal-700 transition-colors">Outreach</a>
                <a href="#about" class="hover:text-teal-700 transition-colors">Meet Dr. Riddhi</a>
