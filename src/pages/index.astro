                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <span class="w-11 h-11 rounded-xl bg-teal-50 text-teal-700 flex items-center justify-center text-xl font-bold">🦷</span>
                            <span class="text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full">Endodontics</span>
