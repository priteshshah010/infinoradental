    <!-- Google Analytics 4 (G-Z41QK7SPBW) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z41QK7SPBW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-Z41QK7SPBW', { anonymize_ip: true });

      window.trackEvent = function (eventName, params) {
        try {
          if (typeof gtag === 'function') {
            gtag('event', eventName, params || {});
          }
        } catch (err) {}
      };
    </script>

    <style is:global>
      html,
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        color: #334155;
        background-color: #ffffff;
        overflow-x: clip; /* Keeps position: sticky working while blocking horizontal overflow */
      }

      /* Prevent iOS Safari auto-zoom on form fields */
      input,
      select,
      textarea {
        font-size: 16px !important;
      }

      @media (min-width: 640px) {
        input,
        select,
        textarea {
          font-size: 14px !important;
        }
      }

      /* Hide Google Translate top banner & tooltips cleanly */
      .goog-te-banner-frame.skiptranslate,
      .goog-te-gadget-icon,
      #goog-gt-tt,
      .goog-tooltip {
        display: none !important;
      }
      body {
        top: 0 !important;
      }
      #google_translate_element {
        display: none !important;
      }
    </style>
  </head>

  <body class="antialiased selection:bg-brand-navy selection:text-white">
    <div id="google_translate_element" aria-hidden="true"></div>
    <slot />

    <!-- Google Website Translator (Lazy Init) -->
    <script is:inline>
      function googleTranslateElementInit() {
        if (window.google && window.google.translate) {
          new google.translate.TranslateElement(
            {
              pageLanguage: 'en',
              includedLanguages: 'en,hi,mr,gu',
              autoDisplay: false,
            },
            'google_translate_element'
          );
        }
      }

      window.changeLanguage = function (langCode) {
        const setCookieAndReload = (code) => {
          document.cookie = `googtrans=/en/${code}; path=/`;
          document.cookie = `googtrans=/en/${code}; path=/; domain=${window.location.hostname}`;
          const select = document.querySelector('.goog-te-combo');
          if (select) {
            select.value = code;
            select.dispatchEvent(new Event('change'));
          } else {
            window.location.reload();
          }
        };

        document.querySelectorAll('.lang-btn').forEach((btn) => {
          const isActive = btn.getAttribute('data-lang') === langCode;
          btn.classList.toggle('bg-brand-navy', isActive);
          btn.classList.toggle('text-white', isActive);
          btn.classList.toggle('text-brand-grey-muted', !isActive);
        });

        if (window.trackEvent) {
          window.trackEvent('change_language', { language: langCode });
        }

        if (!document.getElementById('gt-script')) {
          const s = document.createElement('script');
          s.id = 'gt-script';
          s.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
          s.onload = () => setTimeout(() => setCookieAndReload(langCode), 400);
          document.body.appendChild(s);
        } else {
          setCookieAndReload(langCode);
        }
      };

      // Save Clinic vCard (.vcf)
      window.downloadVCard = function () {
        const vcard = [
          'BEGIN:VCARD',
          'VERSION:3.0',
          'FN:Infinora Dental Care - Dr. Riddhi Patel Shah',
          'ORG:Infinora Dental Care',
          'TITLE:Chief Orthodontist (MDS) & Founder',
          'TEL;TYPE=WORK,VOICE:+917304432681',
          'EMAIL;TYPE=PREF,INTERNET:hello@infinoradental.com',
          'URL:https://infinoradental.com',
          'ADR;TYPE=WORK:;;Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West;Mumbai;Maharashtra;400067;India',
          'NOTE:Specialist Orthodontics, Braces, Clear Aligners, Implants & Family Dentistry. MSDC Reg: A-45674.',
          'END:VCARD',
        ].join('\r\n');

        const blob = new Blob([vcard], { type: 'text/vcard;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'Infinora-Dental-Care-Kandivali-West.vcf';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        if (window.trackEvent) {
          window.trackEvent('download_vcard', { clinic: 'Infinora Dental Care' });
        }
      };

      // Global Automatic Click Event Tracker for GA4
      document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('click', (e) => {
          const target = e.target.closest('a');
          if (!target || !window.trackEvent) return;
          const href = target.getAttribute('href') || '';

          if (href.startsWith('tel:')) {
            window.trackEvent('click_phone_call', {
              phone_number: '+91 73044 32681',
              click_location: target.innerText.trim() || 'Header/Bar',
            });
          } else if (href.includes('wa.me')) {
            window.trackEvent('click_whatsapp_booking', {
              link_url: href,
              button_text: target.innerText.trim() || 'WhatsApp CTA',
            });
          } else if (href.includes('instagram.com')) {
            window.trackEvent('click_instagram', {
              profile: '@orthodontist.riddhi',
            });
          } else if (href.includes('g.page') || href.includes('share.google')) {
            window.trackEvent('click_google_review', {
              destination: 'Google Business Profile',
            });
          } else if (href.includes('maps.google.com') || href.includes('maps.app.goo.gl')) {
            window.trackEvent('click_google_maps', {
              destination: 'Directions to Clinic',
            });
          }
        });
      });
    </script>
  </body>
</html>
