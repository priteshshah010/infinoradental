---
export interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical & Open Graph Metadata -->
    <link rel="canonical" href="https://infinoradental.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://infinoradental.com/" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Infinora Dental Care" />
    
    <!-- Google Fonts Preconnect & Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind Play CDN (Standalone Execution - Zero Race Condition) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Comprehensive Medical Clinic, Specialist Board & AEO Schema (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Dentist", "MedicalBusiness"],
          "@id": "https://infinoradental.com/#clinic",
          "name": "Infinora Dental Care - Dr. Riddhi Patel Shah (Dentist & Braces Clinic)",
          "alternateName": "Infinora Dental Care Mumbai",
          "url": "https://infinoradental.com/",
          "telephone": "+91-7304432681",
          "email": "hello@infinoradental.com",
          "priceRange": "₹₹",
          "hasMap": "https://maps.app.goo.gl/3sKwKPjG43PNeN6y7",
          "sameAs": [
            "https://instagram.com/orthodontist.riddhi",
            "https://share.google/pcuutYXTurrftQRyt",
            "https://maps.app.goo.gl/3sKwKPjG43PNeN6y7"
          ],
          "currenciesAccepted": "INR, USD, AUD, GBP, EUR, AED",
          "paymentAccepted": "Cash, Credit Card, Debit Card, UPI, Google Pay, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West",
            "addressLocality": "Mumbai",
            "addressRegion": "Maharashtra",
            "postalCode": "400067",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 19.205511,
            "longitude": 72.840393
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "09:00",
              "closes": "13:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "15:00",
              "closes": "17:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "18:00",
              "closes": "21:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Sunday"],
              "opens": "10:00",
              "closes": "13:00",
              "description": "Strictly Prior Appointment Basis Only"
            }
          ],
          "founder": {
            "@type": "Person",
            "name": "Dr. Riddhi Patel Shah",
            "jobTitle": "Lead Dental Surgeon & Orthodontist",
            "hasCredential": "MDS (Orthodontics & Dentofacial Orthopedics)",
            "sameAs": "https://instagram.com/orthodontist.riddhi"
          },
          "medicalSpecialty": [
            "Orthodontics",
            "Dentistry",
            "Endodontics",
            "Periodontics",
            "Prosthodontics",
            "PediatricDentistry",
            "OralSurgery"
          ],
          "availableService": [
            { "@type": "MedicalTherapy", "name": "Free 3D Smile & Oral Health Consultation by Dr. Riddhi Patel Shah (MDS)" },
            { "@type": "MedicalTherapy", "name": "Invisible Clear Aligners & Precision Aesthetic Braces" },
            { "@type": "MedicalTherapy", "name": "Single-Visit Painless Root Canal Treatment (MDS Endodontics)" },
            { "@type": "MedicalTherapy", "name": "Permanent Dental Implants & All-on-4/6 (MDS Oral Surgery)" },
            { "@type": "MedicalTherapy", "name": "Bespoke Smile Architecture & E.max Porcelain Veneers" },
            { "@type": "MedicalTherapy", "name": "Atraumatic Wisdom Teeth Oral Surgery" },
            { "@type": "MedicalTherapy", "name": "Piezoelectric Ultrasonic Scaling & Laser Periodontal Care" },
            { "@type": "MedicalTherapy", "name": "Pediatric Preventive Care & Early Growth Guidance" },
            { "@type": "MedicalTherapy", "name": "Global Dental Tourism & NRI Concierge Protocols" }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://infinoradental.com/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How is care coordinated at Infinora Dental Care?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every patient undergoes a comprehensive aesthetic and clinical evaluation directed by Dr. Riddhi Patel Shah (MDS Orthodontist). Clinical procedures are managed by dedicated board-certified MDS specialists in Endodontics, Oral & Maxillofacial Surgery, Prosthodontics, and Periodontics under strict multi-speciality standards."
              }
            },
            {
              "@type": "Question",
              "name": "Why choose an MDS specialist over a general practitioner for Braces & Clear Aligners?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "An MDS (Master of Dental Surgery) in Orthodontics requires 3 years of intensive full-time post-graduate training focused exclusively on jaw biomechanics, facial harmony, and biological tooth movement. Dr. Riddhi Patel Shah designs biomechanically stable alignments that preserve bone and gum health."
              }
            },
            {
              "@type": "Question",
              "name": "Is Single-Visit Root Canal Treatment (RCT) painful?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Using computerized apex locators, high-torque rotary micro-instruments, and gentle local anesthesia, our Endodontic specialists cleanse and seal the canal in a single 45-minute sitting with zero discomfort."
              }
            },
            {
              "@type": "Question",
              "name": "What are the clinic consultation hours?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Infinora Dental Care operates Monday through Saturday across three sessions: Morning (9:00 AM – 1:00 PM), Afternoon (3:00 PM – 5:00 PM), and Evening (6:00 PM – 9:00 PM). Sunday sessions are 10:00 AM – 1:00 PM strictly by prior appointment only."
              }
            },
            {
              "@type": "Question",
              "name": "What sterilization protocols are followed at Infinora Dental Care?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We implement a 6-step hospital-grade sterilization protocol utilizing European Class-B vacuum autoclaves. Every instrument is vacuum-sealed in individual sterile barrier pouches and opened in front of each patient."
              }
            },
            {
              "@type": "Question",
              "name": "Where is Infinora Dental Care located?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "The clinic is located at Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West, Mumbai 400067, accessible from S.V. Road and Kandivali Station with dedicated street parking."
              }
            }
          ]
        }
      ]
    }
    </script>

    <!-- Automated Google Website Translator Script -->
    <script is:inline type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,gu,hi,mr',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script is:inline type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-teal-600 selection:text-white overflow-x-hidden w-full m-0 p-0 relative min-h-screen">
    <slot />
</body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }
    html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
    /* Prevents iOS Safari input zooming while maintaining touch targets */
    input, select, textarea {
        font-size: 16px !important;
    }
    svg {
        display: inline-block;
        vertical-align: middle;
    }
    /* Google Translate Widget Styling */
    .goog-te-gadget-simple {
        background-color: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(20, 184, 166, 0.4) !important;
        padding: 3px 8px !important;
        border-radius: 8px !important;
        font-size: 11px !important;
        line-height: 1.4 !important;
        display: inline-flex !important;
        align-items: center !important;
        cursor: pointer !important;
    }
    .goog-te-gadget-simple .goog-te-menu-value {
        color: #5eead4 !important;
        font-weight: 700 !important;
    }
    .goog-te-gadget-simple .goog-te-menu-value span {
        border-left: none !important;
        color: #5eead4 !important;
    }
    .goog-te-gadget-icon {
        display: none !important;
    }
    .goog-te-banner-frame.skiptranslate {
        display: none !important;
    }
    body {
        top: 0px !important;
    }
</style>
