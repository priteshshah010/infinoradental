---
export interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical & Open Graph -->
    <link rel="canonical" href="https://infinoradental.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://infinoradental.com/" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Infinora Dental Care" />
    
    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        teal: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            200: '#99f6e4',
                            300: '#5eead4',
                            400: '#2dd4bf',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                            950: '#042f2e',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Comprehensive Medical Clinic, Specialist & Dental Tourism Schema (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Dentist", "MedicalBusiness"],
          "@id": "https://infinoradental.com/#clinic",
          "name": "Infinora Dental Care - Dr. Riddhi Patel Shah (Dentist & Braces Clinic)",
          "alternateName": "Infinora Dental Care Mumbai",
          "url": "https://infinoradental.com/",
          "telephone": "+91-7304432681",
          "email": "hello@infinoradental.com",
          "priceRange": "₹₹",
          "hasMap": "https://maps.app.goo.gl/3sKwKPjG43PNeN6y7",
          "currenciesAccepted": "INR, USD, AUD, GBP, EUR, AED",
          "paymentAccepted": "Cash, Credit Card, Debit Card, UPI, Google Pay, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West",
            "addressLocality": "Mumbai",
            "addressRegion": "Maharashtra",
            "postalCode": "400067",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 19.205511,
            "longitude": 72.840393
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "09:00",
              "closes": "21:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Sunday"],
              "opens": "10:00",
              "closes": "13:00"
            }
          ],
          "founder": {
            "@type": "Person",
            "name": "Dr. Riddhi Patel Shah",
            "jobTitle": "Orthodontist & Dental Surgeon",
            "hasCredential": "MDS (Orthodontics & Dentofacial Orthopedics)"
          },
          "medicalSpecialty": [
            "Orthodontics",
            "Dentistry",
            "Endodontics",
            "Periodontics",
            "Prosthodontics",
            "PediatricDentistry",
            "OralSurgery"
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://infinoradental.com/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Why is an MDS Orthodontist essential for Clear Aligners & Braces?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "An MDS (Master of Dental Surgery) in Orthodontics requires 3 years of rigorous full-time post-graduate training focused entirely on jaw biomechanics and tooth movements. Unlike non-specialist certifications, an MDS specialist like Dr. Riddhi Patel Shah guarantees predictable, biologically safe alignments that protect roots and prevent relapse."
              }
            },
            {
              "@type": "Question",
              "name": "How does Dental Tourism & NRI Treatment planning work at Infinora Dental Care?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "International patients and NRIs from the UK, USA, Australia, and UAE can share their dental X-rays/CBCT scans via WhatsApp (+91 73044 32681) for a virtual assessment, fixed upfront quote, and fast-tracked appointment scheduling before traveling to Mumbai."
              }
            },
            {
              "@type": "Question",
              "name": "Is Root Canal Treatment (RCT) completely painless?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. With computerized apex locators, high-torque rotary endodontics, and gentle local anesthesia, our Endodontists complete root canal treatments in a single 45-minute sitting with zero pain."
              }
            },
            {
              "@type": "Question",
              "name": "What sterilization standards are followed at the clinic?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We operate a strict hospital-grade 6-step sterilization protocol featuring European Class-B vacuum autoclaving. Every instrument is sealed in sterile barrier pouches and opened in front of the patient."
              }
            }
          ]
        }
      ]
    }
    </script>
</head>
<body class="bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-teal-600 selection:text-white overflow-x-hidden w-full m-0 p-0">
    <slot />
</body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }
    html, body {
        max-width: 100vw;
        overflow-x: hidden;
    }
</style>
