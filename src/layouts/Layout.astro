---
export interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical & Open Graph Metadata -->
    <link rel="canonical" href="https://infinoradental.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://infinoradental.com/" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Infinora Dental Care" />
    
    <!-- Google Fonts Preconnect & Load -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind Play CDN (Engineered Standalone Execution - Eliminates Race Conditions) -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>

    <!-- Comprehensive Medical Clinic, Specialist Board & AEO Schema (JSON-LD) -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Dentist", "MedicalBusiness"],
          "@id": "https://infinoradental.com/#clinic",
          "name": "Infinora Dental Care - Dr. Riddhi Patel Shah (Dentist & Braces Clinic)",
          "alternateName": "Infinora Dental Care Mumbai",
          "url": "https://infinoradental.com/",
          "telephone": "+91-7304432681",
          "email": "hello@infinoradental.com",
          "priceRange": "₹₹",
          "hasMap": "https://maps.app.goo.gl/3sKwKPjG43PNeN6y7",
          "sameAs": [
            "https://instagram.com/orthodontist.riddhi",
            "https://share.google/pcuutYXTurrftQRyt",
            "https://maps.app.goo.gl/3sKwKPjG43PNeN6y7"
          ],
          "currenciesAccepted": "INR, USD, AUD, GBP, EUR, AED",
          "paymentAccepted": "Cash, Credit Card, Debit Card, UPI, Google Pay, Bank Transfer",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West",
            "addressLocality": "Mumbai",
            "addressRegion": "Maharashtra",
            "postalCode": "400067",
            "addressCountry": "IN"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 19.205511,
            "longitude": 72.840393
          },
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
              "opens": "09:00",
              "closes": "21:00"
            },
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Sunday"],
              "opens": "10:00",
              "closes": "13:00",
              "description": "Strictly Prior Appointment Basis Only"
            }
          ],
          "founder": {
            "@type": "Person",
            "name": "Dr. Riddhi Patel Shah",
            "jobTitle": "Lead Dental Surgeon & Orthodontist",
            "hasCredential": "MDS (Orthodontics & Dentofacial Orthopedics)",
            "sameAs": "https://instagram.com/orthodontist.riddhi"
          },
          "medicalSpecialty": [
            "Orthodontics",
            "Dentistry",
            "Endodontics",
            "Periodontics",
            "Prosthodontics",
            "PediatricDentistry",
            "OralSurgery"
          ],
          "availableService": [
            { "@type": "MedicalTherapy", "name": "Primary Comprehensive Dental Consultation by Dr. Riddhi Patel Shah (MDS)" },
            { "@type": "MedicalTherapy", "name": "Invisible Clear Aligners & Precision Aesthetic Braces" },
            { "@type": "MedicalTherapy", "name": "Single-Visit Painless Root Canal Treatment (MDS Endodontist On-Call)" },
            { "@type": "MedicalTherapy", "name": "Permanent Dental Implants & All-on-4/6 (MDS Oral Surgeon On-Call)" },
            { "@type": "MedicalTherapy", "name": "Cosmetic Smile Makeovers & E.max Porcelain Veneers" },
            { "@type": "MedicalTherapy", "name": "Wisdom Teeth Atraumatic Oral Surgery" },
            { "@type": "MedicalTherapy", "name": "Ultrasonic Scaling & Laser Periodontal Therapy" },
            { "@type": "MedicalTherapy", "name": "Pediatric Preventive Dental Care" },
            { "@type": "MedicalTherapy", "name": "Global Dental Tourism & NRI Concierge Protocols" }
          ]
        },
        {
          "@type": "FAQPage",
          "@id": "https://infinoradental.com/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "Who examines patients at Infinora Dental Care?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Every patient is personally evaluated and diagnosed first by Chief Dental Surgeon Dr. Riddhi Patel Shah (MDS Orthodontist). If specialized advanced surgery or root canal intervention is required, our panel of on-call MDS specialists (Endodontists, Maxillofacial Surgeons, Prosthodontists) are brought in under Dr. Riddhi's direct clinical supervision."
              }
            },
            {
              "@type": "Question",
              "name": "Why choose an MDS specialist over a general dentist for Braces & Aligners?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "An MDS (Master of Dental Surgery) in Orthodontics requires 3 years of full-time master's-level clinical training dedicated exclusively to facial aesthetics, jaw mechanics, and tooth movement. Dr. Riddhi Patel Shah designs biomechanically stable alignments that protect roots and prevent relapse."
              }
            },
            {
              "@type": "Question",
              "name": "Is Single-Visit Root Canal Treatment (RCT) painful?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Using computerized apex locators, high-torque rotary endodontics, and gentle micro-anesthesia, our Endodontists cleanse and seal the canal in a single 45-minute sitting with zero pain."
              }
            },
            {
              "@type": "Question",
              "name": "What are the clinic timings on Sundays?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "On Sundays, Infinora Dental Care is open from 10:00 AM to 1:00 PM strictly on a prior appointment basis only. Walk-ins are not accommodated on Sundays."
              }
            },
            {
              "@type": "Question",
              "name": "What sterilization standards are followed at Infinora Dental Care?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We adhere to a hospital-grade 6-step sterilization protocol featuring Class-B fractionated vacuum autoclaving. All instruments are sealed in individual sterile barrier pouches and unsealed exclusively in front of the patient."
              }
            },
            {
              "@type": "Question",
              "name": "How long do Dental Implants last compared to Dental Bridges?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Dental implants are titanium fixtures fused permanently into your jawbone that can last a lifetime with proper hygiene. Unlike traditional bridges, dental implants do not require grinding down adjacent healthy natural teeth."
              }
            },
            {
              "@type": "Question",
              "name": "Are payment plans and digital payment options available for major treatments?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We offer transparent upfront treatment pricing with zero hidden charges. We accept Google Pay, UPI, all major credit/debit cards, and structured installment/EMI payment plans for comprehensive orthodontic and implant treatments."
              }
            },
            {
              "@type": "Question",
              "name": "Where is the clinic located in Kandivali West?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Infinora Dental Care is located at Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West, Mumbai 400067, with free street parking available nearby."
              }
            }
          ]
        }
      ]
    }
    </script>

    <!-- Automated Google Website Translator Script -->
    <script is:inline type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,gu,hi,mr',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE,
                autoDisplay: false
            }, 'google_translate_element');
        }
    </script>
    <script is:inline type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>
</head>
<body class="bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-teal-600 selection:text-white overflow-x-hidden w-full m-0 p-0 relative min-h-screen">
    <slot />
</body>
</html>

<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }
    html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
    /* Prevents iOS Safari input zooming while maintaining 44px touch targets */
    input, select, textarea {
        font-size: 16px !important;
    }
    svg {
        display: inline-block;
        vertical-align: middle;
    }
    /* Google Translate Widget Custom Styling */
    .goog-te-gadget-simple {
        background-color: rgba(255, 255, 255, 0.1) !important;
        border: 1px solid rgba(20, 184, 166, 0.4) !important;
        padding: 3px 8px !important;
        border-radius: 8px !important;
        font-size: 11px !important;
        line-height: 1.4 !important;
        display: inline-flex !important;
        align-items: center !important;
        cursor: pointer !important;
    }
    .goog-te-gadget-simple .goog-te-menu-value {
        color: #5eead4 !important;
        font-weight: 700 !important;
    }
    .goog-te-gadget-simple .goog-te-menu-value span {
        border-left: none !important;
        color: #5eead4 !important;
    }
    .goog-te-gadget-icon {
        display: none !important;
    }
    .goog-te-banner-frame.skiptranslate {
        display: none !important;
    }
    body {
        top: 0px !important;
    }
</style>
