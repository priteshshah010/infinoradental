    <!-- Google Website Translator Hidden Core Script -->
    <script is:inline type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,gu,hi,mr',
                autoDisplay: false
            }, 'google_translate_hidden_element');
        }

        window.changeLanguage = function(langCode) {
            const selectEl = document.querySelector('.goog-te-combo');
            if (selectEl) {
                selectEl.value = langCode;
                selectEl.dispatchEvent(new Event('change'));
            }
            document.querySelectorAll('.lang-btn').forEach(btn => {
                if (btn.dataset.lang === langCode) {
                    btn.classList.add('bg-teal-500', 'text-slate-950');
                    btn.classList.remove('text-slate-300', 'hover:text-white');
                } else {
                    btn.classList.remove('bg-teal-500', 'text-slate-950');
                    btn.classList.add('text-slate-300', 'hover:text-white');
                }
            });
            if (window.trackEvent) {
                window.trackEvent('change_language', { selected_language: langCode });
            }
        };

        window.downloadVCard = function() {
            if (window.trackEvent) {
                window.trackEvent('download_vcard', { method: 'direct_button' });
            }

            const vcardData = [
                'BEGIN:VCARD',
                'VERSION:3.0',
                'N:Shah;Dr. Riddhi;Patel;;',
                'FN:Dr. Riddhi Patel Shah - Infinora Dental Care',
                'ORG:Infinora Dental Care',
                'TITLE:Lead Dental Surgeon & Orthodontist (MDS)',
                'TEL;TYPE=WORK,VOICE:+917304432681',
                'TEL;TYPE=CELL,VOICE:+917304432681',
                'EMAIL;TYPE=PREF,INTERNET:hello@infinoradental.com',
                'URL:https://infinoradental.com',
                'ADR;TYPE=WORK,POSTAL,PARCEL:;;Shop No. 5, Sai Elegance, Iraniwadi Road No. 3, Kandivali West;Mumbai;Maharashtra;400067;India',
                'NOTE:Infinora Dental Care - Kandivali West, Mumbai (Metro Line 2A & Western Line). Mon-Sat: 9AM-1PM, 3PM-5PM, 6PM-9PM | Sun: 10AM-1PM (Prior Appt Only)',
                'X-SOCIALPROFILE;type=instagram:https://instagram.com/orthodontist.riddhi',
                'END:VCARD'
            ].join('\r\n');

            const blob = new Blob([vcardData], { type: 'text/vcard;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'Infinora_Dental_Care_Dr_Riddhi.vcf';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
    </script>
