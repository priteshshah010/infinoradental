<style is:global>
    *, *::before, *::after {
        box-sizing: border-box;
    }
    html, body {
        width: 100%;
        max-width: 100vw;
        overflow-x: hidden;
        margin: 0;
        padding: 0;
    }
    /* Prevents iOS Safari input zooming while maintaining 44px touch targets */
    input, select, textarea {
        font-size: 16px !important;
    }
    svg {
        display: inline-block;
        vertical-align: middle;
    }
    /* Hide default Google Translate banner frame */
    .goog-te-banner-frame.skiptranslate {
        display: none !important;
    }
    body {
        top: 0px !important;
    }
</style>
