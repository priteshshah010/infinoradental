<body class="bg-slate-50 text-slate-900 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-teal-600 selection:text-white overflow-x-hidden w-full m-0 p-0 relative min-h-screen">
    <div id="google_translate_hidden_element" class="hidden"></div>
    <slot />

    <!-- Global Automatic Click Event Tracker for GA4 -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            document.addEventListener('click', (e) => {
                const target = e.target.closest('a');
                if (!target || !window.trackEvent) return;

                const href = target.getAttribute('href') || '';

                if (href.startsWith('tel:')) {
                    window.trackEvent('click_phone_call', {
                        phone_number: '+91 73044 32681',
                        click_location: target.innerText.trim() || 'Header/Bar'
                    });
                }
                else if (href.includes('wa.me')) {
                    window.trackEvent('click_whatsapp_booking', {
                        link_url: href,
                        button_text: target.innerText.trim() || 'WhatsApp CTA'
                    });
                }
                else if (href.includes('instagram.com')) {
                    window.trackEvent('click_instagram', {
                        profile: '@orthodontist.riddhi'
                    });
                }
                else if (href.includes('g.page') || href.includes('share.google')) {
                    window.trackEvent('click_google_review', {
                        destination: 'Google My Business'
                    });
                }
                else if (href.includes('maps.google.com') || href.includes('maps.app.goo.gl')) {
                    window.trackEvent('click_google_maps', {
                        destination: 'Directions to Clinic'
                    });
                }
            });
        });
    </script>
