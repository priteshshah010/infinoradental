    <!-- Tailwind CSS CDN (data-cfasync="false" prevents Cloudflare Rocket Loader from breaking styles) -->
    <script data-cfasync="false" src="https://cdn.tailwindcss.com"></script>
    <script data-cfasync="false">
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"Plus Jakarta Sans"', 'system-ui', '-apple-system', 'sans-serif'],
              serif: ['"Cinzel"', 'Georgia', 'serif'],
            },
            colors: {
              brand: {
                navy: '#011f39',
                'navy-light': '#0a3254',
                teal: '#0f766e',
                'teal-dark': '#115e59',
                gold: '#C59B27',
                'gold-dark': '#8A6508',
                surface: '#ffffff',
                cardbg: '#f8fafc',
                border: '#e2e8f0',
                'grey-text': '#334155',
                'grey-muted': '#64748b',
                /* Compatible aliases for subpages like privacy-policy.astro */
                brown: '#011f39',
                darkbrown: '#011f39',
                hoverbrown: '#0a3254',
                midbrown: '#334155',
                beige: '#f1f5f9',
                lightbeige: '#f8fafc',
                cardbeige: '#e2e8f0',
                offwhite: '#ffffff',
              },
            },
          },
        },
      };
    </script>

    <!-- Structured Data (JSON-LD) -->
