    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content="Infinora Dental Care" />
    
    <!-- Google Analytics 4 (gtag.js) - G-Z41QK7SPBW -->
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', GA_MEASUREMENT_ID, {
            send_page_view: true,
            anonymize_ip: true
        });

        window.trackEvent = function(eventName, eventParams = {}) {
            if (typeof window.gtag === 'function') {
                window.gtag('event', eventName, {
                    ...eventParams,
                    clinic_name: 'Infinora Dental Care',
                    location: 'Kandivali West'
                });
            }
        };
    </script>

